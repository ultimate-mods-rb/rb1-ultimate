#define GUITAR_SET (
   (0
      (normal {asset_mgr get_widget guitar normal 0})
      (normal_hopo {asset_mgr get_widget guitar hopo 0})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison star_gem.wid)
      (unison_hopo star_hopo.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget guitar gtr_mash 0})
   )
   (1
      (normal {asset_mgr get_widget guitar normal 1})
      (normal_hopo {asset_mgr get_widget guitar hopo 1})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison star_gem.wid)
      (unison_hopo star_hopo.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget guitar gtr_mash 1})
   )
   (2
      (normal {asset_mgr get_widget guitar normal 2})
      (normal_hopo {asset_mgr get_widget guitar hopo 2})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison star_gem.wid)
      (unison_hopo star_hopo.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget guitar gtr_mash 2})
   )
   (3
      (normal {asset_mgr get_widget guitar normal 3})
      (normal_hopo {asset_mgr get_widget guitar hopo 3})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison star_gem.wid)
      (unison_hopo star_hopo.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget guitar gtr_mash 3})
   )
   (4
      (normal {asset_mgr get_widget guitar normal 4})
      (normal_hopo {asset_mgr get_widget guitar hopo 4})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison_hopo star_hopo.wid)
      (unison star_gem.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget guitar gtr_mash 4})
   )
)
#define BASS_SET (
   (0
      (normal {asset_mgr get_widget bass normal 0})
      (normal_hopo {asset_mgr get_widget bass hopo 0})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison star_gem.wid)
      (unison_hopo star_hopo.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget bass gtr_mash 0})
   )
   (1
      (normal {asset_mgr get_widget bass normal 1})
      (normal_hopo {asset_mgr get_widget bass hopo 1})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison star_gem.wid)
      (unison_hopo star_hopo.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget bass gtr_mash 1})
   )
   (2
      (normal {asset_mgr get_widget bass normal 2})
      (normal_hopo {asset_mgr get_widget bass hopo 2})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison star_gem.wid)
      (unison_hopo star_hopo.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget bass gtr_mash 2})
   )
   (3
      (normal {asset_mgr get_widget bass normal 3})
      (normal_hopo {asset_mgr get_widget bass hopo 3})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison star_gem.wid)
      (unison_hopo star_hopo.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget bass gtr_mash 3})
   )
   (4
      (normal {asset_mgr get_widget bass normal 4})
      (normal_hopo {asset_mgr get_widget bass hopo 4})
      (star star_gem.wid)
      (star_hopo star_hopo.wid)
      (unison_hopo star_hopo.wid)
      (unison star_gem.wid)
      (miss gem_miss.wid)
      (miss_hopo gem_miss_hopo.wid)
      (mash {asset_mgr get_widget bass gtr_mash 4})
   )
)
#define DRUM_SET (
   (0
      (normal {asset_mgr get_widget drum drum 0})
      (star star_kick.wid)
      (unison star_kick.wid)
      (miss kick_miss.wid)
   )
   (1
      (normal {asset_mgr get_widget drum drum 1})
      (tom {asset_mgr get_widget drum drum 1})
      (star drum_star.wid)
      (unison drum_star.wid)
      (miss drum_miss.wid)
      (mash {asset_mgr get_widget drum drum_mash 0})
   )
   (2
      (normal {asset_mgr get_widget drum cymbal 2})
      (tom {asset_mgr get_widget drum drum 2})
      (star {if_else $prodrums cymbal_gem_star.wid drum_star.wid})
      (unison drum_star.wid)
      (miss drum_miss.wid)
      (mash {asset_mgr get_widget drum drum_mash 1})
   )
   (3
      (normal {asset_mgr get_widget drum cymbal 3})
      (tom {asset_mgr get_widget drum drum 3})
      (star {if_else $prodrums cymbal_gem_star.wid drum_star.wid})
      (unison drum_star.wid)
      (miss drum_miss.wid)
      (mash {asset_mgr get_widget drum drum_mash 2})
   )
   (4
      (normal {asset_mgr get_widget drum cymbal 4})
      (tom {asset_mgr get_widget drum drum 4})
      (star {if_else $prodrums cymbal_gem_star.wid drum_star.wid})
      (unison drum_star.wid)
      (miss drum_miss.wid)
      (mash {asset_mgr get_widget drum drum_mash 3})
      (crash {if_else $prodrums dynamic_crash_gem_cymbal.wid dynamic_crash_gem.wid})
   )
)
#define DRUM_LEFTY (
   (0
      (normal {asset_mgr get_widget drum drum 0})
      (star star_kick.wid)
      (unison star_kick.wid)
      (miss kick_miss.wid)
   )
   (1
      (normal {asset_mgr get_widget drum cymbal 4})
      (tom {asset_mgr get_widget drum drum 4})
      (star drum_star.wid)
      (unison drum_star.wid)
      (miss drum_miss.wid)
      (mash {asset_mgr get_widget drum drum_mash 3})
   )
   (2
      (normal {asset_mgr get_widget drum cymbal 3})
      (tom {asset_mgr get_widget drum drum 3})
      (star {if_else $prodrums cymbal_gem_star.wid drum_star.wid})
      (unison drum_star.wid)
      (miss drum_miss.wid)
      (mash {asset_mgr get_widget drum drum_mash 2})
   )
   (3
      (normal {asset_mgr get_widget drum cymbal 2})
      (tom {asset_mgr get_widget drum drum 2})
      (star {if_else $prodrums cymbal_gem_star.wid drum_star.wid})
      (unison drum_star.wid)
      (miss drum_miss.wid)
      (mash {asset_mgr get_widget drum drum_mash 1})
   )
   (4
      (normal {asset_mgr get_widget drum drum 1})
      (tom {asset_mgr get_widget drum drum 1})
      (star {if_else $prodrums cymbal_gem_star.wid drum_star.wid})
      (unison drum_star.wid)
      (miss drum_miss.wid)
      (mash {asset_mgr get_widget drum drum_mash 0})
      (crash {if_else $prodrums dynamic_crash_gem_cymbal_lefty.wid dynamic_crash_gem_lefty.wid})
   )
)
(use_char_tex TRUE)
(slot_colors
   {asset_mgr get_sus 0}
   {asset_mgr get_sus 1}
   {asset_mgr get_sus 2}
   {asset_mgr get_sus 3}
   {asset_mgr get_sus 4}
)
(gem
   (fps 30)
   (mat_formats
      (gem 'gem_%s')
      (tail 'tail_%s')
      (tail_glow 'tail_glow_%s')
      (star 'gem_starpower_%s')
      (dot 'dot_top_hopo2_%s')
   )
   (tail_glow_width 1.7)
   (tail_glow_tight_width 2)
   (sparkle_len 1000)
   (tail_pulse_rate 64)
   (tail_pulse_smoothing 0.5)
   (tail_offset_x 0)
   (tail_min_alpha 0.5)
   (tail_max_alpha 1)
   (tail_alpha_smoothing 0.25)
   (tail_fade_distance 20)
   (tail_min_freq 15)
   (tail_max_freq 4.5)
   (tail_min_amp 0.25)
   (tail_max_amp 1.5)
   (parts
      (
         (gem (type kMeshGem))
         (glow (type kMeshGemGlow))
         (top (type kMeshTop))
         (miss
            (type kMeshGemMiss)
            (default kMeshGem)
         )
         (hopo
            (type kMeshHopoTop)
            (default kMeshTop)
         )
         (star
            (type kMeshStar)
            (default kMeshGem)
         )
         (top_star
            (type kMeshStarTop)
            (default kMeshTop)
         )
         (gem_bonus
            (type kMeshBonus)
            (default kMeshGem)
         )
         (gem_bonus2
            (type kMeshBonus2)
            (default kMeshGem)
         )
      )
   )
   (gems
      (guitar GUITAR_SET)
      (bass BASS_SET)
      (drum DRUM_SET)
      (drum_lefty DRUM_LEFTY)
   )
   (widths
      (kick_line4 4)
      (snare_red3 3)
      (snare_orange3 3)
   )
)
(nowbar_tail_clip 1.5)