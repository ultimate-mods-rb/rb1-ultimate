#define CHEATS_ALLOWED (
   {&&
      {exists ui}
      {! {ui in_transition}}
      {== {ui current_screen} splash_screen}
   }
)
#define G_RED (kPad_Tri)
#define G_YELLOW (kPad_Circle)
#define G_BLUE (kPad_Square)
(
   (G_RED G_YELLOW G_BLUE G_RED G_RED G_BLUE G_BLUE G_RED G_YELLOW G_BLUE)
   {if CHEATS_ALLOWED
      {if {profile_mgr unlock_all_songs}
         {ui push_screen unlock_all_screen}
      }
   }
)
(
   (kPad_Select kPad_Select)
   {if_else
      {'||'
         {overshell up}
         {ui in_transition}
         {find_elem
            (
               game_screen
               hth_game_screen
               practice_game_screen
               jukebox_game_screen
               drum_trainer_beats_screen
               drum_trainer_fills_screen
               drum_trainer_freestyle_screen
            )
            {ui current_screen}
         }
         ;{&& ; if screens are synced and online
         ;   {band_ui_sink net_sync}
         ;   {!= {session mode} kNetLocal}
         ;}
      }
      {print "overshell blocked from opening"}
      {overshell set_up TRUE}
   }
)
(
   (kPad_L2 kPad_L1 kPad_DRight)
   #ifdef HX_PS3
   {run "GD:/dev_hdd0/rb1/run.dta"}
   #else
   {run "GAME:/run.dta"}
   #endif
)