#ifdef _SHIP
{func print
   ($s)
   #ifdef HX_PS3
   {run {sprintf "GD:/%d    %s    %d" {random_int 100 1000} {sprint $s} {random_int 100 1000}}}
   #else
   kDataUnhandled
   #endif
}
{func fail
   ($s)
   {print $s}
   ;{exit} ; crashes in some cases
   {delete rnd} ; will call abort so stable
}
#endif
{func dump_array
   ($a $p)
   {do
      ($o {new ObjectDir temp_dir})
      {$o set array $a}
      {$o save_objects $p}
      {delete $o}
      #ifdef HX_PS3
      {print {sprint "array dumped to " $p}}
      #endif
   }
}
{func set_var
   ($var $in)
   {eval {` {set {, {var $var}} $in}}}
}
{func eval_var
   ($var)
   {eval {var $var}}
}
{func toggle_var
   ($var)
   {eval {` {set {, {var $var}} {! {eval_var $var}}}}}
}
; array in rb1 can only be passed an int
{func eval_array
   ($array)
   {do
      ($a {array 0})
      {foreach $elem $array
         {push_back $a {eval $elem}}
      }
      $a
   }
}
{func lst_reset {do
   ($array {array 0})
   {foreach $entry {$this get data}
      {if_else {== {type $entry} kDataArray} ; just return whatever was passed if not array
         {switch {elem {find $entry type} 1}
            (uNormal
               {push_back $array {eval {elem $entry 0}}}
            )
            (uOnOFF
               {push_back $array
                  {sprintf
                     {localize os_onoff_fmt}
                     {localize_token {elem $entry 0}}
                     {localize {if_else {eval {elem {find $entry bool} 1}} on off}}
                  }
               }
            )
            ((uSld uFakeSld uColorSld)
               {push_back $array
                  {do
                     ($type {elem {find $entry type} 1})
                     ($selected {== {- {size $array} 1} {elem [pos] 0}})
                     ($fmt_type {elem {find $entry fmt_type} 1})
                     ($hide_on_sel
                        {if_else {find_exists $entry hide_on_sel}
                           {elem {find $entry hide_on_sel} 1}
                           FALSE
                        }
                     )
                     ($data
                        {cond
                           ({find_exists $entry var}
                              {eval_var {elem {find $entry var} 1}}
                           )
                           ({find_exists $entry get}
                              {eval {elem {find $entry get} 1}}
                           )
                           (TRUE {fail "unable to find data for sld"})
                        }
                     )
                     ($fmt
                        {switch $fmt_type
                           (uNormal $data)
                           (uColor
                              {localize
                                 {switch $data
                                    (0 color_green)
                                    (1 color_red)
                                    (2 color_yellow)
                                    (3 color_blue)
                                    (4 color_orange)
                                    invalid
                                 }
                              }
                           )
                           (uDrumColor
                              {localize
                                 {switch $data
                                    (0 kick)
                                    (1 color_red)
                                    (2 color_yellow)
                                    (3 color_blue)
                                    (4 color_green)
                                    invalid
                                 }
                              }
                           )
                           (uCunt
                              {localize
                                 {switch $data
                                    (kPad_L2 os_pad_l2)
                                    (kPad_L1 os_pad_l1)
                                    (kPad_R1 os_pad_r1)
                                    (kPad_R2 os_pad_r2)
                                    (kPad_X os_pad_x)
                                    (kPad_Circle os_pad_circle)
                                    (kPad_Square os_pad_square)
                                    (kPad_Tri os_pad_tri)
                                    (kPad_DUp os_pad_dup)
                                    (kPad_DDown os_pad_ddown)
                                    (kPad_DLeft os_pad_dleft)
                                    (kPad_DRight os_pad_dright)
                                    (kPad_L3 os_pad_l3)
                                    (kPad_R3 os_pad_r3)
                                    (kPad_Select os_pad_select)
                                    invalid
                                 }
                              }
                           )
                           (uSync
                              {localize
                                 {switch $data
                                    (0 infinite)
                                    (1 full)
                                    (2 half)
                                    (4 quarter)
                                    invalid
                                 }
                              }
                           )
                           (uInst
                              {localize
                                 {switch $data
                                    (kControllerGuitar guitar_sym)
                                    (kControllerDrum drum_sym)
                                    (kControllerVocals vocals_sym)
                                    invalid
                                 }
                              }
                           )
                           (uMapping
                              {localize
                                 {switch $data
                                    (0 custom)
                                    (1 guitar_sym)
                                    (2 gh_guitar)
                                    (3 ps2_guitar)
                                    (4 drum_sym)
                                    invalid
                                 }
                              }
                           )
                           (uSpeed {int {+ {* $data 100} 0.5}})
                           (uTimer
                              {localize
                                 {switch $data
                                    (0 off)
                                    (1 time_total)
                                    (2 remaining_total)
                                    (3 remaining)
                                    (4 time)
                                    (5 total)
                                    invalid
                                 }
                              }
                           )
                           (uLocalize {localize $data})
                           (uColorRGB
                              {do
                                 ($r) ($g) ($b)
                                 ($i
                                    {if_else {OS_LIST has (color_index)}
                                       {OS_LIST get color_index}
                                       0
                                    }
                                 )
                                 {if $selected
                                    {color.mat set color $data}
                                 }
                                 {unpack_color $data $r $g $b}
                                 {sprintf {localize_token {sprintf "os_color_fmt_%d" $i}} $r $g $b}
                              }
                           )
                           (uAspect
                              {localize
                                 {switch $data
                                    (kSquareAspect aspect_square)
                                    (kRegularAspect apsect_regular)
                                    (kWidescreenAspect aspect_widescreen)
                                    invalid
                                 }
                              }
                           )
                        }
                     )
                     {cond
                        ({&& {== $type uColorSld} $selected {$this has (focused)} [focused]} $fmt)
                        ({== $type uColorSld} {localize {elem $entry 0}})
                        ({&& $hide_on_sel $selected {$this has (focused)} [focused]}
                           {sprint {localize os_l} $fmt {localize os_r}}
                        )
                        ($hide_on_sel {localize {elem $entry 0}})
                        (TRUE {sprintf {localize {elem $entry 0}} $fmt})
                     }
                  }
               }
            )
            {fail {sprint {elem {find $entry type} 1} " is an unknown type"}}
         }
         {push_back $array {eval $entry}}
      }
   }
   {OS_LIST set_data $array}
   {if {$this has (pos)}
      {OS_LIST set_selected {elem [pos] 0} {elem [pos] 1}}
      {if {&& {$this has (focused)} [focused]}
         {foreach $entry $array
            {if {!= $entry {elem $array {elem [pos] 0}}}
               {OS_LIST disable_data {symbol $entry}}
            }
         }
      }
   }
   {os_update_helpbar}
}}
{func os_setup_common
   {title.lbl set text_token [title]}
   {lst_reset}
}
{func os_sel_common {do
   ($entry {elem [data] {OS_LIST selected_pos}})
   {if_else
      {&&
         {== {type $entry} kDataArray}
         {!
            {do
               ($block {find_exists $entry block_ingame})
               ($bool)
               {if {&& $block {exists beatmatch}}
                  {set $bool {elem $block 1}}
               }
               $bool
            }
         }
      }
      {do
         {switch {elem {find $entry type} 1}
            ((uNormal uOnOFF)
               {foreach $cmd {find $entry sel_script}
                  {eval $cmd}
               }
            )
            ((uSld uFakeSld uColorSld)
               {$this set focused TRUE}
               {OS_LIST set store
                  {cond
                     ({find_exists $entry var}
                        {eval_var {elem {find $entry var} 1}}
                     )
                     ({find_exists $entry get}
                        {eval {elem {find $entry get} 1}}
                     )
                     (TRUE {fail "unable to find data for sld"})
                  }
               }
               {if {== {elem {find $entry type} 1} uColorSld}
                  {OS_LIST set color_index 0}
                  {color.mesh set_showing TRUE}
                  {color.tnm set_frame
                     {- {OS_LIST selected_pos} {OS_LIST first_showing}}
                  }
               }
            )
         }
      }
      {synth play button_error}
   }}
   {lst_reset}
}
{func os_down_common {do
   ($entry {elem [data] {OS_LIST selected_pos}})
   {if_else {== {type $entry} kDataArray}
      {switch {elem {find $entry type} 1}
         ((uSld uFakeSld uColorSld)
            {if_else {&& {$this has (focused)} [focused]}
               {switch $button
                  (kPad_X
                     {synth play button_select}
                     {$this set focused FALSE}
                     {OS_LIST set store 0}
                     {color.mesh set_showing FALSE}
                     {os_update_helpbar}
                     {lst_reset}
                  )
                  (kPad_Tri
                     {synth play button_back}
                     {$this set focused FALSE}
                     {cond
                        ({find_exists $entry var}
                           {set_var {elem {find $entry var} 1} {OS_LIST get store}}
                        )
                        ({find_exists $entry get} {do
                           ($r {OS_LIST get store})
                           {eval {elem {find $entry set} 1}}
                        })
                        (TRUE {fail "unable to find data for sld"})
                     }
                     {OS_LIST set store 0}
                     {color.mesh set_showing FALSE}
                     {lst_reset}
                  )
                  (kPad_R1
                     {if {== {elem {find $entry type} 1} uColorSld}
                        {synth play button_back}
                        {OS_LIST set color_index
                           {switch {OS_LIST get color_index}
                              (0 1)
                              (1 2)
                              (2 0)
                           }
                        }
                        {lst_reset}
                     }
                  )
                  ((kPad_DUp kPad_DLeft) {do
                     ($data '')
                     ($type '')
                     ($r)
                     {synth play button_toggle}
                     {cond
                        ({find_exists $entry var}
                           {set $data {eval_var {elem {find $entry var} 1}}}
                           {set $type var}
                        )
                        ({find_exists $entry get}
                           {set $data {eval {elem {find $entry get} 1}}}
                           {set $type get}
                        )
                        (TRUE {fail "unable to find data for sld"})
                     }
                     {set $r
                        {switch {elem {find $entry type} 1}
                           (uSld
                              {clamp
                                 {- $data {elem {find $entry step} 1}}
                                 {elem {find $entry range} 1}
                                 {elem {find $entry range} 2}
                              }
                           )
                           (uFakeSld
                              {prev_elem
                                 {eval {elem {find $entry array} 1}}
                                 $data
                              }
                           )
                           (uColorSld
                              {do
                                 ($r) ($g) ($b)
                                 {unpack_color $data $r $g $b}
                                 {set_var {elem (r g b) {OS_LIST get color_index}}
                                    {clamp {- {eval_var {elem (r g b) {OS_LIST get color_index}}} 0.01} 0.00 1.00}
                                 }
                                 {pack_color $r $g $b}
                              }
                           )
                        }
                     }
                     {switch $type
                        (var {set_var {elem {find $entry var} 1} $r})
                        (get {eval {elem {find $entry set} 1}})
                     }
                     {lst_reset}
                  })
                  ((kPad_DDown kPad_DRight) {do
                     ($data '')
                     ($type '')
                     ($r)
                     {synth play button_toggle}
                     {cond
                        ({find_exists $entry var}
                           {set $data {eval_var {elem {find $entry var} 1}}}
                           {set $type var}
                        )
                        ({find_exists $entry get}
                           {set $data {eval {elem {find $entry get} 1}}}
                           {set $type get}
                        )
                        (TRUE {fail "unable to find data for sld"})
                     }
                     {set $r
                        {switch {elem {find $entry type} 1}
                           (uSld
                              {clamp
                                 {+ $data {elem {find $entry step} 1}}
                                 {elem {find $entry range} 1}
                                 {elem {find $entry range} 2}
                              }
                           )
                           (uFakeSld
                              {next_elem
                                 {eval {elem {find $entry array} 1}}
                                 $data
                              }
                           )
                           (uColorSld
                              {do
                                 ($r) ($g) ($b)
                                 {unpack_color $data $r $g $b}
                                 {set_var {elem (r g b) {OS_LIST get color_index}}
                                    {clamp {+ {eval_var {elem (r g b) {OS_LIST get color_index}}} 0.01} 0.00 1.00}
                                 }
                                 {pack_color $r $g $b}
                              }
                           )
                        }
                     }
                     {switch $type
                        (var {set_var {elem {find $entry var} 1} $r})
                        (get {eval {elem {find $entry set} 1}})
                     }
                     {lst_reset}
                  })
               }
               {switch {elem {find $entry type} 1}
                  (uColorSld
                     {switch $button
                        (kPad_R1
                           {if_else {&& {OS_LIST has (color)} {!= {OS_LIST get color} -1}}
                              {do
                                 {cond
                                    ({find_exists $entry var}
                                       {set_var {elem {find $entry var} 1} {OS_LIST get color}}
                                    )
                                    ({find_exists $entry get} {do
                                       ($r {OS_LIST get color})
                                       {eval {elem {find $entry set} 1}}
                                    })
                                    (TRUE {fail "unable to find data for color"})
                                 }
                                 {OS_LIST set color -1}
                              }
                              {do
                                 ($data
                                    {cond
                                       ({find_exists $entry var}
                                          {eval_var {elem {find $entry var} 1}}
                                       )
                                       ({find_exists $entry get}
                                          {eval {elem {find $entry get} 1}}
                                       )
                                       (TRUE {fail "unable to find data for color"})
                                    }
                                 )
                                 {OS_LIST set color $data}
                              }
                           }
                           {os_update_helpbar}
                        )
                        {os_unhandled_down}
                     }
                  )
                  {os_unhandled_down}
               }
            }
         )
         {os_unhandled_down}
      }
      {os_unhandled_down}
   }}
}
{func os_unhandled_down
   {if
      {&&
         {== $button kPad_Tri}
         {do
            {synth play button_back}
            {$this has (pos)}
         }
      }
      {set [pos] (0 0)}
   }
   kDataUnhandled
}
{func os_update_helpbar {do
   ($entry {elem [data] {OS_LIST selected_pos}})
   ($type
      {if_else {== {type $entry} kDataArray}
         {elem {find $entry type} 1}
         kDataUnhandled
      }
   )
   {helpbar set_config
      {if_else {== {type $entry} kDataArray}
         {cond
            ({&& {== $type uColorSld} {$this has (focused)} [focused]}
               (
                  helpbar_cancel
                  helpbar_confirmsetting
                  os_nextcolor
               )
            )
            ({&& {== $type uColorSld} {OS_LIST has (color)} {!= {OS_LIST get color} -1}}
               (
                  helpbar_back
                  os_changecolor
                  os_paste
               )
            )
            ({== $type uColorSld}
               (
                  helpbar_back
                  os_changecolor
                  os_copy
               )
            )
            ({&& {$this has (focused)} [focused]}
               (
                  helpbar_cancel
                  helpbar_confirmsetting
               )
            )
            ({find_elem (uOnOFF uSld uFakeSld) $type}
               (
                  helpbar_back
                  helpbar_changesetting
               )
            )
            (TRUE
               (
                  helpbar_back
                  helpbar_select
               )
            )
         }
         (
            helpbar_back
            helpbar_select
         )
      }
   }
}}
{func get_elem
    ($array $data)
    {do
        ($elem)
        ($notfound TRUE)
        ($size {- {size $array} 1})
        {while {&& $notfound {<= $elem $size}}
            {if_else {== {elem $array $elem} $data}
               {set $notfound FALSE}
               {++ $elem}
            }
        }
        $elem
    }
}
{func next_elem
   ($array $data)
   {elem $array
      {max
         {min
            {+ {get_elem $array $data} 1}
            {- {size $array} 1}
         }
         0
      }
   }
}
{func prev_elem
   ($array $data)
   {elem $array
      {max
         {min
            {- {get_elem $array $data} 1}
            {- {size $array} 1}
         }
         0
      }
   }
}
{func force_drum_freestyle
   ($bool)
   {unless {gamemode get is_drum_trainer}
      {game foreach_local_player $p
         {if {&& $p {== {$p instrument} drum}}
            {$p force_fill $bool}
         }
      }
   }
}
{func clear_array
   ($obj $name)
   {while {size {$obj get_array $name}}
      {$obj remove ($name 0)}
   }
}
{func seconds_to_time
   ($float)
   {do
      ($minutes {int {/ $float 60}})
      ($seconds {int {mod $float 60}})
      {sprintf "%d:%s"
         $minutes
         {if_else {< $seconds 10}
            {sprintf "0%d" $seconds}
            {sprint $seconds}
         }
      }
   }
}
{func is_vocals_on_top
   {if_else {exists beatmatch}
      {do
         ($size 0)
         ($bool 0)
         {beatmatch foreach_active_player $player
            {if {== {$player instrument} vocals}
               {set $bool TRUE}
            }
            {++ $size}
         }
         {&& {>= $size 2} $bool}
      }
      {print "considering beatmatch doesn't exist it's safe to say vocals isn't on top"}
   }
}
{func get_dir_from_player
   ($player)
   {{get_track_panel} find
      {if_else {== {gamemode get player_arrangement} kArrangeHth}
         {sprint "track_" {str_elem {{$player track} name} 5}}
         {$player instrument}
      }
   }
}
{func set_track_speeds
   {foreach $obj [gem_tracks] {do
      ($player {$obj get player})
      ($diff_view_time
         {cond
            ($syncdifspeeds 1.2)
            ($indvtrkspeeds {elem (2.4 2.0 1.6 1.2) {$player difficulty}})
            (TRUE {+ 2.4 {* $average_difficulty -1.2}})
         }
      )
      ($ts
         {eval_var
            {sprint
               {if_else {== {gamemode get player_arrangement} kArrangeHth}
                  {$player track}
                  {$player instrument}
               }
               "_trackspeed"
            }
         }
      )
      ($hwss
         {if_else {== $hwlength 1.0}
            1.0
            {if_else {> $hwlength 2.0}
               {/ $hwlength 1.4}
               {if_else {> $hwlength 1.0}
                  {/ $hwlength {+ {* 0.4 $hwlength} 0.6}}
                  {* $hwlength {+ {* -1.5 $hwlength} 2.5}}
               }
            }
         }
      )
      ($view_time {* {* {/ $diff_view_time $ts} $hwss} {get_song_speed}})
      {print {sprint $obj " " $diff_view_time " " $ts " " $hwss " " $view_time}}
      {$obj set y_per_second {/ {$obj get top_y} $view_time}}
   }}
}
{func apply_gfx_settings
   {rnd set_sync $vsyncrate}
   {$world iterate PostProc $p {with $p
      {if_else {game is_loaded}
         {unless {$this has (p)}
            {set [emulate_fps]
               {if_else {>= $emulatefps 35}
                  60
                  {clamp {* [emulate_fps] {/ $emulatefps 24}} 1 30}
               }
            }
            {$this set p 1}
         }
         {set [emulate_fps] 60}
      }
      {if {! $scrnoise}
         {set [noise_base_scale x] 0}
         {set [noise_base_scale y] 0}
      }
      {if {&& {! $scrbloom} [bloom_intensity]}
         {set [bloom_intensity]
            #ifdef HX_PS3
            ; setting this to 0 breaks some visual effects but bloom is fucked on ps3 anyways
            ; the entire game is super blurry with it even slightly on
            0
            #else
            0.01
            #endif
         }
      }
   }}
   {$world iterate CamShot $cs
      {unless $fxdof
         {$cs set use_depth_of_field FALSE}
      }
      {unless $camerashake
         {foreach_int $i 0 {$cs size (keyframes)}
            {$cs set (keyframes $i shake_noisefreq) 0}
            {$cs set (keyframes $i shake_noiseamp) 0}
            {$cs set (keyframes $i shake_maxangle x) 0}
            {$cs set (keyframes $i shake_maxangle y) 0}
         }
      }
      {if $force_per_pixel
         {$cs set ps3_per_pixel TRUE}
      }
   }
   {if $bigmode {do
      ($x) ($y) ($z)
      {$world iterate Character $c
         {$c iterate Mesh $m
            {$m get_local_scale $x $y $z}
            {$m set_local_scale
               {* $x 2}
               {* $y 2}
               {* $z 2}
            }
         }
      }
   }}
   {if $smallworld {do
      ($x) ($y) ($z)
      {$world iterate Mesh $m
         {$m get_local_scale $x $y $z}
         {$m set_local_scale
            {/ $x 2}
            {/ $y 2}
            {/ $z 2}
         }
      }
      {$world iterate RndDir $dir
         {unless {$dir is_a Character}
            {$dir iterate Mesh $m
               {$m get_local_scale $x $y $z}
               {$m set_local_scale
                  {/ $x 2}
                  {/ $y 2}
                  {/ $z 2}
               }
            }
         }
      }
   }}
   {if $honestmode {do
      ($array {array 0})
      {$honestmilo iterate Tex $t
         {push_back $array $t}
      }
      {$world iterate Mat $m
         {$m set diffuse_tex {random_elem $array}}
      }
      {$world iterate RndDir $dir
         {unless {$dir is_a Character}
            {$dir iterate Mat $m
               {$m set diffuse_tex {random_elem $array}}
            }
         }
      }
   }}
   {if $hidechars
      {$world iterate Character $c
         {$c set_showing FALSE}
      }
   }
   {if $scale_head
      {$world iterate CompositeCharacter $c
         {if {$c exists bone_head.mesh} {with $c
            {unless {exists scale_head}
               {new Trans scale_head}
            }
            {scale_head set_local_scale 2 2 2}
            {scale_head set_trans_parent bone_head_nod.mesh}
            {bone_head.mesh set_trans_parent scale_head}
         }}
      }
   }
   ; TEST DONT FUCKING PUSH DONT FUCKING PUSH
   {if $mikan
   }
}
{func tolower ; fuck you harmonix
   ($string)
   {search_replace $string "A" "a" $string}
   {search_replace $string "B" "b" $string}
   {search_replace $string "C" "c" $string}
   {search_replace $string "D" "d" $string}
   {search_replace $string "E" "e" $string}
   {search_replace $string "F" "f" $string}
   {search_replace $string "G" "g" $string}
   {search_replace $string "H" "h" $string}
   {search_replace $string "I" "i" $string}
   {search_replace $string "J" "j" $string}
   {search_replace $string "K" "k" $string}
   {search_replace $string "L" "l" $string}
   {search_replace $string "M" "m" $string}
   {search_replace $string "N" "n" $string}
   {search_replace $string "O" "o" $string}
   {search_replace $string "P" "p" $string}
   {search_replace $string "Q" "q" $string}
   {search_replace $string "R" "r" $string}
   {search_replace $string "S" "s" $string}
   {search_replace $string "T" "t" $string}
   {search_replace $string "U" "u" $string}
   {search_replace $string "V" "v" $string}
   {search_replace $string "W" "w" $string}
   {search_replace $string "X" "x" $string}
   {search_replace $string "Y" "y" $string}
   {search_replace $string "Z" "z" $string}
   $string
}
{func char_code
   ($char)
   {switch $char
      (" " 32)
      ("!" 33)
