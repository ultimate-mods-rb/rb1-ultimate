(rb1 (rgb TRUE))
(rb2
   (rgb TRUE)
   (file "ulti/track/gems/rb2/gems.milo")
   (meshes
      (
         (gem_green_hopo.wid (prism_glow_hopo_green.mesh prism_gem_hopo_green.mesh))
         (gem_red_hopo.wid (prism_glow_hopo_red.mesh prism_gem_hopo_red.mesh))
         (gem_yellow_hopo.wid (prism_glow_hopo_yellow.mesh prism_gem_hopo_yellow.mesh))
         (gem_blue_hopo.wid (prism_glow_hopo_blue.mesh prism_gem_hopo_blue.mesh))
         (gem_orange_hopo.wid (prism_glow_hopo_orange.mesh prism_gem_hopo_orange.mesh))
         (gem_miss_hopo.wid (prism_glow_hopo_miss.mesh prism_gem_hopo_miss.mesh))
         (star_hopo.wid (prism_glow_hopo_style.mesh prism_gem_hopo_style.mesh))
      )
   )
   (on_load
      {{get_track_panel} iterate TrackDir $dir
         {with $dir
            {foreach $color (green red yellow blue orange miss)
               {{$gems_dir find {sprintf "prism_glow_hopo_%s.mesh" $color}} set_mat prism_glow_blue.mat}
               {{$gems_dir find {sprintf "prism_gem_hopo_%s.mesh" $color}} set_mat prism_mat.mat}
            }
            {{$gems_dir find prism_glow_hopo_style.mesh} set_mat prism_glow_blue.mat}
            {{$gems_dir find prism_gem_hopo_style.mesh} set_mat prism_mat.mat}
         }
      }
   )
   (on_load_rgb
      {{get_track_panel} iterate TrackDir $dir {with $dir
         {foreach_int $i 0 7 {do
            ($base {sprintf "gtr_base_%d.mat" $i})
            ($color {sprintf "gtr_color_%d.mat" $i})
            ($cs {elem (green red yellow blue orange style miss) $i})
            {if {== $i 5}
               {set $color gtr_glow_style.mat}
            }
            {{$gems_dir find {sprintf "prism_gem_hopo_%s.mesh" $cs}} set_mat $base}
            {{$gems_dir find {sprintf "prism_glow_hopo_%s.mesh" $cs}} set_mat $color}
         }}
      }}
   )
)
