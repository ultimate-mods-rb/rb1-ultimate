(rb1
   (rgb TRUE)
   (guitar TRUE)
   (drum TRUE)
)
#ifndef HX_EE
(gh2
   (guitar TRUE)
   (rgb TRUE)
   (on_load {do
      ($name {sprint {$player track}})
      ($track {get_dir_from_player $player})
      ($dir '')
      {with $smashers_dir
         {set $dir {new ObjectDir $name}}
         {insert_milo $dir "ulti/track/smashers/gh2/gh2_proxy.milo"}
         {$dir set rgb $rgb}
         {$dir set inst $inst}
         {$dir set smashers $smashers}
      }
      {if $track
         {{$track find bass_superstreak_plane.mesh} set_local_pos_index 1 37.75}
         {clear_array {$track find now_bar_rising_sun_draw.grp} objects}
         {{{$track find smasher_plate_guitar} find smasher_plate.mesh} set_showing FALSE}
         {foreach_int $i 0 5 {do
            ($m {$dir find {sprintf "gem_smasher%d.mesh" $i}})
            ($r {$dir find {sprintf "smasher_rim%d.mesh" $i}})
            {$r set_mat
               {$dir find
                  {sprintf "now_ring_%s.mat"
                     {asset_mgr get_smasher_color $inst $i}
                  }
               }
            }
            {with {{$track find smasher_plate_guitar} find {sprint gem_smasher $i}}
               {new Trans smashers_parent.trans}
               {smashers_parent.trans set_trans_parent smasher_react.trans}
               {smashers_parent.trans set_local_pos 0 -1 0.1}
               {smashers_parent.trans set_local_scale 1.04 1.04 1.04}

               {$m set_trans_parent smashers_parent.trans}
               {$r set_trans_parent smashers_parent.trans}

               {clear_array base_bottom.grp objects}
               {base_bottom.grp add_object $m}
               {base_bottom.grp add_object $r}

               {clear_array base_top.grp objects}

               {$this set custom gh2}
               {$this sync_objects}
            }
         }}
      }
   })
   (apply_rgb
      {with $dir
         {foreach_int $i 0 5 {do
            ($c {asset_mgr get_color_smasher $inst $i})
            ($cs {elem (green red yellow blue orange) $i})

            ($r {sprintf "now_ring_%s.mat" $cs})
            ($v {sprintf "now_ring_%s_1.mat" $cs})
            ($s {sprintf "gem_smasher_%s.mat" $cs})
            ($a {sprintf "gem_smasher_%s_1.mat" $cs})

            {$r set color $c}
            
            {$v set blend 0}
            {$v set diffuse_tex now_white_add.tex}

            {$s set color $c}
            {$s set diffuse_tex smasher_white.tex}

            {$a set diffuse_tex smasher_add_white.tex}
         }}
      }
   )
)
#endif
#define GH_SMASHERS_COMMON (
   (guitar TRUE)
   (on_load {do
      ($name {sprint {$player track}})
      ($track {get_dir_from_player $player})
      ($dir '')
      {with $smashers_dir
         {set $dir {new ObjectDir $name}}
         {insert_milo $dir {sprintf "ulti/track/smashers/%s/%s_proxy.milo" $smashers $smashers}}
         {$dir set rgb $rgb}
         {$dir set inst $inst}
         {$dir set smashers $smashers}
      }
      {$dir iterate Mat $m
         {$m set alpha_cut TRUE}
         {$m set z_mode kZModeTransparent}
      }
      {if $track
         {{$track find bass_superstreak_plane.mesh} set_local_pos_index 1 37.75}
         {clear_array {$track find now_bar_rising_sun_draw.grp} objects}
         {{{$track find smasher_plate_guitar} find smasher_plate.mesh} set_showing FALSE}
         {foreach_int $i 0 5 {do
            ($m {$dir find {sprintf "fret_%d.mesh" {+ $i 1}}})
            ($l {$dir find {sprintf "fret_%d_l.mesh" {+ $i 1}}})
            {$m set_mat {$dir find {sprintf "fret_%d.mat" {+ {elem {asset_mgr config_get $inst smasher_colors} $i} 1}}}}
            {$l set_mat {$dir find {sprintf "fret_%d_l.mat" {+ {elem {asset_mgr config_get $inst smasher_colors} $i} 1}}}}
            {with {{$track find smasher_plate_guitar} find {sprint gem_smasher $i}}
               {new Trans smashers_parent.trans}
               {smashers_parent.trans set_trans_parent smasher_react.trans}
               {smashers_parent.trans set_local_pos 0 0.4 0.34}
               {smashers_parent.trans set_local_rot 2 0 0}
               {smashers_parent.trans set_local_scale 1.07 1 1}

               {$m set_trans_parent smashers_parent.trans}
               {$l set_trans_parent smashers_parent.trans}

               {clear_array base_bottom.grp objects}
               {base_bottom.grp add_object $m}

               {base_top.grp set_showing FALSE}
               {clear_array base_top.grp objects}
               {base_top.grp add_object $l}

               {$this set custom gh3}
               {$this sync_objects}
            }
         }}
      }
   })
)
(gh3 GH_SMASHERS_COMMON)
(gh3_beta GH_SMASHERS_COMMON)
(ghwor
   GH_SMASHERS_COMMON
   (rgb TRUE)
   (on_load_rgb {do
      ($name {sprint {$player track}})
      ($track {get_dir_from_player $player})
      ($dir '')
      {with $smashers_dir
         {set $dir {new ObjectDir $name}}
         {insert_milo $dir "ulti/track/smashers/ghwor/ghwor_rgb_proxy.milo"}
         {$dir set rgb $rgb}
         {$dir set inst $inst}
         {$dir set smashers $smashers}
      }
      {$dir iterate Mat $m
         {$m set alpha_cut TRUE}
         {$m set z_mode kZModeTransparent}
      }
      {if $track
         {{$track find bass_superstreak_plane.mesh} set_local_pos_index 1 37.75}
         {clear_array {$track find now_bar_rising_sun_draw.grp} objects}
         {{{$track find smasher_plate_guitar} find smasher_plate.mesh} set_showing FALSE}
         {foreach_int $i 0 5 {do
            ($m {$dir find {sprintf "fret_%d.mesh" {+ $i 1}}})
            ($l {$dir find {sprintf "fret_%d_l.mesh" {+ $i 1}}})
            {with {{$track find smasher_plate_guitar} find {sprint gem_smasher $i}}
               {new Trans smashers_parent.trans}
               {smashers_parent.trans set_trans_parent smasher_react.trans}
               {smashers_parent.trans set_local_pos 0 0.4 0.34}
               {smashers_parent.trans set_local_rot 2 0 0}
               {smashers_parent.trans set_local_scale 1.07 1 1}

               {$m set_trans_parent smashers_parent.trans}

               {clear_array base_bottom.grp objects}
               {base_bottom.grp add_object $m}

               {base_top.grp set_showing FALSE}
               {clear_array base_top.grp objects}
               {base_top.grp add_object $m}

               {$this set custom gh_rgb}
               {$this sync_objects}
            }
         }}
      }
   })
   (apply_rgb
      {with $dir
         {foreach_int $i 0 5 {do
            ($c {asset_mgr get_color_smasher $inst $i})
            ($m {sprintf "fret_%d_color.mat" {+ $i 1}})
            {$m set color $c}
         }}
      }
   )
)
(ghl GH_SMASHERS_COMMON)