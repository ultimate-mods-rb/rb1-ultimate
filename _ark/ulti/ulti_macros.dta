#define OS_LIST (sel_section.lst)
#define HANDLE_MIC_DEPLOY (
   (BUTTON_DOWN_MSG
      {if_else
         {&&
            {== $button kPad_Select}
            {gamecfg is_player_participating $player_num}
            {== {{gamecfg get_player_config $player_num} get_track_sym} vocals}
         }
         {{beatmatch active_player $player_num} set_scream_thresholds -1.0 -1.0}
         kDataUnhandled
      }
   )
   (BUTTON_UP_MSG
      {if_else
         {&&
            {== $button kPad_Select}
            {gamecfg is_player_participating $player_num}
            {== {{gamecfg get_player_config $player_num} get_track_sym} vocals}
         }
         {if_else $micdeploy
            {{beatmatch active_player $player_num} set_scream_thresholds 0.1 0.39}
            {{beatmatch active_player $player_num} set_scream_thresholds 1.1 0.39}
         }
         kDataUnhandled
      }
   )
)

