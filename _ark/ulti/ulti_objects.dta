         (vertical TRUE)
         (element ((text "list.lbl")))
         (back_arrow "back.mesh")
         (next_arrow "next.mesh")
         (highlight
            "highlight.mesh"
            (colors
               (selecting 0.75 0.75 0.75)
               (normal 1 1 1)
               (disabled 0.3 0.3 0.3)
            )
         )
         (colors
            (
               (
                  (normal
                     (normal 0 0 0)
                     (focused 0 0 0)
                     (disabled 0.5 0.5 0.5)
                     (selecting 0 0 0)
                  )
                  (highlight
                     (normal 0 0 0)
                     (focused 0 0 0)
                     (disabled 0.5 0.5 0.5)
                     (selecting 0 0 0)
                  )
                  (disabled
                     (normal 0.5 0.5 0.5)
                     (focused 0.5 0.5 0.5)
                     (disabled 0.5 0.5 0.5)
                     (selecting 0.5 0.5 0.5)
                  )
               )
            )
         )
         (provider ("song name"))
      )
   )
)
