(Object
   (types
      (countdown
         (active FALSE)
         (done FALSE)
         (alive TRUE)
         (hide_at_end FALSE)
         (current_event 0)
         (total_events 0)
         (remaining 0)
         (event_array 0)
         (target 0)
         (track 0)
         (player 0)
         (parser)
         (parent 0)
         (anim 0)
         (init
            ($player $dir)
            {set [player] $player}
            {set [track] {get_dir_from_player $player}}
            {set [parser] {object
               {sprint
                  {if_else {gamemode get separate_parts}
                     {[player] track}
                     {[player] instrument}
                  }
                  "_countdown_mp"
               }
            }}
            {print {sprint {$player instrument} " " {[track] name} " " {$dir name}}}
            {with $dir
               {unless {$this has (init)}
                  {{meter_wipe.mnm dir} set_trans_parent $this}
                  {if_else {== {$player instrument} vocals}
                     {do
                        {{meter_wipe.mnm dir} set_local_scale 0.5 0.5 0.5}
                        {{meter_wipe.mnm dir} set_local_pos 0 0 -0.5}
                     }
                     {do
                        {{meter_wipe.mnm dir} set_local_scale 1.5 1.5 1.5}
                        {{meter_wipe.mnm dir} set_local_pos 0 0 -27}
                     }
                  }
                  {multiplier.txt set_font fakir_black_outline.font}
                  {multiplier.txt set_align kMiddleCenter}
                  {multiplier.txt set_local_pos -0.1 0 0.2}
                  {multiplier.txt set_local_scale 1.2 1.2 1.2}
                  {$this set init TRUE}
                  {$this sync_objects}
               }
            }
            {set [target] {$dir find multiplier.txt}}
            {set [anim] {$dir find meter_wipe.mnm}}
            {set [parent] {$dir find streak_meter.grp}}
            {[parent] set_showing FALSE}
            {set [event_array] {eval_array {[parser] get event_array}}}
            {unless {[parser] get first_note}
               {do
                  ($pos {[parser] get final_note_pos})
                  ($len {- {end_of_song get end} $pos})
                  {if {>= $len 20}
                     {set [hide_at_end] TRUE}
                     {push_back [event_array] {eval_array ($pos {int {- $len 4}})}}
                  }
               }
            }
            {set [total_events] {max 0 {- {size [event_array]} 1}}}
            {game add_sink $this}
            {unless {== {gamemode get player_arrangement} kArrangeHth}
               {[player] add_sink $this}
            }
         )
         (set_lbl
            ($text)
            {[target] set_text {sprint $text}}
         )
         (downbeat
            {if {&& {== {mod {int {taskmgr beat}} 4} 0} {size [event_array]} {! [done]}}
               {if
                  {&&
                     {! [active]}
                     {>= {taskmgr beat} {elem {elem [event_array] [current_event]} 0}}
                  }
                  {if_else {&& [hide_at_end] {== [current_event] [total_events]}}
                     {set [done] TRUE}
                     {do
                        {set [remaining] {int {/ {elem {elem [event_array] [current_event]} 1} 4}}}
                        {set [active] TRUE}
                        {[anim] animate
                           (units kTaskBeats)
                           (period {* {- [remaining] 1} 4})
                           (range 0 1)
                        }
                        {if [alive]
                           {[parent] set_showing TRUE}
                        }
                     }
                  }
                  {if [alive]
                     {{[track] find retract.trig} trigger}
                     {if {[track] has (streak_meter)}
                        {{[track] get streak_meter} set_showing FALSE}
                     }
                     {if {[track] has (star_power_meter)}
                        {{[track] get star_power_meter} set_showing FALSE}
                     }
                  }
                  ; this could break things!!!
                  {if {!= {[player] instrument} vocals}
                     {[player] force_solo TRUE}
                  }
               }
               {if [active]
                  {-- [remaining]}
                  {if_else [remaining]
                     {$this set_lbl [remaining]}
                     {do
                        {$this set_lbl " "}
                        {[parent] set_showing FALSE}
                        {if {!= {[player] instrument} vocals}
                           {[player] force_solo FALSE}
                        }
                        {set [active] FALSE}
                        {if [alive]
                           {if {[track] has (streak_meter)}
                              {{[track] get streak_meter} set_showing TRUE}
                           }
                           {if {[track] has (star_power_meter)}
                              {{[track] get star_power_meter} set_showing TRUE}
                           }
                           {if_else {== {[player] instrument} vocals}
                              {{[track] find play_intro.trig} trigger}
                              {{[track] find intro.trig} trigger}
                           }
                        }
                        {if_else {== [current_event] [total_events]}
                           {set [done] TRUE}
                           {++ [current_event]}
                        }
                     }
                  }
               }
            }
         )
         (enable_player
            {set [alive] TRUE}
            {if [active]
               {thread_task kTaskSeconds
                  (delay 1)
                  (script
                     {if {&& [active] {> [remaining] 3}}
                        {[parent] set_showing TRUE}
                        {{[track] find retract.trig} trigger}
                        {if {[track] has (streak_meter)}
                           {{[track] get streak_meter} set_showing FALSE}
                        }
                        {if {[track] has (star_power_meter)}
                           {{[track] get star_power_meter} set_showing FALSE}
                        }
                     }
                  )
               }
            }
         )
         (disable_player
            {set [alive] FALSE}
            {[parent] set_showing FALSE}
         )
         (intro_start {$this reset})
         (game_outro {$this reset})
         (game_lost {$this reset})
         (game_won {$this reset})
         (reset
            {[parent] set_showing FALSE}
            {set [done] TRUE}
         )
      )
      (track_callback
         (init
            ($player)
            {set [player] $player}
            {[player] add_sink $this}
            {set [track] {get_dir_from_player $player}}
            {set [streak_meter]
               ; it's a symbol in the h2h vocals track for some reason
               {if_else {== {type {[track] get streak_meter}} kDataSymbol}
                  {[track] find {[track] get streak_meter}}
                  {[track] get streak_meter}
               }
            }
            {if $fcring
               {with [streak_meter]
                  {unless {exists fake.trig}
                     {{new EventTrigger show_ring.trig} copy star_deploy.trig 0}
                     {{new EventTrigger hide_ring.trig} copy star_deploy_stop.trig 0}

                     {new EventTrigger fake.trig}
                     {star_deploy.trig copy fake.trig 0}
                     {star_deploy_stop.trig copy fake.trig 0}
                  }
                  {show_ring.trig trigger}
               }
            }
         )
         (hit
            {++ [gems_hit]}
            {++ [gems_combo]}
            {if {&& {! {|| $legacybass {== {[player] instrument} bass}}} {> [gems_combo] 29} {! [groove_active]}}
               {set [groove_active] TRUE}
               {{[track] find BassSuperStreak_ON.trig} trigger}
            }
         )
         (miss
            {unless
               {||
                  {[player] current_streak}
                  {== {+ [gems_hit] [gems_pass]} 0}
               }
               {++ [gems_miss]}
               {set [gems_combo] 0}
               {$this on_miss}
            }
         )
         (pass
            {unless {[player] current_streak}
               {++ [gems_pass]}
               {set [gems_combo] 0}
               {$this on_miss}
            }
         )
         (phrase_rating
            ($rating)
            {if_else {== $rating 4}
               {do
                  {++ [gems_hit]}
                  {++ [gems_combo]}
               }
               {do
                  {++ [gems_miss]}
                  {set [gems_combo] 0}
                  {$this on_miss}
               }
            }
         )
         (on_miss
            {if $fcring
               {{[streak_meter] find hide_ring.trig} trigger}
            }
            {if [groove_active]
               {set [groove_active] FALSE}
               {{[track] find BassSuperStreak_OFF.trig} trigger}
            }
         )
         (gems_hit 0)
         (gems_combo 0)
         (gems_miss 0)
         (gems_pass 0)
         (groove_active FALSE)
         (player 0)
         (track 0)
         (streak_meter 0)
      )
      (permadeath_mgr
         (version 0)
         (num_lives [num_lives])
         (total_lives [total_lives])
         (note_streak [note_streak])
         (songs_completed [songs_completed])
         (won [won])
         (should_warn [should_warn])
         (init
            {set [num_lives] 0}
            {set [total_lives] 0}
            {set [note_streak] 0}
            {set [songs_completed] 0}
            {set [won] FALSE}
            {set [should_warn] FALSE}
         )
         (load_data {do
            ($motto {char_data get_motto})
            ($array {array 0})
            ($version)
            ($str)
            {foreach_int $elem 0 {strlen $motto} {do
               ($char {str_elem $motto $elem})
               {if_else {== $char " "}
                  {do
                     {push_back $array $str}
                     {set $str 0}
                  }
                  {set $str
                     {if_else $str
                        {sprint $str $char}
                        $char
                     }
                  }
               }
            }}
            {push_back $array $str}

            {set $version          {siti {elem $array 1}}}
            {set [num_lives]       {siti {elem $array 2}}}
            {set [total_lives]     {siti {elem $array 3}}}
            {set [note_streak]     {siti {elem $array 4}}}
            {set [songs_completed] {siti {elem $array 5}}}
            {set [won]             {siti {elem $array 6}}}

            {print
               {sprint
                  "\n"
                  "         (version " $version ")\n"
                  "         (num_lives " [num_lives] ")\n"
                  "         (total_lives " [total_lives] ")\n"
                  "         (note_streak " [note_streak] ")\n"
                  "         (songs_completed " [songs_completed] ")\n"
                  "         (won " [won] ")"
                  "\n"
               }
            }
         })
         (save_data {do
            ($motto
               {sprint
                  "uwurawrxd"
                  " "
                  [version]
                  " "
                  [num_lives]
                  " "
                  [total_lives]
                  " "
                  [note_streak]
                  " "
                  [songs_completed]
                  " "
                  [won]
               }
            )
            {unless {== $motto {char_data get_motto}}
               {char_data set_motto $motto}
               {print {char_data get_motto}}
            }
         })
         (remove_life
            {-- [num_lives]}
            {set [note_streak] 0}
            {$this save_data}
         )
         (add_event
            ($streak)
            {++ [songs_completed]}
            {+= [note_streak] $streak}
            {$this save_data}
         )
         (reset_char {char_data set_motto ""})
         (is_char_perma
            ($char)
            {char_data set_char $char}
            {startswith {char_data get_motto} "uwurawrxd"}
         )
      )
      (perma_callback
         (init
            ($player)
            {set [player] $player}
            {[player] add_sink $this}
            {game add_sink $this game_lost}
         )
         (hit {++ [gems_hit]})
         (miss
            {unless {|| {[player] current_streak} {== [gems_hit] 0}}
               {$this on_miss}
            }
         )
         (pass
            {unless {[player] current_streak}
               {$this on_miss}
            }
         )
         (phrase_rating
            ($rating)
            {if_else {== $rating 4}
               {++ [gems_hit]}
               {$this on_miss}
            }
         )
         (game_lost {$this on_miss})
         (on_miss
            {unless [exiting] ; makes u not lose 2/3 lives when missing on drums
               {set [exiting] TRUE}
               {permadeath_mgr remove_life}
               {permadeath_mgr save_data}
               {permadeath_mgr set should_warn TRUE}
               {if_else {permadeath_mgr num_lives}
                  {do
                     {session end_game kQuit}
                     {band_ui_sink sync_screen meta_loading_pause_new_song_screen 1}
                  }
                  {do
                     {permadeath_mgr reset_char}
                     {overshell_perma_lost set name {char_data get_char_name}}
                     {overshell_perma_lost set player_num {game get leader_num}}
                     {ui goto_screen meta_loading_quit_early_screen}
                  }
               }
            }
         )
         (gems_hit 0)
         (player 0)
         (exiting FALSE)
      )
      #include track/asset_mgr.dta
      #include mod_overlay.dta
   )
)
