#ifdef HX_PS3
   #define MOD_SETTINGS_PATH ("GD:/dev_hdd0/game/BLUS30050/USRDIR/mod_settings.milo")
   #define PRESETS_PATH ("GD:/dev_hdd0/game/BLUS30050/USRDIR/user_presets.milo")
#else
   #define MOD_SETTINGS_PATH ("GAME:/mod_settings.milo")
   #define PRESETS_PATH ("GAME:/user_presets.milo")
#endif
{new ObjectDir
   mod_settings_rw
   (vars (
      skipintro
      guitar_trackspeed
      bass_trackspeed
      drum_trackspeed
      track0_trackspeed
      track1_trackspeed
      guitar_hwlength
      bass_hwlength
      drum_hwlength
      track0_hwlength
      track1_hwlength
      scrbloom
      camerashake
      fxdof
      scrnoise
      emulatefps
      vsyncrate
      trkmuting
      whammypb
      misssounds
      fcring
      countdown
      songtimer
      kickbounce
      pad_inst
      pad_map
      syncdifspeeds
      songtitle
      legacybass
      blackbg
      tiltsensor
      prodrums
      cnt_slot1
      cnt_slot2
      cnt_slot3
      cnt_slot4
      cnt_slot5
      cnt_star
      track_config
      selectvenue
      nohud
      micdeploy
      goldprogress
      normal_venues
      rb2_venues
      custom_venues
      char_list
      crowd
      force_per_pixel
      force_vg
      fast_selsong
      videobgs
   ))
   (save_settings
      {print "attempting to save mod settings"}
      {new ObjectDir mod_settings}
      {foreach $s [vars]
         {mod_settings set $s {eval_var $s}}
      }

      {do
         ($array {array 0})
         {foreach_int $i 0 4
            {push_back $array
               {eval_array
                  (
                     {{profile_mgr get_char_options_from_player $i} get_mic_gain}
                     {{profile_mgr get_char_options_from_player $i} get_vocal_volume}
                  )
               }
            }
         }
         {mod_settings set mic_volumes $array}
      }
      {mod_settings set config {asset_mgr config}}
      
      {mod_settings save_objects MOD_SETTINGS_PATH}
      {delete mod_settings}
      {print "mod settings saved to milo"}
   )
   (load_settings
      {print "attempting to load mod_settings"}
      {do
         ($mod_settings {load_objects MOD_SETTINGS_PATH})
         {if_else $mod_settings
            {do
               {$mod_settings delete_loader}
               {foreach $s [vars]
                  {if {$mod_settings has ($s)}
                     {set_var $s {$mod_settings get $s}}
                  }
               }

               {if {$mod_settings has (mic_volumes)} {do
                  ($array {$mod_settings get mic_volumes})
                  {foreach_int $i 0 4
                     {{profile_mgr get_char_options_from_player $i} set_mic_gain {elem {elem $array $i} 0}}
                     {{profile_mgr get_char_options_from_player $i} set_vocal_volume {elem {elem $array $i} 1}}
                  }
               }}

               {if {$mod_settings has (config)}
                  {asset_mgr set config {$mod_settings get config}}
               }

               {delete $mod_settings}
               {print "mod settings loaded"}
            }
            {print "mod settings not loaded"}
         }
      }
   )
   (save_prefabs
      {print "attempting to save user prefabs"}
      {new ObjectDir user_prefabs}
      {user_prefabs set user_prefabs $user_prefabs}
      {user_prefabs save_objects PREFABS_PATH}
      {delete user_prefabs}
      {print "user prefabs saved to milo"}
   )
   (load_presets
      {print "attempting to load user presets"}
      {do
         ($presets {load_objects PRESETS_PATH})
         {if_else $presets
            {do
               {$presets delete_loader}
               {if {$presets has (user_presets)}
                  {set $user_presets {$presets get user_presets}}
               }
               {delete $presets}
               {print "user presets loaded"}
            }
            {print "user presets not loaded"}
         }
      }
   )
   (save_presets
      {print "attempting to save user presets"}
      {new ObjectDir user_presets}
      {user_presets set user_presets $user_presets}
      {user_presets save_objects PRESETS_PATH}
      {delete user_presets}
      {print "user presets saved to milo"}
   )
}
{mod_settings_rw load_settings}
{mod_settings_rw load_presets}