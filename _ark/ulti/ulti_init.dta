{set $patched TRUE}
{set $skipintro TRUE}

;sets default track speed. 1.15 is 115%, 1.30 is 130% and so on.
{set $guitar_trackspeed 1.00}

{set $bass_trackspeed 1.00}

{set $drum_trackspeed 1.00}

{set $track0_trackspeed 1.00}

{set $track1_trackspeed 1.00}

;sets default song speed 1.15 is 115%, 1.30 is 130% and so on.
{set $speedmod 1.00}

;default highway length
{set $guitar_hwlength 1.00}

{set $bass_hwlength 1.00}

{set $drum_hwlength 1.00}

{set $track0_hwlength 1.00}

{set $track1_hwlength 1.00}

;bloom
{set $scrbloom TRUE}

;camera shake
{set $camerashake TRUE}

;depth of field
{set $fxdof TRUE}

;film grain
{set $scrnoise TRUE}

;motion blur
{set $mbblend TRUE}

{set $crowd TRUE}

{set $force_per_pixel TRUE}

{set $emulatefps 24}

{set $vsyncrate 1}

{set $trkmuting TRUE}

{set $whammypb TRUE}

{set $misssounds TRUE}

{set $fcring TRUE}

{set $countdown TRUE}

{set $songtimer 2}

{set $kickbounce FALSE}

{set $pad_inst kControllerVocals}

{set $pad_map 0}

{set $video_bgs TRUE}

{set $syncdifspeeds FALSE}

{set $indvtrkspeeds TRUE}

{set $songtitle FALSE}

{set $legacybass FALSE}

{set $colorshuffle FALSE}

{set $blackbg FALSE}

{set $tiltsensor TRUE}

{set $prodrums FALSE}

{set $micdeploy TRUE}

{set $goldprogress TRUE}

{set $normal_venues TRUE}

{set $rb2_venues TRUE}

{set $custom_venues TRUE}

{set $char_list {array 0}}

{set $fast_selsong TRUE}

{set $videobgs TRUE}

{set $track_config rb1}

{set $sync_online TRUE}

{set $user_presets {array 0}}

{set $smallworld FALSE}

{set $bigmode FALSE}

{set $honestmode FALSE}

{set $hidechars FALSE}

{set $forceband none}

{set $flashbang FALSE}

{set $scale_head FALSE}

{set $force_venue off}

{set $force_vg off}

#ifdef HX_WII
{set $cnt_slot1 kPad_Tri}
{set $cnt_slot2 kPad_DRight}
{set $cnt_slot3 kPad_X}
{set $cnt_slot4 kPad_Square}
{set $cnt_slot5 kPad_Circle}
{set $cnt_star kPad_DLeft}
#else
{set $cnt_slot1 kPad_L2}
{set $cnt_slot2 kPad_L1}
{set $cnt_slot3 kPad_R1}
{set $cnt_slot4 kPad_R2}
{set $cnt_slot5 kPad_X}
{set $cnt_star kPad_Select}
#endif