{new UIPanel overshell
   (file overshell.milo)
   (focus OS_LIST)
   (up [up])
   (state main)
   (focused FALSE)
   (states (#include overshell_states.dta))
   (enter
      {set [state] main}
      {set [focused] FALSE}
      {$this eval_all enter}
   )
   (BUTTON_DOWN_MSG
      {if {== {$this eval_all button_down} kDataUnhandled}
         {switch $button
            (kPad_X
               {synth play button_select}
               {$this component_select OS_LIST $player_num}
            )
            (kPad_DUp
               {OS_LIST scroll -1}
               {OS_LIST poll}
               {$this component_scroll OS_LIST $player_num}
            )
            (kPad_DDown
               {OS_LIST scroll 1}
               {OS_LIST poll}
               {$this component_scroll OS_LIST $player_num}
            )
         }
      }
   )
   (SELECT_MSG
      {$this eval_all component_select}
   )
   (SCROLL_MSG
      {$this update_helpbar}
      {$this state_set pos
         {eval_array ({OS_LIST selected_pos} {OS_LIST first_showing})}
      }
   )
   (VIRTUAL_KEYBOARD_RESULT_MSG {$this eval_all virtual_keyboard_result_msg})
   (set_up
      ($b)
      {set [up] $b}
      {{$this loaded_dir} set_showing [up]}
      {{helpbar_overshell loaded_dir} set_showing [up]}
      {{overshell_lower3rd_panel loaded_dir} set_showing [up]}
      {helpbar set_showing {! [up]}}
      {{helpbar_dialog find all.grp} set_showing {! [up]}}
      {if_else [up]
         {do
            {$this enter}
            {helpbar_overshell enter}
            {overshell_lower3rd_panel enter}
         }
         {$this eval_all exit}
      }
   )
   (state_find
      ($s)
      {find_exists [states] [state] $s}
   )
   (state_get
      ($s) {do
      ($a {$this state_find $s})
      {if_else $a
         {elem $a 1}
         kDataUnhandled
      }
   })
   (state_set
      ($s $n) {do
      ($a {$this state_find $s})
      {if_else $a
         {set_elem $a 1 $n}
         {push_back {find [states] [state]}
            {` ({, $s} {, $n})}
         }
      }
      ;{print {sprint "state set " $s}}
      ;{print {find_exists [states] [state] $s}}
   })
   (state_has
      ($s) {do
      ($a {$this state_find $s})
      {if_else $a TRUE FALSE}
   })
   (state_remove
      ($s) {do
      ($a {$this state_find $s})
      {if $a
         {remove_elem {find [states] [state]} $a}
      }
   })
   (state_handle
      ($s $ar) {do
      ($r kDataUnhandled)
      ($a {$this state_find $s})
      {if $a
         {if_else {== {type {elem $a 1}} kDataArray}
            {do ; this is very hacky! i am proud of it though.
               ($cmd {` {do}})
               {foreach_int $i 0 {size {elem $a 1}} 
                  {push_back $cmd
                     {`
                        (
                           {, {elem {elem $a 1} $i}} 
                           {, {elem $ar $i}} 
                        )
                     }
                  }
               }
               {push_back $cmd {` {$this eval_all $s}}}
               {set $r {eval $cmd}}
            }
            {set $r {$this eval_all $s}}
         }
      }
      $r
   })
   (eval_all
      ($s) {do
      ($r kDataUnhandled)
      ($a {$this state_find $s})
      {if {&& $a {> {size $a} 1}}
         {foreach $c $a
            ;{print $c}
            {set $r {eval $c}}
         }
      }
      $r
   })
   (update_state
      ($s)
      {$this eval_all exit}
      {$this state_remove color}

      {set [state] $s}

      {unless {find_exists [states] [state]}
         {fail {sprint [state] " is not a valid state!"}}
      }

      {unless {$this state_has pos}
         {$this state_set pos {array 2}}
      }

      {$this eval_all enter}
   )
   (lst_reset {do
      ($array {array 0})
      {foreach $entry {$this state_get data}
         {if_else {== {type $entry} kDataArray} ; just return whatever was passed if not array
            {switch {elem {find $entry type} 1}
               (uNormal
                  {push_back $array {eval {elem $entry 0}}}
               )
               (uOnOFF
                  {push_back $array
                     {sprintf
                        {localize os_onoff_fmt}
                        {localize_token {elem $entry 0}}
                        {localize {if_else {eval {elem {find $entry bool} 1}} on off}}
                     }
                  }
               )
               ((uSld uFakeSld uColorSld)
                  {push_back $array
                     {do
                        ($type {elem {find $entry type} 1})
                        ($selected {== {- {size $array} 1} {OS_LIST selected_pos}})
                        ($fmt_type {elem {find $entry fmt_type} 1})
                        ($hide_on_sel
                           {if_else {find_exists $entry hide_on_sel}
                              {elem {find $entry hide_on_sel} 1}
                              FALSE
                           }
                        )
                        ($data
                           {cond
                              ({find_exists $entry var}
                                 {eval_var {elem {find $entry var} 1}}
                              )
                              ({find_exists $entry get}
                                 {eval {elem {find $entry get} 1}}
                              )
                              (TRUE {fail "unable to find data for sld"})
                           }
                        )
                        ($fmt
                           {switch $fmt_type
                              (uNormal $data)
                              (uColor
                                 {localize
                                    {switch $data
                                       (0 color_green)
                                       (1 color_red)
                                       (2 color_yellow)
                                       (3 color_blue)
                                       (4 color_orange)
                                       invalid
                                    }
                                 }
                              )
                              (uDrumColor
                                 {localize
                                    {switch $data
                                       (0 kick)
                                       (1 color_red)
                                       (2 color_yellow)
                                       (3 color_blue)
                                       (4 color_green)
                                       invalid
                                    }
                                 }
                              )
                              (uCunt
                                 {localize
                                    {switch $data
                                       (kPad_L2 os_pad_l2)
                                       (kPad_L1 os_pad_l1)
                                       (kPad_R1 os_pad_r1)
                                       (kPad_R2 os_pad_r2)
                                       (kPad_X os_pad_x)
                                       (kPad_Circle os_pad_circle)
                                       (kPad_Square os_pad_square)
                                       (kPad_Tri os_pad_tri)
                                       (kPad_DUp os_pad_dup)
                                       (kPad_DDown os_pad_ddown)
                                       (kPad_DLeft os_pad_dleft)
                                       (kPad_DRight os_pad_dright)
                                       (kPad_L3 os_pad_l3)
                                       (kPad_R3 os_pad_r3)
                                       (kPad_Select os_pad_select)
                                       invalid
                                    }
                                 }
                              )
                              (uSync
                                 {localize
                                    {switch $data
                                       (0 infinite)
                                       (1 full)
                                       (2 half)
                                       (4 quarter)
                                       invalid
                                    }
                                 }
                              )
                              (uInst
                                 {localize
                                    {switch $data
                                       (kControllerGuitar guitar_sym)
                                       (kControllerDrum drum_sym)
                                       (kControllerVocals vocals_sym)
                                       invalid
                                    }
                                 }
                              )
                              (uMapping
                                 {localize
                                    {switch $data
                                       (0 custom)
                                       (1 guitar_sym)
                                       (2 gh_guitar)
                                       (3 ps2_guitar)
                                       (4 drum_sym)
                                       invalid
                                    }
                                 }
                              )
                              (uSpeed {int {+ {* $data 100} 0.5}})
                              (uTimer
                                 {localize
                                    {switch $data
                                       (0 off)
                                       (1 time_total)
                                       (2 remaining_total)
                                       (3 remaining)
                                       (4 time)
                                       (5 total)
                                       invalid
                                    }
                                 }
                              )
                              (uLocalize {localize $data})
                              (uColorRGB
                                 {do
                                    ($r) ($g) ($b)
                                    ($i
                                       {if_else {OS_LIST has (color_index)}
                                          {OS_LIST get color_index}
                                          0
                                       }
                                    )
                                    {if $selected
                                       {color.mat set color $data}
                                    }
                                    {unpack_color $data $r $g $b}
                                    {sprintf {localize_token {sprintf "os_color_fmt_%d" $i}} $r $g $b}
                                 }
                              )
                              (uAspect
                                 {localize
                                    {switch $data
                                       (kSquareAspect aspect_square)
                                       (kRegularAspect apsect_regular)
                                       (kWidescreenAspect aspect_widescreen)
                                       invalid
                                    }
                                 }
                              )
                           }
                        )
                        {cond
                           ({&& {== $type uColorSld} $selected [focused]} $fmt)
                           ({== $type uColorSld} {localize {elem $entry 0}})
                           ({&& $hide_on_sel $selected [focused]}
                              {sprint {localize os_l} $fmt {localize os_r}}
                           )
                           ($hide_on_sel {localize {elem $entry 0}})
                           (TRUE {sprintf {localize {elem $entry 0}} $fmt})
                        }
                     }
                  }
               )
               {fail {sprint {elem {find $entry type} 1} " is an unknown type"}}
            }
            {push_back $array {eval $entry}}
         }
      }
      {OS_LIST set_data $array}
      {if {$this state_has pos}
         {OS_LIST set_selected {elem {$this state_get pos} 0} {elem {$this state_get pos} 1}}
         {if [focused]
            {foreach $entry $array
               {if {!= $entry {elem $array {elem {$this state_get pos} 0}}}
                  {OS_LIST disable_data {symbol $entry}}
               }
            }
         }
      }
      {OS_LIST poll}
      {$this update_helpbar}
   })
   (setup_common
      {title.lbl set text_token {$this state_get title}}
      {$this lst_reset}
   )
   (sel_common {do
      ($entry {elem {$this state_get data} {OS_LIST selected_pos}})
      {if_else
         {&&
            {== {type $entry} kDataArray}
            {!
               {do
                  ($block {find_exists $entry block_ingame})
                  ($bool)
                  {if {&& $block {exists beatmatch}}
                     {set $bool {elem $block 1}}
                  }
                  $bool
               }
            }
         }
         {do
            {switch {elem {find $entry type} 1}
               ((uNormal uOnOFF)
                  {foreach $cmd {find $entry sel_script}
                     {eval $cmd}
                  }
               )
               ((uSld uFakeSld uColorSld)
                  {set [focused] TRUE}
                  {OS_LIST set store
                     {cond
                        ({find_exists $entry var}
                           {eval_var {elem {find $entry var} 1}}
                        )
                        ({find_exists $entry get}
                           {eval {elem {find $entry get} 1}}
                        )
                        (TRUE {fail "unable to find data for sld"})
                     }
                  }
                  {if {== {elem {find $entry type} 1} uColorSld}
                     {OS_LIST set color_index 0}
                     {color.mesh set_showing TRUE}
                     {color.tnm set_frame
                        {- {OS_LIST selected_pos} {OS_LIST first_showing}}
                     }
                  }
               )
            }
         }
         {synth play button_error}
      }}
      {$this lst_reset}
   )
   (down_common {do
      ($entry {elem {$this state_get data} {OS_LIST selected_pos}})
      {if_else {== {type $entry} kDataArray}
         {switch {elem {find $entry type} 1}
            ((uSld uFakeSld uColorSld)
               {if_else [focused]
                  {switch $button
                     (kPad_X
                        {synth play button_select}
                        {set [focused] FALSE}
                        {OS_LIST set store 0}
                        {color.mesh set_showing FALSE}
                        {$this update_helpbar}
                        {$this lst_reset}
                     )
                     (kPad_Tri
                        {synth play button_back}
                        {set [focused] FALSE}
                        {cond
                           ({find_exists $entry var}
                              {set_var {elem {find $entry var} 1} {OS_LIST get store}}
                           )
                           ({find_exists $entry get} {do
                              ($r {OS_LIST get store})
                              {eval {elem {find $entry set} 1}}
                           })
                           (TRUE {fail "unable to find data for sld"})
                        }
                        {OS_LIST set store 0}
                        {color.mesh set_showing FALSE}
                        {$this lst_reset}
                     )
                     (kPad_R1
                        {if {== {elem {find $entry type} 1} uColorSld}
                           {synth play button_back}
                           {OS_LIST set color_index
                              {switch {OS_LIST get color_index}
                                 (0 1)
                                 (1 2)
                                 (2 0)
                              }
                           }
                           {$this lst_reset}
                        }
                     )
                     ((kPad_DUp kPad_DLeft) {do
                        ($data '')
                        ($type '')
                        ($r)
                        {synth play button_toggle}
                        {cond
                           ({find_exists $entry var}
                              {set $data {eval_var {elem {find $entry var} 1}}}
                              {set $type var}
                           )
                           ({find_exists $entry get}
                              {set $data {eval {elem {find $entry get} 1}}}
                              {set $type get}
                           )
                           (TRUE {fail "unable to find data for sld"})
                        }
                        {set $r
                           {switch {elem {find $entry type} 1}
                              (uSld
                                 {clamp
                                    {- $data {elem {find $entry step} 1}}
                                    {elem {find $entry range} 1}
                                    {elem {find $entry range} 2}
                                 }
                              )
                              (uFakeSld
                                 {prev_elem
                                    {eval {elem {find $entry array} 1}}
                                    $data
                                 }
                              )
                              (uColorSld
                                 {do
                                    ($r) ($g) ($b)
                                    {unpack_color $data $r $g $b}
                                    {set_var {elem (r g b) {OS_LIST get color_index}}
                                       {clamp {- {eval_var {elem (r g b) {OS_LIST get color_index}}} 0.01} 0.00 1.00}
                                    }
                                    {pack_color $r $g $b}
                                 }
                              )
                           }
                        }
                        {switch $type
                           (var {set_var {elem {find $entry var} 1} $r})
                           (get {eval {elem {find $entry set} 1}})
                        }
                        {$this lst_reset}
                     })
                     ((kPad_DDown kPad_DRight) {do
                        ($data '')
                        ($type '')
                        ($r)
                        {synth play button_toggle}
                        {cond
                           ({find_exists $entry var}
                              {set $data {eval_var {elem {find $entry var} 1}}}
                              {set $type var}
                           )
                           ({find_exists $entry get}
                              {set $data {eval {elem {find $entry get} 1}}}
                              {set $type get}
                           )
                           (TRUE {fail "unable to find data for sld"})
                        }
                        {set $r
                           {switch {elem {find $entry type} 1}
                              (uSld
                                 {clamp
                                    {+ $data {elem {find $entry step} 1}}
                                    {elem {find $entry range} 1}
                                    {elem {find $entry range} 2}
                                 }
                              )
                              (uFakeSld
                                 {next_elem
                                    {eval {elem {find $entry array} 1}}
                                    $data
                                 }
                              )
                              (uColorSld
                                 {do
                                    ($r) ($g) ($b)
                                    {unpack_color $data $r $g $b}
                                    {set_var {elem (r g b) {OS_LIST get color_index}}
                                       {clamp {+ {eval_var {elem (r g b) {OS_LIST get color_index}}} 0.01} 0.00 1.00}
                                    }
                                    {pack_color $r $g $b}
                                 }
                              )
                           }
                        }
                        {switch $type
                           (var {set_var {elem {find $entry var} 1} $r})
                           (get {eval {elem {find $entry set} 1}})
                        }
                        {$this lst_reset}
                     })
                  }
                  {switch {elem {find $entry type} 1}
                     (uColorSld
                        {switch $button
                           (kPad_R1
                              {if_else {$this state_has color}
                                 {do
                                    {cond
                                       ({find_exists $entry var}
                                          {set_var {elem {find $entry var} 1} {$this state_get color}}
                                       )
                                       ({find_exists $entry get} {do
                                          ($r {$this state_get color})
                                          {eval {elem {find $entry set} 1}}
                                       })
                                       (TRUE {fail "unable to find data for color"})
                                    }
                                    {$this state_remove color}
                                 }
                                 {do
                                    ($data
                                       {cond
                                          ({find_exists $entry var}
                                             {eval_var {elem {find $entry var} 1}}
                                          )
                                          ({find_exists $entry get}
                                             {eval {elem {find $entry get} 1}}
                                          )
                                          (TRUE {fail "unable to find data for color"})
                                       }
                                    )
                                    {$this state_set color $data}
                                 }
                              }
                              {$this update_helpbar}
                           )
                           {$this unhandled_down}
                        }
                     )
                     {$this unhandled_down}
                  }
               }
            )
            {$this unhandled_down}
         }
         {$this unhandled_down}
      }}
   )
   (unhandled_down
      {if_else {== $button kPad_Tri}
         {do
            ($s {$this state_get back})
            {if $s
               {synth play button_back}
               {$this state_remove pos}
               {$this update_state $s}
            }
         }
         kDataUnhandled
      }
   )
   (update_helpbar {do
      ($entry {elem {$this state_get data} {OS_LIST selected_pos}})
      ($type
         {if_else {== {type $entry} kDataArray}
            {elem {find $entry type} 1}
            kDataUnhandled
         }
      )
      {helpbar_overshell set_config
         {if_else {== {type $entry} kDataArray}
            {cond
               ({&& {== $type uColorSld} [focused]}
                  (
                     helpbar_cancel
                     helpbar_confirmsetting
                     os_nextcolor
                  )
               )
               ({&& {== $type uColorSld} {$this state_has color}}
                  (
                     helpbar_back
                     os_changecolor
                     os_paste
                  )
               )
               ({== $type uColorSld}
                  (
                     helpbar_back
                     os_changecolor
                     os_copy
                  )
               )
               ([focused]
                  (
                     helpbar_cancel
                     helpbar_confirmsetting
                  )
               )
               ({find_elem (uOnOFF uSld uFakeSld) $type}
                  (
                     helpbar_back
                     helpbar_changesetting
                  )
               )
               (TRUE
                  (
                     helpbar_back
                     helpbar_select
                  )
               )
            }
            (
               helpbar_back
               helpbar_select
            )
         }
      }
   })
}
{new UIPanel helpbar_overshell HELPBAR_HANDLERS (limit_to_session TRUE)}
{new UIPanel overshell_lower3rd_panel (file "../../ui/practice_lower3rd.milo")}
{overshell load TRUE}
{helpbar_overshell load TRUE}
{overshell_lower3rd_panel load TRUE}
{overshell set_up FALSE}
