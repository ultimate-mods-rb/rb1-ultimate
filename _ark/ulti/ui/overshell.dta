{new UIPanel
   overshell_trk_panel
   OVERSHELL_LIST_FILE
   (title os_trk)
   (data (
      (os_reset
         (type uNormal)
         (block_ingame TRUE)
         (sel_script {run ulti/ulti_init_apperance.dta})
      )
      (os_gems
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (var gems)
         (array
            {if_else $notergb
               {asset_mgr all_gems_rgb}
               {asset_mgr all_gems}
            }
         )
      )
      (os_smashers
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (var smashers)
         (array
            {if_else $notergb
               {asset_mgr all_smashers_rgb}
               {asset_mgr all_smashers}
            }
         )
      )
      (os_colors
         (type uNormal)
         (sel_script
            {if_else $notergb
               {pop_and_goto_screen overshell_rgb_colors_screen}
               {pop_and_goto_screen overshell_colors_screen}
            }
         )
      )
      (os_notergb
         (type uOnOFF)
         (bool $notergb)
         (block_ingame TRUE)
         (sel_script
            {toggle_var notergb}
            {asset_mgr ensure_stuff}
         )
      )
      (os_track_config
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (var track_config)
         (array {asset_mgr track_configs})
      )
   ))
   (enter
      {asset_mgr ensure_stuff}
      {os_setup_common}
   )
   (BUTTON_DOWN_MSG {os_down_common})
   (SELECT_MSG {os_sel_common})
}
{new UIScreen
   overshell_trk_screen
   (exit
      {if {&& $notergb {exists beatmatch}}
         {asset_mgr apply_all_rgb}
      }
   )
   (back overshell_main_screen)
   (panels overshell_trk_panel practice_lower3rd_panel helpbar)
   (focus overshell_trk_panel)
}
