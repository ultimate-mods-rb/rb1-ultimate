   (title os_spd)
   (data (
      (os_trackspeed
         (type uNormal)
         (sel_script {pop_and_goto_screen overshell_trackspeed_screen})
      )
      (hwlength_msg
         (type uSld)
         (fmt_type uSpeed)
         (var hwlength)
         (step 0.05)
         (range 0.50 2.50)
      )
      (speed_msg
         (type uSld)
         (fmt_type uSpeed)
         (var speedmod)
         (block_ingame TRUE)
         (step 0.05)
         (range 1.00 2.50)
      )
   ))
   (enter {os_setup_common})
   (BUTTON_DOWN_MSG {os_down_common})
