{new UIPanel
   overshell_char_list_panel
   OVERSHELL_LIST_FILE
   (title os_guitar_chars)
   (filter guitar)
   (data    ())
   (prefabs ())
   (normal  ())
   (custom  ())
   (enter
      {do
         ($a
            {` 
               (
                  (os_reset
                     (type uNormal)
                     (sel_script {$this reset})
                  )
                  (os_clear_normal
                     (type uNormal)
                     (sel_script {$this clear [normal]})
                  )
                  (os_clear_custom
                     (type uNormal)
                     (sel_script {$this clear [custom]})
                  )
               )
            }
         )
         {foreach $prefab {find $syscfg characters prefab}
            {if {== {type $prefab} kDataArray} {do
               ($data {elem {find $prefab instrument} 1})
               {if {&& $data {== {type $data} kDataCommand}} {do
                  ($custom {eval {elem $data 1}})
                  ($inst   {eval {elem $data 2}})
                  ($name   {eval {elem $data 3}})
                  {if {== $inst [filter]}
                     {push_back [prefabs] $name}
                     {if_else $custom
                        {push_back [custom] $name}
                        {push_back [normal] $name}
                     }
                     {push_back $a
                        {`
                           ({, $name}
                              (type uOnOFF)
                              (bool {$this in_list {, $name}})
                              (sel_script {$this change_state {, $name}})
                           )
                        }
                     }
                  }
               }}
            }}
         }
         {set [data] $a}
      }
      {os_setup_common}
   )
   (exit
      {set [data] {array 0}}
      {set [prefabs] {array 0}}
      {set [normal] {array 0}}
      {set [custom] {array 0}}
   )
   (reset
      {foreach $prefab [prefabs]
         {if {find_elem $char_list $prefab}
            {remove_elem $char_list $prefab}
         }
      }
   )
   (clear
      ($a)
      {foreach $prefab $a
         {unless {find_elem $char_list $prefab}
            {push_back $char_list $prefab}
         }
      }
   )
   (in_list
      ($name)
      {! {find_elem $char_list $name}}
   )
   (change_state
      ($name)
      {if_else {find_elem $char_list $name}
         {remove_elem $char_list $name}
         {push_back $char_list $name}
      }
   )
   (warn
      ($msg $can_leave)
      {overshell_warn_screen set msg $msg}
      {overshell_warn_screen set can_leave $can_leave}
      {ui push_screen overshell_warn_screen}
   )
   (BUTTON_DOWN_MSG
      {if_else {!= $button kPad_Tri}
         {os_down_common}
         {if_else {== {os_down_common} kDataUnhandled}
            {do
               ($active 0)
               ($any_male FALSE)
               ($any_female FALSE)
               {foreach $prefab [prefabs]
                  {unless {find_elem $char_list $prefab}
                     {++ $active}
                     {switch {elem {find $syscfg characters prefab $prefab gender} 1}
                        (male {set $any_male TRUE})
                        (female {set $any_female TRUE})
                     }
                  }
               }
               {cond
                  ({== $active 0} {$this warn os_no_active TRUE})
                  ({== [filter] vocals}
                     {cond
                        ({&& $any_male {! $any_female}}
                           {$this warn os_no_female_vocals TRUE}
                        )
                        ({&& $any_female {! $any_male}}
                           {$this warn os_no_male_vocals TRUE}
                        )
                        (TRUE kDataUnhandled)
                     }
                  )
                  ({== $active 1}
                     {$this warn os_crash_potential FALSE}
                  )
                  (TRUE kDataUnhandled)
               }
            }
            FALSE
         }
      }
   )
   (SELECT_MSG {os_sel_common})
}
{new UIScreen
   overshell_char_list_screen
   (back overshell_chars_screen)
   (panels overshell_char_list_panel practice_lower3rd_panel helpbar)
   (focus overshell_char_list_panel)
}
{new UIScreen
   overshell_warn_screen
   (panels dialog_panel)
   (focus dialog_panel)
   (destination '')
   (msg meow)
   (can_leave TRUE)
   (enter
      {if_else [can_leave]
         {dialog_panel set_ok {localize_token [msg]}}
         {dialog_panel set_yesno
            {localize_token [msg]}
            no.btn
         }
      }
   )
   (SELECT_START_MSG
      {ui pop_screen}
      {if {== $component yes.btn}
         {thread_task kTaskUISeconds
            (delay 0.01)
            (script {pop_and_goto_screen overshell_chars_screen})
         }
      }
      kDataUnhandled
   )
}
{new UIPanel
   overshell_del_prefab_panel
   OVERSHELL_LIST_FILE
   (title os_del_prefab)
   (data)
   (update_data
      {do
         ($a
            {` 
               (
                  (os_clear_all
                     (type uNormal)
                     (sel_script
                        {resize $user_prefabs 0}
                        {$this update_data}
                     )
                  )
               )
            }
         )
         {foreach $prefab $user_prefabs
            {push_back $a {elem $prefab 0}}
         }
         {set [data] $a}
      }
   )
   (enter
      {$this update_data}
      {os_setup_common}
      {overshell_ok_msg show p_reboot_warning}
   )
   (exit
      {mod_settings_rw save_prefabs}
      {set [data] {array 0}}
   )
   (SELECT_MSG
      {if_else {OS_LIST selected_pos}
         {if {find_exists $user_prefabs {OS_LIST selected_sym}}
            {foreach_int $i 0 {size $user_prefabs}
               {if {== {elem {elem $user_prefabs $i} 0} {OS_LIST selected_sym}}
                  {remove_elem $user_prefabs {elem $user_prefabs $i}}
               }
            }
            {$this update_data}
            {set [pos] (0 0)}
            {lst_reset}
         }
         {os_sel_common}
      }
   )
}
{new UIScreen
   overshell_del_prefab_screen
   (back overshell_ven_screen)
   (panels overshell_del_prefab_panel practice_lower3rd_panel helpbar)
   (focus overshell_del_prefab_panel)
}