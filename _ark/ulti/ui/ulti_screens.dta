#include overshell.dta
#include autoplay.dta
{new UIPanel
   main_bandtour_panel
   (file "../../ui/main_bandcoop.milo")
   (focus local.btn)
   (enter
      {if {profile_mgr get_all_unlocked}
         {if {== kFocused {online.btn get_state}}
            {$this set_focus local.btn}
         }
         {online.btn set_state kDisabled}
      }
   )
   (load
      {main_panel set mode_focus multi.btn}
      {main_multimode_panel set mode_focus bandtour.btn}
   )
   (SELECT_START_MSG
      {gamemode set_mode
         {switch $component
            (local.btn tour_world_local)
            (online.btn tour_world_online)
         }
         $player_num
      }
      {goto_after_network_connect
         tour_band_sel_screen
         {! {gamemode get local_network}}
      }
      kDataUnhandled
   )
}
{new UIScreen
   main_bandtour_screen
   (panels
      meta
      movie_panel
      main_lower3rd_panel
      main_panel
      main_bandtour_panel
      fx
   )
   (focus main_bandtour_panel)
   (back main_multimode_screen)
   MAIN_SCREEN_TRANSITION_HANDLER
   (enter {char_cache cache_update})
}
{new UIPanel
   bonus_panel
   (file "../../ui/options.milo")
   (focus audio.btn)
   (SELECT_START_MSG
      {switch $component
         (audio.btn
            {unless {overshell up}
               {overshell set_up TRUE}
            }
         )
         (gameplay.btn
            {gamemode set_mode jukebox $player_num}
            {ui goto_screen {gamemode get matchmaking_screen}}
         )
         (characterdata.btn
            {gamemode set_mode autoplay $player_num}
            {ui goto_screen autoplay_mode_setup_screen}
         )
         (calibrate_av.btn kDataUnhandled)
         (exportsongs.btn
            #ifdef HX_PS3
            {ui goto_screen store_enter_confirm_screen}
            #else
               {store_panel set store_player_num $player_num}
               {band_ui_sink set_controller_level
                  kControllerLevelPlayer
                  $player_num
                  {gamecfg get_controller_type_from_controller $player_num}
               }
               #ifdef HX_XBOX
               {if_else
                  {'||'
                     {! {platform_mgr is_player_signed_into_live $player_num}}
                     {platform_mgr is_player_a_guest $player_num}
                  }
                  {ui push_screen main_store_signin_screen}
                  {ui push_screen main_store_find_cache_screen}
               }
               #else
               {gamemode set_mode store}
               {ui goto_screen store_loading_screen}
               #endif
            #endif
         )
      }
   )
   (load {main_panel set mode_focus store.btn})
   (finish_load
      {audio.btn set text_token os_ultisettings}
      {gameplay.btn set text_token jukebox}
      {characterdata.btn set text_token autoplay}
      {calibrate_av.btn set text_token placeholder}
      {exportsongs.btn set text_token musicstore}
   )
   (TRANSITION_COMPLETE_MSG {autosave} kDataUnhandled)
}
{new UIScreen
   bonus_screen
   (panels meta movie_panel main_lower3rd_panel main_panel bonus_panel fx)
   (focus bonus_panel)
   (back main_screen)
   MAIN_SCREEN_TRANSITION_HANDLER
}
{new UIScreen
   jukebox_game_screen
   (panels game world_panel coop_track_panel mtv_overlay)
   GAME_SCREEN_HANDLERS
   (BUTTON_DOWN_MSG
      {switch $button
         (kPad_Square {cycle_free_camera})
         (kPad_Circle {toggle_time_paused})
         kDataUnhandled
      }
   )
}
{new UIScreen
   char_clear_screen
   (panels dialog_panel)
   (focus dialog_panel)
   (destination '')
   (enter
      {dialog_panel set_yesno
         {localize_token shop_clear_info}
         no.btn
      }
   )
   (SELECT_START_MSG
      {switch $component
         (yes.btn
            {do
               ($tour_char {shop_char_panel get tour_char})
               ($char {shop_char_panel get char})
               {foreach $a
                  (
                     (hair none)
                     (glasses none)
                     (wrist none)
                     (rings none)
                     (earrings none)
                     (heads empty)
                     (hands empty)
                     (torso empty)
                     (legs empty)
                     (feet empty)
                  )
                  {$tour_char select_outfit $char {elem $a 0} {elem $a 1}}
               }
               {if {== {$tour_char get_gender} male}
                  {$tour_char select_outfit $char facehair none}
               }
               {$tour_char set_weight $char 0.5}
               {$tour_char set_height $char 0.5}
               {$char deform FALSE}
               {shop_char_panel save}
            }
            {ui pop_screen}
         )
         (no.btn {ui pop_screen})
      }
      kDataUnhandled
   )
}
{new UIScreen
   early_warning_screen
   (panels dialog_panel)
   (focus dialog_panel)
   (destination '')
   (enter
      {dialog_panel set_yesno
         {localize_token early_warning}
         no.btn
      }
   )
   (SELECT_START_MSG
      {if {== $component yes.btn}
         {ui pop_screen}
      }
      kDataUnhandled
   )
}
{new UIPanel
   tour_pre_selsongsync_panel
   (remote_players ())
   (local_players ())
   (msg_data ())
   (send_songs_on_enter FALSE)
   (load
      {content_mgr start_refresh}
      {qp_selsong_panel set inhibit_refresh TRUE}
      {tour_selsong_panel set inhibit_refresh TRUE}
      {leaderboard_selsong_panel set inhibit_refresh TRUE}
   )
   (is_loaded {content_mgr refresh_done})
   (TRANSITION_COMPLETE_MSG
      {session add_sink $this}
      {resize [remote_players] 0}
      {if_else {is_leader_local}
         {do
            {song_mgr reset_shared_songs FALSE}
            {game foreach_player_config $pcfg
               {if {&& {$pcfg is_participating} {! {$pcfg is_local_player}}}
                  {push_back [remote_players] {$pcfg get player_num}}
               }
            }
            {session send_to_all {'`' ({',' $this} ready_for_songs)} kNetReliable}
            {$this check_for_advance}
         }
         {if [send_songs_on_enter]
            {$this send_songs}
         }
      }
   )
   (ready_for_songs
      {if_else {&& {$this is_up} {! {ui in_transition}}}
         {$this send_songs}
         {$this set send_songs_on_enter TRUE}
      }
   )
   (send_songs
      {resize [local_players] 0}
      {resize [msg_data] 0}
      {game foreach_player_config $pcfg
         {if {&& {$pcfg is_participating} {$pcfg is_local_player}}
            {push_back [local_players] {$pcfg get player_num}}
         }
      }
      {push_back [msg_data] [local_players]}
      {push_back [msg_data] {song_mgr get_local_unlocked_songs_glob}}
      {session send_to_player
         {game get leader_num}
         {'`'
            ({',' $this}
               process_remote_songs
               {',' [msg_data]}
            )
         }
         kNetReliable
      }
   )
   (exit
      {$this set send_songs_on_enter FALSE}
      {session remove_sink $this}
   )
   (process_remote_songs
      ($song_info)
      {set $pnums {elem $song_info 0}}
      {set $song_info {elem $song_info 1}}
      {song_mgr process_remote_shared_songs $song_info}
      {foreach $pnum $pnums
         {remove_elem [remote_players] $pnum}
      }
      {$this check_for_advance}
   )
   (REMOTE_PLAYER_LEFT_MSG
      {if {is_leader_local}
         {remove_elem [remote_players] $player_num}
         {$this check_for_advance}
      }
   )
   (check_for_advance
      {if {== {size [remote_players]} 0}
         {if {is_leader_local}
            {session send_to_all
               {'`' (song_mgr sync_shared_songs {',' {song_mgr get_shared_songs}})}
               kNetReliable
            }
         }
         {tour_band_waiting_panel real_advance}
      }
   )
}
{new UIScreen
   tour_pre_selsongsync_screen
   (panels meta practice_space_panel tour_pre_selsongsync_panel helpbar fx)
   (focus tour_pre_selsongsync_panel)
   (helpbar ())
   (helpbar_waiting
      {if_else {is_leader_local}
         helpbar_waiting_for_songs
         helpbar_sending_songs
      }
   )
}
{new UIPanel
   change_sort_panel
   (file "../../ui/player_names_dialog.milo")
   (focus players.lst)
   (target '')
   (helpbar ('' helpbar_select))
   (allow_player
      ($player_num)
      {if_else {gamemode get is_autoplay}
         TRUE
         {game is_player_participating $player_num}
      }
   )
   (enter
      {title.lbl set text_token change_sort}
      {players.lst set display_num 6}
      {players.lst set_data
         (
            filter_difficulty
            filter_genre
            filter_decade
            filter_alphabetic_song
            filter_alphabetic_band
            filter_game_origin
         )
      }
      {players.lst set_selected {song_provider get_display}}
      {players.lst set_local_pos_index 2 63.00}
   )
   (BUTTON_DOWN_MSG
      {if {== $button kPad_Tri}
         {ui pop_screen}
      }
      kDataUnhandled
   )
   (SELECT_MSG
      {ui pop_screen}
      {unless {== {$component selected_pos} {song_provider get_display}}
         {[target] set_grouping_method {$component selected_pos}}
         {[target] sync_grouping_method}
      }
   )
}
{new UIScreen
   change_sort_screen
   (panels change_sort_panel)
   (focus change_sort_panel)
   (exit {band_ui_sink set_net_sync TRUE})
}
{new Object
   on_save_load
   (save_load_all_complete_msg
      {profile_mgr set_overscan TRUE}
      {memcardmgr remove_sink $this}
      {delete $this}
   )
}
{memcardmgr add_sink on_save_load save_load_all_complete_msg}
{new UIScreen
   overshell_ok_msg ; a lie
   (panels dialog_panel)
   (focus dialog_panel)
   (destination '')
   (msg meow)
   (enter
      {dialog_panel set_ok
         {if_else {== {type [msg]} kDataString}
            [msg]
            {localize_token [msg]}
         }
      }
   )
   (SELECT_START_MSG
      {if {== $component ok.btn}
         {ui pop_screen}
      }
      kDataUnhandled
   )
   (show
      ($msg)
      {set [msg] $msg}
      {ui push_screen $this}
   )
}
{new UIScreen
   overshell_perma_lost
   (panels dialog_panel)
   (focus dialog_panel)
   (destination '')
   (name "")
   (player_num -1)
   (enter
      {dialog_panel set_yesno
         {localize_token perma_lost}
         yes.btn
      }
   )
   (SELECT_START_MSG
      {if {== $component yes.btn}
         {char_data_provider init [player_num]}
         {foreach_int $i 0 {char_data_provider get_num_chars}
            {if {== {char_data_provider get_char_name $i} [name]}
               {char_data_provider delete_character $i}
            }
         }
      }
      {ui pop_screen}
      kDataUnhandled
   )
}
{new UIPanel
   permadeath_setup_panel
   (file "../../ui/tour_solo_guitar_welcome.milo")
   (enter {$this update_text})
   (update_text
      {lives.btn set_localized
         {sprintf {localize perma_lives_fmt}
            {+ {permadeath_mgr get num_lives} 1}
         }
      }
   )
   (SELECT_MSG
      {switch $component
         (lives.btn
            {lives.sld store}
            {$this set_focus lives.sld}
         )
         (ok.btn
            {ui pop_screen}
            {with permadeath_mgr
               {++ [num_lives]}
               {set [total_lives] [num_lives]}
               {$this save_data}
            }
         )
      }
   )
   (BUTTON_DOWN_MSG
      {switch {$this focus_name}
         (lives.sld
            {switch $button
               (kPad_X
                  {lives.sld confirm}
                  {$this set_focus lives.btn}
               )
               (kPad_Tri
                  {lives.sld undo $player_num}
                  {$this set_focus lives.btn}
               )
               kDataUnhandled
            }
         )
         kDataUnhandled
      }
   )
   (SCROLL_MSG
      {switch $component
         (lives.sld
            {permadeath_mgr set num_lives {$component current}}
         )
      }
      {$this update_text}
   )
   (finish_load
      {mi_logo.mesh set_showing FALSE}

      {town_desc.lbl set text_token perma_intro}
      {town_desc.lbl set_local_pos_index 2 145}

      {$this iterate BandButton $btn {delete $btn}}
      {$this iterate UISlider $sld {delete $sld}}

      {new BandButton ok.btn}

      {new BandButton lives.btn}

      {$this iterate BandButton $btn
         {$btn copy {dialog_panel find no.btn} 0}
         {tour_band_busavailable.grp add_object $btn}
         {$btn set_trans_parent tour_band_busavailable.grp}
      }

      {ok.btn set text_token ok}
      {ok.btn set_local_pos_index 2 -150}

      {lives.btn set_local_pos -160 0 -21}
      {lives.btn set alignment kMiddleLeft}
      {lives.btn set nav_down ok.btn}
      
      {new UISlider lives.sld}

      {$this iterate UISlider $sld
         {$sld set_type audio}
         {tour_band_busavailable.grp add_object $sld}
         {$sld set_trans_parent tour_band_busavailable.grp}
         {$sld set_local_scale 0.6 0.6 0.6}
         {$sld set_local_pos 90 0 -20}
         {$sld set_num_steps 5}
         {$sld set_current 0}
      }



      {$this update_text}
      {$this set_focus lives.btn}
      {{$this loaded_dir} sync_objects}
   )
}
{new UIScreen
   permadeath_setup_screen
   (panels permadeath_setup_panel)
   (focus permadeath_setup_panel)
}
{new UIPanel
   permadeath_real_win_panel
   (file "permadeath_real_win.milo")
   (enter
      {{tour performer} buy_outfit rings halo_red 0}
      {{tour performer} select_outfit '' rings halo_red}
   )
   (BUTTON_DOWN_MSG
      {switch $button
         (kPad_X
            {ui pop_screen}
            {script_task kTaskUISeconds
               (delay 0.2)
               (script
                  {if_else {ui in_transition}
                     {print "showing win msg is unsafe now (dont spam buttons!)"}
                     {overshell_ok_msg show
                        {sprintf {localize_token on_insane_win}
                           {do
                              ($pcfg {game get_player_config {game get leader_num}})
                              {switch {$pcfg get_controller_sym}
                                 (drum drums)
                                 {$pcfg get_controller_sym}
                              }
                           }
                        }
                     }
                  }
               )
            }
         )
         kDataUnhandled
      }
   )
}
{new UIScreen
   permadeath_real_win_screen
   (panels permadeath_real_win_panel)
   (focus permadeath_real_win_panel)
}
