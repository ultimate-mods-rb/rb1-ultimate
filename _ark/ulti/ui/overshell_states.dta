(remap_cnt
   (title os_remap_cnt)
   (data (
      (os_reset
         (type uNormal)
         (sel_script
            #ifdef HX_NG
            {set $cnt_slot1 kPad_L2}
            {set $cnt_slot2 kPad_L1}
            {set $cnt_slot3 kPad_R1}
            {set $cnt_slot4 kPad_R2}
            {set $cnt_slot5 kPad_X}
            {set $cnt_star kPad_Select}
            #else
            {set $cnt_slot1 kPad_Circle}
            {set $cnt_slot2 kPad_DRight}
            {set $cnt_slot3 kPad_X}
            {set $cnt_slot4 kPad_Square}
            {set $cnt_slot5 kPad_Tri}
            {set $cnt_star kPad_DLeft}
            #endif
         )
      )
      (os_slot_1_fmt
         PAD_DATA_COMMON
         (var cnt_slot1)
      )
      (os_slot_2_fmt
         PAD_DATA_COMMON
         (var cnt_slot2)
      )
      (os_slot_3_fmt
         PAD_DATA_COMMON
         (var cnt_slot3)
      )
      (os_slot_4_fmt
         PAD_DATA_COMMON
         (var cnt_slot4)
      )
      (os_slot_5_fmt
         PAD_DATA_COMMON
         (var cnt_slot5)
      )
      (os_slot_od_fmt
         PAD_DATA_COMMON
         (var cnt_star)
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back cnt)
)
(other
   (title os_other)
   (data (
      (os_cheats
         (type uNormal)
         (sel_script {$this update_state cheats})
      )
      (os_av
         (type uNormal)
         (sel_script {$this update_state av})
      )
      (os_ven
         (type uNormal)
         (sel_script {$this update_state ven})
      )
      (os_online
         (type uNormal)
         (sel_script
            {if_else {== {session mode} kNetLocal}
               {passive_messages_panel queue_message {localize os_online_only}}
               {$this update_state online}
            }
         )
      )
      (os_skipintro
         (type uOnOFF)
         (bool $skipintro)
         (sel_script {toggle_var skipintro})
      )
      (os_fast_selsong
         (type uOnOFF)
         (bool $fast_selsong)
         (sel_script {toggle_var fast_selsong})
      )
      (os_reset_all
         (type uNormal)
         (block_ingame TRUE)
         (sel_script
            {run ulti/ulti_init.dta}
            {run ulti/ulti_init_apperance.dta}
         )
      )
      #ifdef _DEBUG
      ('debug'
         (type uNormal)
         (sel_script {$this update_state debug})
      )
      #endif
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back main)
)
(cheats
   (title os_cheats)
   (data (
      (os_colorshuffle
         (type uOnOFF)
         (bool $colorshuffle)
         (sel_script {toggle_var colorshuffle})
      )
      (os_smallworld
         (type uOnOFF)
         (bool $smallworld)
         (sel_script {toggle_var smallworld})
      )
      (os_bigmode
         (type uOnOFF)
         (bool $bigmode)
         (sel_script {toggle_var bigmode})
      )
      (os_scale_head
         (type uOnOFF)
         (bool $scale_head)
         (sel_script {toggle_var scale_head})
      )
      (os_honestmode
         (type uOnOFF)
         (bool $honestmode)
         (sel_script
            {unless $honestmilo
               {set $honestmilo {load_objects ulti/honestbob.milo}}
               {$honestmilo delete_loader}
            }
            {toggle_var honestmode}
         )
      )
      (os_hidechars
         (type uOnOFF)
         (bool $hidechars)
         (sel_script {toggle_var hidechars})
      )
      (os_flashbang
         (type uOnOFF)
         (bool $flashbang)
         (sel_script {toggle_var flashbang})
      )
      (os_cheats
         (type uOnOFF)
         (bool $mikan)
         (sel_script {toggle_var mikan})
      )
      (os_fakecheat
         (type uNormal)
         (sel_script
            {passive_messages_panel queue_message "meow meow meow"}
            {if {shop_char_panel is_up}
               {{{game get_player_config {shop_char_panel get char_player_num}} get_char} set_money 999999999}
            }
         )
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back other)
)
(av
   (title os_av)
   (data (
      (bass_boost
         (type uOnOFF)
         (bool {profile_mgr get_bass_boost})
         (sel_script {profile_mgr set_bass_boost {! {profile_mgr get_bass_boost}}})
      )
      (os_dolby
         (type uOnOFF)
         (bool {profile_mgr get_dolby})
         (sel_script {profile_mgr set_dolby {! {profile_mgr get_dolby}}})
      )
      #ifdef HX_PS3
      (mono
         (type uOnOFF)
         (bool {profile_mgr get_mono})
         (sel_script {profile_mgr set_mono {! {profile_mgr get_mono}}})
      )
      #endif
      (os_overscan
         (type uOnOFF)
         (bool {profile_mgr get_overscan})
         (sel_script {profile_mgr set_overscan {! {profile_mgr get_overscan}}})
      )
      (os_ivol_fmt VOL_SLD
         (get {profile_mgr get_foreground_volume})
         (set {profile_mgr set_foreground_volume $r})
      )
      (os_bvol_fmt VOL_SLD
         (get {profile_mgr get_background_volume})
         (set {profile_mgr set_background_volume $r})
      )
      (os_cvol_fmt VOL_SLD
         (get {profile_mgr get_crowd_volume})
         (set {profile_mgr set_crowd_volume $r})
      )
      (os_svol_fmt VOL_SLD
         (get {profile_mgr get_fx_volume})
         (set {profile_mgr set_fx_volume $r})
      )
      (os_avs_fmt CALI_SLD
         (get {int {profile_mgr get_song_to_taskmgr_ms_ui}})
         (set {profile_mgr set_song_to_taskmgr_ms_ui $r})
      )
      (os_lo_fmt CALI_SLD
         (get {int {profile_mgr get_sync_offset_ui}})
         (set {profile_mgr set_sync_offset_ui $r})
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back other)
)
(ven
   (title os_ven)
   (data (
      (os_selectvenue
         (type uOnOFF)
         (bool $selectvenue)
         (sel_script {toggle_var selectvenue})
      )
      (os_normal_venues
         (type uOnOFF)
         (bool $normal_venues)
         (sel_script {toggle_var normal_venues})
      )
      (os_rb2_venues
         (type uOnOFF)
         (bool $rb2_venues)
         (sel_script {toggle_var rb2_venues})
      )
      (os_custom_venues
         (type uOnOFF)
         (bool $custom_venues)
         (sel_script {toggle_var custom_venues})
      )
      (os_chars
         (type uNormal)
         (sel_script {$this update_state chars})
      )
      (os_del_prefab
         (type uNormal)
         (sel_script {$this update_state del_prefab})
      )
      (os_force_vg
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (var force_vg)
         (array (off male female))
      )
      (os_force_venue
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (var force_venue)
         (array (off random VENUES RB2_VENUES ULTI_VENUES))
      )
   ))
   (enter {$this setup_common})
   (exit
      {unless {|| $normal_venues $rb2_venues $custom_venues}
         {set $normal_venues TRUE}
      }
   )
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back other)
)
(chars
   (title os_chars)
   (data (
      (os_reset
         (type uNormal)
         (sel_script {set $char_list {array 0}})
      )
      (os_guitar_chars
         (type uNormal)
         (sel_script
            {set [state] char_list}
            {$this state_set filter guitar}
            {$this state_set title os_guitar_chars}
            {$this update_state char_list}
         )
      )
      (os_drum_chars
         (type uNormal)
         (sel_script
            {set [state] char_list}
            {$this state_set filter drum}
            {$this state_set title os_drum_chars}
            {$this update_state char_list}
         )
      )
      (os_vocals_chars
         (type uNormal)
         (sel_script
            {set [state] char_list}
            {$this state_set filter vocals}
            {$this state_set title os_vocals_chars}
            {$this update_state char_list}
         )
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back ven)
)
(char_list
   (title os_guitar_chars)
   (filter guitar)
   (data    ())
   (prefabs ())
   (normal  ())
   (custom  ())
   (enter
      {do
         ($a
            {` 
               (
                  (os_reset
                     (type uNormal)
                     (sel_script {$this state_handle reset ()})
                  )
                  (os_clear_normal
                     (type uNormal)
                     (sel_script {$this state_handle clear ({$this state_get normal})})
                  )
                  (os_clear_custom
                     (type uNormal)
                     (sel_script {$this state_handle clear ({$this state_get custom})})
                  )
               )
            }
         )
         {foreach $prefab {find $syscfg characters prefab}
            {if {== {type $prefab} kDataArray} {do
               ($data {elem {find $prefab instrument} 1})
               {if {&& $data {== {type $data} kDataCommand}} {do
                  ($custom {eval {elem $data 1}})
                  ($inst   {eval {elem $data 2}})
                  ($name   {eval {elem $data 3}})
                  {if {== $inst {$this state_get filter}}
                     {push_back {$this state_get prefabs} $name}
                     {if_else $custom
                        {push_back {$this state_get custom} $name}
                        {push_back {$this state_get normal} $name}
                     }
                     {push_back $a
                        {`
                           ({, $name}
                              (type uOnOFF)
                              (bool {$this state_handle in_list ({, $name})})
                              (sel_script {$this state_handle change_state ({, $name})})
                           )
                        }
                     }
                  }
               }}
            }}
         }
         {$this state_set data $a}
      }
      {$this setup_common}
   )
   (exit
      {resize {$this state_get data} 0}
      {resize {$this state_get prefabs} 0}
      {resize {$this state_get normal} 0}
      {resize {$this state_get custom} 0}
   )
   (reset
      {foreach $prefab {$this state_get prefabs}
         {if {find_elem $char_list $prefab}
            {remove_elem $char_list $prefab}
         }
      }
   )
   (clear
      ($prefabs)
      {foreach $prefab $prefabs
         {unless {find_elem $char_list $prefab}
            {push_back $char_list $prefab}
         }
      }
   )
   (in_list
      ($name)
      {! {find_elem $char_list $name}}
   )
   (change_state
      ($name)
      {if_else {find_elem $char_list $name}
         {remove_elem $char_list $name}
         {push_back $char_list $name}
      }
   )
   (button_down
      {if_else {!= $button kPad_Tri}
         {$this down_common}
         {do
            ($active 0)
            ($any_male FALSE)
            ($any_female FALSE)
            {foreach $prefab {$this state_get prefabs}
               {unless {find_elem $char_list $prefab}
                  {++ $active}
                  {switch {elem {find $syscfg characters prefab $prefab gender} 1}
                     (male {set $any_male TRUE})
                     (female {set $any_female TRUE})
                  }
               }
            }
            {cond
               ({== $active 0}
                  {passive_messages_panel queue_message {localize os_no_active}}
               )
               ({== {$this state_get filter} vocals}
                  {cond
                     ({&& $any_male {! $any_female}}
                        {passive_messages_panel queue_message {localize os_no_female_vocals}}
                     )
                     ({&& $any_female {! $any_male}}
                        {passive_messages_panel queue_message {localize os_no_male_vocals}}
                     )
                     (TRUE {$this unhandled_down})
                  }
               )
               ({== $active 1}
                  {passive_messages_panel queue_message {localize os_crash_potential}}
                  {$this unhandled_down}
               )
               (TRUE {$this unhandled_down})
            }
         }
      }
   )
   (component_select {$this sel_common})
   (back chars)
)
(del_prefab
   (title os_del_prefab)
   (data ())
   (update_data
      {do
         ($a
            {` 
               (
                  (os_clear_all
                     (type uNormal)
                     (sel_script
                        {resize $user_prefabs 0}
                        {$this state_handle update_data ()}
                     )
                  )
               )
            }
         )
         {foreach $prefab $user_prefabs
            {push_back $a {elem $prefab 0}}
         }
         {$this state_set data $a}
      }
   )
   (enter
      {$this state_handle update_data ()}
      {$this setup_common}
      {passive_messages_panel queue_message {localize p_reboot_warning}}
   )
   (exit
      {mod_settings_rw save_prefabs}
      {resize {$this state_get data} 0}
   )
   (component_select
      {if_else {OS_LIST selected_pos}
         {if {find_exists $user_prefabs {OS_LIST selected_sym}}
            {remove_elem $user_prefabs
               {find $user_prefabs {OS_LIST selected_sym}}
            }
            {$this state_handle update_data ()}
            {$this state_set pos {array 2}}
            {$this lst_reset}
         }
         {$this sel_common}
      }
   )
   (button_down {$this down_common})
   (back ven)
)
(online
   (title os_online)
   (player_num 0)
   (data (
      (os_kick
         (type uNormal)
         (sel_script
            {if_else {is_leader_local}
               {$this update_state online_kick}
               {passive_messages_panel queue_message {localize os_host_kick}}
            }
         )
      )
      #ifdef HX_XBOX
      (os_gamercard
         (type uNormal)
         (sel_script {$this update_state online_gamercard})
      )
      #endif
      (os_send_msg
         (type uNormal)
         (sel_script
            {$this state_set player_num $player_num}
            {platform_mgr show_keyboard
               $player_num
               64
               {localize os_send_msg_info}
               ""
               ""
               overshell
            }
         )
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (virtual_keyboard_result_msg
      {if {&& $ok $text}
         {set $text
            {sprint
               {{game get_player_config {$this state_get player_num}} intro_name}
               ": "
               $text
            }
         }
         {rpm $text}
         {session send_to_all
            {`
               (if {exists rpm}
                  {rpm {, $text}}
               )
            }
            kNetReliable
         }
      }
   )
   (back other)
)
(online_kick
   (title os_kick)
   (data ())
   (players ())
   (enter
      {game foreach_player_config $pcfg
         {if {&& {$pcfg is_participating} {! {$pcfg is_local_player}}}
            {push_back {$this state_get data} {$pcfg get player_name}}
            {push_back {$this state_get players} {$pcfg get player_num}}
         }
      }
      {if_else {size {$this state_get data}}
         {$this setup_common}
         {do
            {passive_messages_panel queue_message {localize os_no_players}}
            {$this update_state online}
         }
      }
   )
   (exit
      {resize {$this state_get data} 0}
      {resize {$this state_get players} 0}
   )
   (component_select
      {session kick {elem {$this state_get players} {OS_LIST selected_pos}}}
      {$this update_state online}
   )
   (button_down {$this down_common})
   (back online)
)
(online_gamercard
   (title os_gamercard)
   (data ())
   (enter
      {game foreach_player_config $pcfg
         {push_back {$this state_get data} {$pcfg get player_name}}
      }
      {if_else {size {$this state_get data}}
         {$this setup_common}
         {do
            {passive_messages_panel queue_message {localize os_no_players}}
            {$this update_state online}
         }
      }
   )
   (exit {resize {$this state_get data} 0})
   (component_select
      {session_players_provider show_gamercard
         {OS_LIST selected_pos}
         $player_num
      }
   )
   (button_down {$this down_common})
   (back online)
)
