(trk
   (title os_trk)
   (data (
      #ifdef HX_NG
      (os_preset
         (type uNormal)
         (block_ingame TRUE)
         (sel_script {$this update_state preset})
      )
      #else
      (os_apply_preset
         (type uInvoke)
         (array {do
            ($a {array 0})
            {foreach $p {find $syscfg track_presets}
               {if {&& {== {type $p} kDataArray} {size $p}}
                  {push_back $a {elem $p 0}}
               }
            }
            $a
         })
         (block_ingame TRUE)
         (on_invoke {asset_mgr apply_preset $r})
      )
      #endif
      (guitar
         (type uNormal)
         (sel_script
            {asset_mgr set target guitar}
            {$this update_state trk_config}
         )
      )
      (bass
         (type uNormal)
         (sel_script
            {asset_mgr set target bass}
            {$this update_state trk_config}
         )
      )
      (drum
         (type uNormal)
         (sel_script
            {asset_mgr set target drum}
            {$this update_state trk_config}
         )
      )
      (os_track_config
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (var track_config)
         (array {asset_mgr track_configs})
      )
      #ifdef HX_NG
      (os_sync_online
         (type uOnOFF)
         (bool $sync_online)
         (sel_script {toggle_var sync_online})
      )
      #endif
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back main)
)
(preset
   (title os_preset)
   (dirty FALSE)
   (data (
      (os_apply_preset
         (type uInvoke)
         (array {do
            ($a {array 0})
            {foreach $p {find $syscfg track_presets}
               {if {&& {== {type $p} kDataArray} {size $p}}
                  {push_back $a {elem $p 0}}
               }
            }
            {foreach $p $user_presets
               {if {&& {== {type $p} kDataArray} {size $p}}
                  {push_back $a {elem $p 0}}
               }
            }
            $a
         })
         (on_invoke {asset_mgr apply_preset $r})
      )
      (os_save_preset
         (type uNormal)
         (sel_script
            {platform_mgr show_keyboard
               $player_num
               16
               {localize os_save_preset_info}
               ""
               ""
               overshell
            }
         )
      )
      (os_delete_preset
         (type uInvoke)
         (array {do
            ($a {array 0})
            {foreach $p $user_presets
               {if {&& {== {type $p} kDataArray} {size $p}}
                  {push_back $a {elem $p 0}}
               }
            }
            $a
         })
         (on_invoke
            {remove_elem $user_presets {find_exists $user_presets $r}}
            {$this state_set dirty TRUE}
         )
      )
   ))
   (enter {$this setup_common})
   (exit
      {if {$this state_get dirty}
         {mod_settings_rw save_presets}
         {$this state_set dirty FALSE}
      }
   )
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (virtual_keyboard_result_msg
      {if {&& $ok $text}
         {set $text {symbol $text}}
         {if_else {find_exists $syscfg track_presets $text}
            {passive_messages_panel queue_message {localize os_diff_name}}
            {do
               {asset_mgr save_preset $text}
               {$this state_set dirty TRUE}
            }
         }
      }
   )
   (back trk)
)
(trk_config
   (title {asset_mgr target})
   (data ())
   (data_static (
      (os_gems
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (get {asset_mgr ui_get gems})
         (set {asset_mgr ui_set gems $r})
         (array
            {cond
               ({&& {== {asset_mgr target} drum} {asset_mgr ui_get rgb}}
                  {asset_mgr drum_gems_rgb}
               )
               ({== {asset_mgr target} drum}
                  {asset_mgr drum_gems}
               )
               ({asset_mgr ui_get rgb}
                  {asset_mgr guitar_gems_rgb}
               )
               (TRUE {asset_mgr guitar_gems})
            }
         )
      )
      (os_smashers
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (get {asset_mgr ui_get smashers})
         (set {asset_mgr ui_set smashers $r})
         (array
            {cond
               ({&& {== {asset_mgr target} drum} {asset_mgr ui_get rgb}}
                  {asset_mgr drum_smashers_rgb}
               )
               ({== {asset_mgr target} drum}
                  {asset_mgr drum_smashers}
               )
               ({asset_mgr ui_get rgb}
                  {asset_mgr guitar_smashers_rgb}
               )
               (TRUE {asset_mgr guitar_smashers})
            }
         )
      )
      (os_colors
         (type uNormal)
         (sel_script
            {$this update_state
               {if_else {!= {asset_mgr target} drum}
                  colors_gtr
                  colors_drum
               }
            }
         )
      )
      #ifdef HX_NG
      (os_notergb
         (type uOnOFF)
         (bool {asset_mgr ui_get rgb})
         (block_ingame TRUE)
         (sel_script
            {asset_mgr ui_set rgb {! {asset_mgr ui_get rgb}}}
            {asset_mgr ensure_stuff}
         )
      )
      #endif
   ))
   (enter
      {do ($a {$this state_get data_static})
         {foreach $e $a
            {push_back {$this state_get data} $e}
         }
         {switch {asset_mgr target}
            (guitar
               {push_back {$this state_get data}
                  (os_copy_bass
                     (type uNormal)
                     (block_ingame TRUE)
                     (sel_script {$this state_handle copy (guitar bass)})
                  )
               }
            )
            (bass
               {push_back {$this state_get data}
                  (os_copy_guitar
                     (type uNormal)
                     (block_ingame TRUE)
                     (sel_script {$this state_handle copy (bass guitar)})
                  )
               }
            )
         }
      }
      {asset_mgr ensure_stuff}
      {$this setup_common}
   )
   (exit
      {resize {$this state_get data} 0}
      #ifdef HX_NG
      {if {exists beatmatch}
         {asset_mgr apply_all_rgb}
      }
      #endif
   )
   (copy
      ($from $to) {do
      ($a {eval_array {find {asset_mgr config} $from}})
      {set_elem $a 0 $to}
      {set_elem {asset_mgr config}
         {get_elem
            {asset_mgr config}
            {find {asset_mgr config} $to}
         }
         $a
      }
   })
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back trk)
)
(colors_gtr
   (title os_colors)
   (data (
      (os_gems_colors
