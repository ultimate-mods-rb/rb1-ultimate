(main
   (title os_ultisettings)
   (data (
      (os_mod
         (type uNormal)
         (sel_script {$this update_state modifier})
      )
      (os_spd
         (type uNormal)
         (sel_script {$this update_state speed})
      )
      (os_vis
         (type uNormal)
         (sel_script {$this update_state visual})
      )
      (os_trk
         (type uNormal)
         (sel_script {$this update_state trk})
      )
      (os_gfx
         (type uNormal)
         (sel_script {$this update_state gfx})
      )
      (os_cnt
         (type uNormal)
         (sel_script {$this update_state cnt})
      )
      (os_other
         (type uNormal)
         (sel_script {$this update_state other})
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down
      {if {== $button kPad_Tri}
         {synth play button_back}
         {mod_settings_rw save_settings}
         {$this state_remove pos}
         {$this set_up FALSE}
      }
      kDataUnhandled
   )
)
(modifier
   (title os_mod)
   (data (
      (os_nofail
         (type uOnOFF)
         (bool $nofail)
         (sel_script {toggle_var nofail})
      )
      (os_autokick
         (type uOnOFF)
         (bool $autokick)
         (sel_script {toggle_var autokick})
      )
      (os_tiltsensor
         (type uOnOFF)
         (bool $tiltsensor)
         (sel_script {toggle_var tiltsensor})
      )
      (os_whammypb
         (type uOnOFF)
         (bool $whammypb)
         (sel_script {toggle_var whammypb})
      )
      (os_trkmuting
         (type uOnOFF)
         (bool $trkmuting)
         (sel_script {toggle_var trkmuting})
      )
      (os_misssounds
         (type uOnOFF)
         (bool $misssounds)
         (sel_script {toggle_var misssounds})
      )
      (os_micdeploy
         (type uOnOFF)
         (bool $micdeploy)
         (sel_script {toggle_var micdeploy})
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back main)
)
(visual
   (title os_vis)
   (data (
      (os_nohud
         (type uOnOFF)
         (bool $nohud)
         (sel_script {toggle_var nohud})
      )
      (os_songtitle
         (type uOnOFF)
         (bool $songtitle)
         (sel_script {toggle_var songtitle})
      )
      (os_legacybass
         (type uOnOFF)
         (bool $legacybass)
         (sel_script {toggle_var legacybass})
      )
      (os_kickbounce
         (type uOnOFF)
         (bool $kickbounce)
         (sel_script {toggle_var kickbounce})
      )
      (os_prodrums
         (type uOnOFF)
         (bool $prodrums)
         (sel_script {toggle_var prodrums})
      )
      (os_fcring
         (type uOnOFF)
         (bool $fcring)
         (block_ingame TRUE)
         (sel_script {toggle_var fcring})
      )
      (os_goldprogress
         (type uOnOFF)
         (bool $goldprogress)
         (block_ingame TRUE)
         (sel_script {toggle_var goldprogress})
      )
      (os_countdown
         (type uOnOFF)
         (bool $countdown)
         (sel_script {toggle_var countdown})
      )
      (os_songtimer
         (type uFakeSld)
         (fmt_type uTimer)
         (var songtimer)
         (array (0 1 2 3 4 5))
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back main)
)
(gfx
   (title os_gfx)
   (data (
      (os_fps_fmt
         (type uFakeSld)
         (fmt_type uNormal)
         (var emulatefps)
         (array
            #ifdef HX_NG
            (1 6 12 15 24 30 60)
            #else
            (15 30)
            #endif
         )
      )
      (os_vsync_fmt
         (type uFakeSld)
         (fmt_type uSync)
         (var vsyncrate)
         (array (0 1 2 4))
      )
      (os_blackbg
         (type uOnOFF)
         (bool $blackbg)
         (sel_script {toggle_var blackbg})
      )
      (os_fxdof
         (type uOnOFF)
         (bool $fxdof)
         (sel_script {toggle_var fxdof})
      )
      (os_scrnoise
         (type uOnOFF)
         (bool $scrnoise)
         (sel_script {toggle_var scrnoise})
      )
      (os_scrbloom
         (type uOnOFF)
         (bool $scrbloom)
         (sel_script {toggle_var scrbloom})
      )
      (os_camerashake
         (type uOnOFF)
         (bool $camerashake)
         (sel_script {toggle_var camerashake})
      )
      (os_crowd
         (type uOnOFF)
         (bool $crowd)
         (sel_script {toggle_var crowd})
      )
      #ifdef HX_PS3
      (os_force_per_pixel
         (type uOnOFF)
         (bool $force_per_pixel)
         (sel_script {toggle_var force_per_pixel})
      )
      #endif
      (os_aspect_fmt
         (type uFakeSld)
         (fmt_type uAspect)
         (get {rnd aspect})
         (set {rnd set_aspect $r})
         (array (kSquareAspect kRegularAspect kWidescreenAspect))
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back main)
)
(cnt
   (title os_cnt)
   (data (
      (os_remap_cnt
         (type uNormal)
         (sel_script
            {set $pad_map 0}
            {$this update_state remap_cnt}
         )
      )
      (os_cnt_map_fmt
         (type uFakeSld)
         (fmt_type uMapping)
         (var pad_map)
         (array (0 1 2 3 4))
      )
      (os_padinst_fmt
         (type uFakeSld)
         (fmt_type uInst)
         (var pad_inst)
         (array
            (
               kControllerVocals
               kControllerGuitar
               kControllerDrum
            )
         )
      )
   ))
   (enter {$this setup_common})
   (exit {set_pad_map $pad_map})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back main)
)
(speed
   (title os_spd)
   (data (
      (os_trackspeed
         (type uNormal)
         (sel_script {$this update_state trackspeed})
      )
      (hwlength_msg
         (type uSld)
         (fmt_type uSpeed)
         (var hwlength)
         (step 0.05)
         (range 0.50 2.50)
      )
      (speed_msg
         (type uSld)
         (fmt_type uSpeed)
         (var speedmod)
         (block_ingame TRUE)
         (step 0.05)
         (range 1.00 2.50)
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back main)
)
(trackspeed
   (title os_trackspeed)
   (data (
      (os_indvtrkspeeds
         (type uOnOFF)
         (bool $indvtrkspeeds)
         (sel_script {toggle_var indvtrkspeeds})
      )
      (os_syncdifspeeds
         (type uOnOFF)
         (bool $syncdifspeeds)
         (sel_script {toggle_var syncdifspeeds})
      )
      (gtr_trackspeed_msg
         (type uSld)
         (fmt_type uSpeed)
         (var guitar_trackspeed)
         (step 0.05)
         (range 0.50 2.50)
      )
      (bass_trackspeed_msg
         (type uSld)
         (fmt_type uSpeed)
         (var bass_trackspeed)
         (step 0.05)
         (range 0.50 2.50)
      )
      (drum_trackspeed_msg
         (type uSld)
         (fmt_type uSpeed)
         (var drum_trackspeed)
         (step 0.05)
         (range 0.50 2.50)
      )
      (track0_trackspeed_msg
         (type uSld)
         (fmt_type uSpeed)
         (var track0_trackspeed)
         (step 0.05)
         (range 0.50 2.50)
      )
      (track1_trackspeed_msg
         (type uSld)
         (fmt_type uSpeed)
         (var track1_trackspeed)
         (step 0.05)
         (range 0.50 2.50)
      )
   ))
   (enter {$this setup_common})
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back speed)
)
(trk
   (title os_trk)
   (data (
      (os_reset
         (type uNormal)
         (block_ingame TRUE)
         (sel_script {run ulti/ulti_init_apperance.dta})
      )
      (os_gems
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (var gems)
         (array
            {if_else $notergb
               {asset_mgr all_gems_rgb}
               {asset_mgr all_gems}
            }
         )
      )
      (os_smashers
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (var smashers)
         (array
            {if_else $notergb
               {asset_mgr all_smashers_rgb}
               {asset_mgr all_smashers}
            }
         )
      )
      (os_colors
         (type uNormal)
         (sel_script
            {if_else $notergb
               {$this update_state rgb_colors}
               {$this update_state colors}
            }
         )
      )
      (os_notergb
         (type uOnOFF)
         (bool $notergb)
         (block_ingame TRUE)
         (sel_script
            {toggle_var notergb}
            {asset_mgr ensure_stuff}
         )
      )
      (os_track_config
         (type uFakeSld)
         (fmt_type uLocalize)
         (hide_on_sel TRUE)
         (var track_config)
         (array {asset_mgr track_configs})
      )
   ))
   (enter
      {asset_mgr ensure_stuff}
      {$this setup_common}
   )
   (exit
      {if {&& $notergb {exists beatmatch}}
         {asset_mgr apply_all_rgb}
      }
   )
   (component_select {$this sel_common})
   (button_down {$this down_common})
   (back main)
)
(colors
   (title os_colors)
   (data (
      (os_gtr_gems_color
         (type uNormal)
         (sel_script {$this update_state gtr_gem_color})
      )
      (os_gtr_smasher_color
         (type uNormal)
         (sel_script {$this update_state gtr_smasher_color})
