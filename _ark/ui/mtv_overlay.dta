{new UIPanel
   mtv_overlay
   (file mtv_overlay.milo)
   (enter
      {$this show_overlay FALSE}
      {if {exists game}
         {game add_sinks $this intro_end}
      }
   )
   (intro_end
      {if {gamemode get show_mtv_overlay}
         {$this setup_text}
         {$this show_overlay TRUE}
         {unless $songtitle
            {script_task kTaskSeconds (delay 5) (script {$this show_overlay FALSE})}
         }
      }
   )
   (exit
      {if {exists game}
         {game remove_sink $this}
      }
   )
   (setup_text
      {do
         ($song {game get_song})
         ($data {song_mgr get_data $song})
         ($song_text
            {if_else {> {get_song_speed} 1.00}
               {sprintf "%s (%d% Speed)"
                  {song_mgr song_name $song}
                  {int {+ {* 100 {get_song_speed}} 0.5}}
               }
               {song_mgr song_name $song}
            }
         )
         ($author
            {if_else {&& $data {find_exists $data author}}
               {elem {find $data author} 1}
               kDataUnhandled
            }
         )
         ($artist_text
            {if_else {&& $author {!= $author "Unknown Author"}}
               {sprint
                  {song_mgr song_artist $song}
                  "\n"
                  $author
               }
               {song_mgr song_artist $song}
            }
         )
         {if_else {song_mgr is_master $song}
            {do
               ($prefix "mtv_master_line")
               {mtv_cover_song_id.view set_showing FALSE}
               {mtv_master_song_id.view set_showing TRUE}
               {$this set_line $prefix 1 $song_text}
               {$this set_line $prefix 3 $artist_text}
            }
            {do
               ($prefix "mtv_cover_line")
               {mtv_cover_song_id.view set_showing TRUE}
               {mtv_master_song_id.view set_showing FALSE}
               {$this set_line $prefix 1 $song_text}
               {$this set_line $prefix 3 $artist_text}
            }
         }
      }
   )
   (set_line
      ($prefix $i $text)
      {{sprint
            $prefix
            $i
            ".lbl"} set_localized
         $text
      }
   )
   (show_overlay
      ($show)
      {$this set_showing $show}
      {if_else $show
         {if_else $songtitle
            {fade.anim set_frame 50}
            {fade.anim animate}
         }
         {fade.anim set_frame 0}
      }
      {$this set_paused {! $show}}
   )
   #ifdef HX_NG
   (finish_load
      {foreach $o
         (
            mtv_master_line1.lbl
            mtv_cover_line1.lbl
         )
         {$o set fit_type kFitJust}
         {$o set height 27}
      }
      {foreach $o
         (
            mtv_master_line3.lbl
            mtv_cover_line3.lbl
         )
         {$o set fit_type kFitWrap}
         {$o set text_size 27.35}
         {$o set leading 0.67}
         {$o set height 27}
         {$o set width 575.00}
      }
      {mtv_cover_line3.lbl set leading 0.60}
   )
   #endif
}