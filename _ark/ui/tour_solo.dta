{new UIPanel
   tour_solo_event_panel
   LIMIT_TO_LEADER_SESSION
   TOUR_EVENT_PANEL_HANDLERS
   COMMON_SONG_PREVIEW
   (file tour_solo_event.milo)
   (focus event.lst)
   (real_char FALSE)
   (enter
      {$this select_first_unplayed}
      {$this refresh}
      {$this play_preview}
      {platform_mgr disable_xmp}
      {if {permadeath_mgr should_warn}
         {overshell_ok_msg show
            {sprintf {localize on_lost_life}
               {random_elem (":3" "XD" "LMAO")}
               {localize
                  {random_elem
                     (
                        perma_taunt_0
                        perma_taunt_1
                        perma_taunt_2
                     )
                  }
               }
               {permadeath_mgr num_lives}
               {permadeath_mgr total_lives}
            }
         }
         {permadeath_mgr set should_warn FALSE}
      }
      {if {== {permadeath_mgr songs_completed} 58}
         {permadeath_mgr set won TRUE}
         {permadeath_mgr save_data}
         {if_else {== {permadeath_mgr num_lives} {permadeath_mgr total_lives}}
            {ui push_screen permadeath_real_win_screen}
            {overshell_ok_msg show
               {sprintf {localize on_lame_win}
                  {permadeath_mgr num_lives}
                  {permadeath_mgr total_lives}
               }
            }
         }
      }
   )
   (select_first_unplayed
      {do
         ($mode {{tour solo_event_provider} get mode})
         {unless {== $mode kTourVenueDownload}
            {do
               ($event {{tour performer} first_unplayed_event $mode})
               {if $event
                  {event.lst set_provider {tour solo_event_provider}}
                  {event.lst set_selected {$event get event_name}}
                  {$this update_selection}
               }
            }
         }
      }
   )
   (exit
      {song_preview ''}
      {session remove_sink $this}
   )
   (refresh
      {do
         ($provider {tour solo_event_provider})
         {event.lst set_provider $provider}
         {if {tour event}
            {event.lst set_selected
               {{tour event} get event_name}
               FALSE
               {$provider refresh_first_showing}
            }
         }
      }
      {$this update_selection}
      {if {tour hint}
         {ui goto_screen {{tour hint} get screen}}
      }
   )
   (update_selection
      {do
         ($provider {tour solo_event_provider})
         ($pos {event.lst selected_pos})
         ($town {$provider town $pos})
         ($venue {$provider venue $pos})
         {{tour performer} set_town $town}
         {{tour performer} set_venue $venue}
         {tour_world_bg_panel set town $town}
         {tour_world_bg_panel set venue $venue}
         {tour_world_bg_panel zoom_in}
         {unless {$this is_mode_selected}
            {{tour performer} set_event {event.lst selected_sym} {game get leader_num}}
         }
      }
   )
   (BUTTON_DOWN_MSG
      {cond
         ({== $button kPad_X}
            {if {== {{tour solo_event_provider} get mode} kTourVenueDownload}
               {$this update_selection}
            }
            {cond
               (
                  {&&
                     {gamemode get is_permadeath}
                     {! {$this is_mode_selected}}
                     {== {{tour performer} event_status} kTourPlayed}
                  }
                  {overshell_ok_msg show perma_already_played}
               )
               (
                  {&&
                     {! {$this is_mode_selected}}
                     {== kTourLocked {{tour performer} event_status}}
                  }
                  TRUE
               )
               (TRUE kDataUnhandled)
            }
         )
         ({== $button kPad_Tri}
            {do
               ($prev_mode {{tour solo_event_provider} get mode})
               {platform_mgr enable_xmp}
               {if_else {== $prev_mode kTourVenueNormal}
                  kDataUnhandled
                  {do
                     {synth play button_back}
                     {{tour solo_event_provider} set mode kTourVenueNormal}
                     {event.lst set_provider {tour solo_event_provider}}
                     {event.lst set_selected
                        {if_else {== $prev_mode kTourVenueDownload}
                           download
                           unlock
                        }
                     }
                     {$this update_selection}
                     {$this play_preview}
                  }
               }
            }
         )
         ({== $button kPad_DLeft}
            {event.lst scroll -6}
            {$this component_scroll 0 0}
            {song_preview ''}
         )
         ({== $button kPad_DRight}
            {event.lst scroll 6}
            {$this component_scroll 0 0}
            {song_preview ''}
         )
         ({$this is_updown $button}
            {song_preview ''}
            kDataUnhandled
         )
         (TRUE kDataUnhandled)
      }
   )
   (BUTTON_UP_MSG
      {if {&& {! {ui in_transition}} {$this is_updown $button}}
         {$this play_preview}
      }
      kDataUnhandled
   )
   (play_preview
      {if_else
         {'||'
            {$this is_mode_selected}
            {== kTourLocked {{tour performer} event_status}}
         }
         {song_preview ''}
         {song_preview
            {{tour solo_event_provider} event_song {event.lst selected_pos}}
         }
      }
   )
   (is_mode_selected
      {'||'
         {== unlock {event.lst selected_sym}}
         {== download {event.lst selected_sym}}
      }
   )
   (SCROLL_MSG
      {if
         {!=
            {{tour solo_event_provider} town {event.lst selected_pos}}
            {{tour performer} town}
         }
         {synth play bwt_swish.cue}
      }
      {unless {== {{tour solo_event_provider} get mode} kTourVenueDownload}
         {$this update_selection}
      }
   )
   (SELECT_START_MSG
      {if
         {&&
            {!= {event.lst selected_sym} unlock}
            {!= {event.lst selected_sym} download}
            {!= kTourLocked {{tour performer} event_status}}
         }
         {$this confirm_event}
         {do
            ($pcfg {game get_player_config {game get leader_num}})
            {if {!= {{$pcfg get_char} get_instrument} {$pcfg get_controller_sym}}
               {print "wrong instrument detected. prefab time!"}
               {set [real_char] {$pcfg get_char}}
               {$pcfg set_char
                  {available_prefab {game get leader_num} {$pcfg get_controller_sym}}
               }
            }
            {$pcfg set_track_type {{$pcfg get_char} get_instrument}}
         }
         {session add_sink $this}
         {{game get_player_config {game get leader_num}} set_ready TRUE}
      }
      kDataUnhandled
   )
   (start_loading_msg {ui goto_screen loading_screen})
   (SELECT_MSG
      {switch {event.lst selected_sym}
         (unlock
            {{tour solo_event_provider} set mode kTourVenueUnlock}
            {$this select_first_unplayed}
            {$this refresh}
            {$this play_preview}
         )
         (download
            {if_else {gamemode get is_permadeath}
               {overshell_ok_msg show perma_no_dlc}
               {do 
                  {{tour solo_event_provider} set mode kTourVenueDownload}
                  {$this refresh}
                  {$this play_preview}
               }
            }
         )
      }
   )
}
{new UIScreen
   tour_solo_event_screen
   (panels meta tour_world_bg_panel tour_solo_event_panel permadeath_info_panel helpbar fx)
   (focus tour_solo_event_panel)
   (back tour_solo_hub_screen)
   (helpbar (helpbar_back helpbar_select))
}
{new UIPanel
   tour_solo_endgame_panel
   (file "tour_solo_endgame.milo")
   (focus continue.btn)
   ENDGAME_PANEL_HANDLERS
   (enter
      {platform_mgr set_notify_ui_location kOSNotifyBottomCenter}
      {$this set_results}
      {$this submit_achievements}
      {if {gamemode get is_permadeath}
         {permadeath_mgr add_event
            {if_else {{get_track_panel} exists perma_callback}
               {{{get_track_panel} find perma_callback} get gems_hit}
               {print "i sure wonder how you completed a song without the track extending"}
            }
         }
      }
   )
   (exit {platform_mgr set_notify_ui_location kOSNotifyTopRight})
   (SELECT_MSG {ui goto_screen tour_solo_gigcomplete_screen})
}
{new UIScreen
   tour_solo_endgame_screen
   (panels tour_solo_endgame_panel permadeath_info_panel helpbar)
   (focus tour_solo_endgame_panel)
   (helpbar ('' helpbar_finishsong))
}
{new UIPanel
   tour_solo_gigcomplete_panel
   (file "tour_solo_gigcomplete.milo")
   (focus continue.btn)
   LIMIT_TO_LEADER_SESSION
   (enter
      {icons.grp set_frame 0}
      {platform_mgr set_notify_ui_location kOSNotifyBottomCenter}
      {do
         ($tp {tour performer})
         ($performer {beatmatch active_player 0})
         ($event {tour event})
         {stars.lbl set_localized {$performer star_rating}}
         {score.lbl set_localized {fmt_score {$performer score}}}
         {money.lbl set_localized
            {sprintf {localize tour_solo_reward} {fmt_money {$tp reward}}}
         }
         {do
            ($instrument {$tp get_instrument})
            ($gender {$tp get_gender})
            ($category {$event unlock_category $instrument $gender})
            ($outfit {$event unlock_outfit $instrument $gender})
            ($line_idx 0)
            {if
               {&&
                  {!= $category ''}
                  {!
                     {$tp has_outfit $category $outfit}
                  }
               }
               {{$this icon $line_idx} set_showing TRUE}
               {{$this icon $line_idx} set_mat icon_outfit.mat}
               {{$this line $line_idx} set_showing TRUE}
               {{$this line $line_idx} set_localized
                  {sprintf
                     {localize
                        {if_else
                           {'||'
                              {== $category guitar}
                              {== $category drum}
                              {== $category bass}
                              {== $category mic}
                           }
                           tour_solo_instrument
                           tour_solo_outfit
                        }
                     }
                     {localize_token
                        {shop find_token $gender $category $outfit}
                     }
                  }
               }
               {'++' $line_idx}
            }
            {{tour performer} complete_event}
            {cond
               ({!=
                     {$tp new_town}
                     ''}
                  {{$this icon $line_idx} set_showing TRUE}
                  {{$this icon $line_idx} set_mat icon_newtown.mat}
                  {{$this line $line_idx} set_showing TRUE}
                  {{$this line $line_idx} set_localized
                     {sprintf {localize tour_endgame_newtown} {localize {$tp new_town}}}
                  }
                  {'++' $line_idx}
               )
               ({!=
                     {$tp new_unlock}
                     ''}
                  {{$this icon $line_idx} set_showing TRUE}
                  {{$this icon $line_idx} set_mat icon_newtown.mat}
                  {{$this line $line_idx} set_showing TRUE}
                  {{$this line $line_idx} set_localized
                     {sprintf
                        {localize tour_solo_newsong}
                        {song_mgr song_name {$tp new_unlock}}
                     }
                  }
                  {'++' $line_idx}
               )
            }
            {foreach_int $i $line_idx 2
               {{$this icon $i} set_showing FALSE}
               {{$this line $i} set_showing FALSE}
            }
         }
         {log_tour "EVENT   " {sprintf "WON $%d" {{tour performer} reward}}}
         {log_tour "EVENT   " {sprintf "WON *x%d" {$performer num_stars}}}
         {foreach $venue (big_club theater arena)
            {if {$tp is_venue_type_unlocked $venue}
               {achievements submit
                  {game get leader_num}
                  {symbol {sprintf "ach_solo_venue_%s" $venue}}
               }
            }
         }
      }
   )
   (exit {platform_mgr set_notify_ui_location kOSNotifyTopRight})
   (line
      ($idx)
      {sprintf "line%i.lbl" $idx}
   )
   (icon
      ($idx)
      {sprintf "icon%i.mesh" $idx}
   )
   (SELECT_START_MSG
      {ui goto_screen
         {if_else {tour get win_sequence}
            meta_loading_tour_win_screen
            meta_loading_continue_screen
         }
      }
      kDataUnhandled
   )
}
{new UIScreen
   tour_solo_gigcomplete_screen
   (panels tour_solo_gigcomplete_panel permadeath_info_panel helpbar)
   (focus tour_solo_gigcomplete_panel)
   (helpbar ('' helpbar_returntomap))
}
#define SOLO_TOUR_ACHIEVEMENT (
   (award_solo_tour_achievement
      {achievements submit
         {game get leader_num}
         {symbol
            {sprintf
               "ach_solo_%s_%s"
               {{tour performer} get_instrument}
               {{game get_player_config {game get leader_num}} get_difficulty_sym}
            }
         }
      }
   )
)
