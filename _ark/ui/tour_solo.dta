#define SOLO_TOUR_NEW_TOWN_UPDATE (
   {do
      ($town {{tour performer} new_town})
      {if {!= $town ''}
         {{tour performer} set_town $town}
         {{tour solo_event_provider} refresh}
         {{tour performer} set_event
            {{tour solo_event_provider} first_event $town}
            {game get leader_num}
         }
      }
   }
)
{new UIPanel
   tour_solo_newtown_panel
   (file "tour_solo_newtown.milo")
   TOUR_HINT_PANEL_HANDLERS
   (enter
      SOLO_TOUR_NEW_TOWN_UPDATE
      {town.lbl set_localized
         {sprintf
            {localize tour_solo_unlocked}
            {localize_token {{tour performer} new_town}}
         }
      }
   )
}
{new UIScreen
   tour_solo_newtown_screen
   (panels meta tour_solo_newtown_panel helpbar fx)
   (focus tour_solo_newtown_panel)
   (helpbar ('' helpbar_continue))
}
{new UIPanel
   tour_solo_newunlock_panel
   (file "tour_solo_newsong.milo")
   TOUR_HINT_PANEL_HANDLERS
   (enter
      {do
         ($town {{tour performer} unlock_town})
         {{tour performer} set_town $town}
         {{tour solo_event_provider} set mode kTourVenueUnlock}
         {{tour solo_event_provider} refresh}
         {{tour performer} set_event
            {{tour solo_event_provider} last_event $town}
            {game get leader_num}
         }
         {town.lbl set_localized
            {sprintf
               {localize tour_solo_newsong}
               {song_mgr song_name {{tour performer} new_unlock}}
            }
         }
      }
   )
}
{new UIScreen
   tour_solo_newunlock_screen
   (panels meta tour_solo_newunlock_panel helpbar fx)
   (focus tour_solo_newunlock_panel)
   (helpbar ('' helpbar_continue))
}
