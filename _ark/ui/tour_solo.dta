{new CharLoadingPanel
   tour_solo_char_panel
   (file "tour_solo_char.milo")
   (focus char.lst)
   (reset_focus TRUE)
   LIMIT_TO_LEADER_SESSION
   (char_provider {object ""})
   (to_sel ())
   (enter
      {band_ui_sink set_controller_level kControllerLevelSession}
      {do
         ($pcfg {game get_player_config {game get leader_num}})
         {$pcfg set_char 0}
         {gamertag.lbl set_localized {$pcfg get player_name}}
         {instrument.lbl set_localized
            {get_font_char_from_controller_type {$pcfg get_controller_type}}
         }
         {set [char_provider] {get_solo_char_provider {game get leader_num}}}
         {if_else {gamemode get is_permadeath}
            {[char_provider] set_instrument_filter {$pcfg get_controller_sym}}
            {[char_provider] set_instrument_filter ''}
         }
         {char.lst set_provider [char_provider]}
         {if {gamemode get is_permadeath}
            {permadeath_mgr init}
            {do
               ($max 0)
               ($a {eval_array (char_provider_create_new)})
               ($ia {array 1})
               {while {== {char.lst selected_pos} $max}
                  {++ $max}
                  {char.lst set_selected $max}
               }
               {if $max
                  {foreach_int $i 1 $max
                     {if
                        {&&
                           {permadeath_mgr is_char_perma {[char_provider] get_char $i}}
                           {== {{[char_provider] get_char $i} get_instrument} {$pcfg get_controller_sym}}
                        }
                        {push_back $a {char_data get_char_name}}
                        {push_back $ia $i}
                     }
                  }
               }
               {set [to_sel] $ia}
               {char_perma.lst set_data $a}
            }
         }
         {do
            ($char_pos {[char_provider] get_pos_from_char {$pcfg get_char}})
            {unless {== $char_pos -1}
               {char.lst set_selected $char_pos}
               {if {gamemode get is_permadeath}
                  {char_perma.lst set_selected {get_elem [to_pos] $char_pos}}
               }
            }
         }
         {band_ui_sink enable_lefty_override {$pcfg get player_num} TRUE}
      }
      {$this set_gender FALSE}
      {$this update}
      {tour_solo_event_panel set real_char FALSE}
   )
   (exit
      {set [to_sel] ()}
      {do
         ($pcfg {game get_player_config {game get leader_num}})
         {band_ui_sink enable_lefty_override {$pcfg get player_num} FALSE}
      }
   )
   (unload {charcreator_panel free_all})
   (update
      {if {gamemode get is_permadeath}
         {char.lst set_selected
            {elem [to_sel] {char_perma.lst selected_pos}}
         }
      }
      {do
         ($pos {char.lst selected_pos})
         ($pcfg {game get_player_config {game get leader_num}})
         ($char
            {if_else {[char_provider] is_create_new $pos}
               0
               {[char_provider] get_char $pos}
            }
         )
         {$pcfg set_char $char}
         {if $char
            {char_cache request {game get leader_num} {$pcfg get_char}}
         }
      }
   )
   (SCROLL_MSG {$this update})
   (FOCUS_MSG
      {if_else {'||' {== male.btn $new_focus} {== female.btn $new_focus}}
         {charcreator_panel request
            {game get leader_num}
            {basename {$new_focus name}}
         }
         {charcreator_panel free {game get leader_num}}
      }
   )
   (SELECT_MSG
      {if_else {find_elem (char.lst char_perma.lst) $component}
         {if_else {[char_provider] is_create_new {char.lst selected_pos}}
            {if_else
               {profile_mgr can_player_create_char
                  {game get leader_num}
                  {{game get_player_config {game get leader_num}} get_controller_sym}
               }
               {$this set_gender TRUE}
               {ui push_screen tour_solo_char_no_room_screen}
            }
            {do
               ($is_char_perma
                  {permadeath_mgr is_char_perma
                     {{game get_player_config {game get leader_num}} get_char}
                  }
               )
               ($won
                  {if $is_char_perma
                     {permadeath_mgr load_data}
                     {permadeath_mgr won}
                  }
               )
               {cond
                  ({&& {gamemode get is_permadeath} $is_char_perma}
                     {tour_solo_hub_panel set reset TRUE}
                     {ui goto_screen {gamemode get post_matchmaking_screen}}
                  )
                  ({gamemode get is_permadeath}
                     {print "char not perma!!"}
                  )
                  ({&& $is_char_perma {! $won}}
                     {overshell_ok_msg show perma_w_or_l}
                  )
                  (TRUE
                     {tour_solo_hub_panel set reset TRUE}
                     {ui goto_screen {gamemode get post_matchmaking_screen}}
                  )
               }
            }
         }
         {do
            {charcreator_panel set char_player_num {game get leader_num}}
            {ui goto_screen charcreator_maker_screen}
         }
      }
   )
   (set_gender
      ($enable)
      {char.grp set_showing {! $enable}}
      {gender.grp set_showing $enable}
      {$this set_focus
         {if_else $enable
            male.btn
            {if_else {gamemode get is_permadeath}
               char_perma.lst
               char.lst
            }
         }
      }
   )
   (finish_load
      {if {gamemode get is_permadeath}
         {new BandList char_perma.lst}
         {char_perma.lst copy char.lst 0}
         {char_perma.lst set_type perma_char_chooser}
         {char.grp add_object char_perma.lst}
         {char.lst set_showing FALSE}
         {$this sync_objects}
      }
   )
}
{new UIScreen
   tour_solo_char_screen
   (panels
      meta
      practice_space_panel
      tour_solo_char_panel
      tour_band_lower3rd_panel
      helpbar
      fx
   )
   (helpbar (helpbar_back helpbar_select))
   (focus tour_solo_char_panel)
   (back main_solomode_screen)
   (enter
      {practice_space_panel select_cam "solo_enter"}
      {char_cache cache_update}
   )
   (BUTTON_DOWN_MSG
      {if_else {&& {== $button kPad_Tri} {{tour_solo_char_panel find gender.grp} showing}}
         {tour_solo_char_panel set_gender FALSE}
         kDataUnhandled
      }
   )
   (show_char
      ($player_num)
      {with tour_solo_char_panel
         {'||'
            {!= {$this focus_name} char.lst}
            {! {[char_provider] is_create_new {char.lst selected_pos}}}
         }
      }
   )
}
{new UIScreen
   tour_solo_char_no_room_screen
   (panels dialog_panel)
   (focus dialog_panel)
   (enter
      {dialog_panel set_ok
         {sprintf
            {localize_token charcreator_no_more_chars_fmt}
            {profile_mgr get_max_chars_per_inst}
         }
      }
      {dialog_panel set limit session}
   )
   (SELECT_MSG {ui pop_screen})
}
{new UIPanel
   tour_solo_diff_panel
   (file "tour_solo_diff.milo")
   LIMIT_TO_LEADER_SESSION
   (load {content_mgr start_refresh})
   (is_loaded {content_mgr refresh_done})
   (enter {$this refresh})
   (refresh
      {if {gamemode get is_permadeath}
         {foreach $btn (easy.btn medium.btn hard.btn)
            {$this disable $btn}
         }
      }
      {do
         ($pcfg {game get_player_config {game get leader_num}})
         ($char {$pcfg get_char})
         {$this set_focus {sprintf "%s.btn" {{$pcfg get_char} solo_difficulty_sym}}}
         {foreach $diff (DIFF_SYMBOLS)
            {{sprintf
                  "%s_progress.lbl"
                  $diff} set_localized
               {fmt_songs_played {$char world_fame $diff} {$char total_world_fame $diff}}
            }
         }
      }
   )
   (SELECT_START_MSG
      {do
         ($pcfg {game get_player_config {game get leader_num}})
         ($diff {basename {$component name}})
         {$pcfg set_difficulty $diff}
         {{$pcfg get_char} set_solo_difficulty $diff}
      }
      {{tour solo_event_provider} set mode kTourVenueNormal}
      {if {tour hint}
         {fx fade_out}
      }
      {ui goto_screen
         {if_else {tour hint}
            {{tour hint} get screen}
            tour_solo_event_screen
         }
      }
      kDataUnhandled
   )
}
{new UIScreen
   tour_solo_diff_screen
   (panels
      meta
      practice_space_panel
      tour_solo_diff_panel
      tour_band_lower3rd_panel
      permadeath_info_panel
      helpbar
      fx
   )
   (helpbar (helpbar_back helpbar_select))
   (focus tour_solo_diff_panel)
   (back tour_solo_hub_screen)
}
{new CharLoadingPanel
   tour_solo_hub_panel
   (file tour_solo_hub.milo)
   (reset TRUE)
   LIMIT_TO_LEADER_SESSION
   (enter
      {if {tour_solo_event_panel get real_char}
         {{game get_player_config {game get leader_num}} set_char {tour_solo_event_panel get real_char}}
      }
      {if [reset]
         {$this set_focus gigguide.btn}
      }
      {set [reset] FALSE}
      {$this refresh}
      {if {gamemode get is_permadeath}
         {if_else {permadeath_mgr is_char_perma {tour performer}}
            {permadeath_mgr load_data}
            {ui push_screen permadeath_setup_screen}
         }
      }
   )
   (TRANSITION_COMPLETE_MSG {autosave})
   (refresh
      {do
         ($char {{game get_player_config {game get leader_num}} get_char})
         {tour set_performer $char}
         {name.lbl set_localized {$char get_char_name}}
         {part.lbl set_localized {$char instrument_icon}}
         {money.lbl set_localized {fmt_money {$char money}}}
         {tour_score.lbl set_localized
            {sprintf {localize tour_solo_tour_score} {fmt_score {$char tour_score}}}
         }
      }
   )
   (SELECT_START_MSG
      {switch $component
         (gigguide.btn
            {if_else {gamecfg is_missing_mic $player_num FALSE}
               {do
                  {vocalist_must_have_mic_screen set message solo_vocalist_needs_mic}
                  {ui push_screen vocalist_must_have_mic_screen}
               }
               {ui goto_screen tour_solo_diff_screen}
            }
         )
         (rokkshoppe.btn
            {shop_char_panel set char_player_num $player_num}
            {shop_panel set reset_on_enter TRUE}
            {ui goto_screen shop_screen}
         )
         (playerprofile.btn
            {tour_char_profile_panel set player_num $player_num}
            {tour_char_profile_panel set profile_player_num $player_num}
            {ui goto_screen tour_solo_char_profile_screen}
         )
         (community.btn
            {if_else {server is_connected}
               {do
                  {leaderboards_netwatcher_panel set return_screen tour_solo_hub_screen}
                  {ui goto_screen tour_hub_community_screen}
               }
               {ui push_screen leaderboards_not_available_screen}
            }
         )
      }
      kDataUnhandled
   )
}
{new UIScreen
   tour_solo_hub_screen
   (panels
      meta
      practice_space_panel
      tour_solo_hub_panel
      tour_band_lower3rd_panel
      permadeath_info_panel
      helpbar
      fx
   )
   (helpbar (helpbar_back helpbar_select))
   (focus tour_solo_hub_panel)
   (back {gamemode get matchmaking_screen})
   (enter
      {presence_mgr set_prepare_to_rock}
      {practice_space_panel select_cam solo_enter}
   )
}
{new CharProfilePanel
   tour_char_profile_panel
   (file tour_char_profile.milo)
   (focus motto.btn)
   (player_num -1)
   (profile_player_num -1)
   (enter
      {$this set_char
         {{gamecfg get_player_config [profile_player_num]} get_char}
      }
      {$this disable topsongs.btn}
      {do
         ($is_local {$this is_local})
         {$this disable motto.btn}
         {motto.btn set_showing FALSE}
         {motto.lbl set_showing FALSE}
         {if_else $is_local
            {do
               {bands.lst set_provider {$this get_char_band_provider}}
               {song.lst set_provider {$this get_top_five_provider}}
               {if_else {> {$this get_band_count} 0}
                  {do
                     {$this enable bands.btn}
                     {bands.btn set_showing TRUE}
                     {bands.lst set_showing TRUE}
                     {if {<= {$this get_band_count} {bands.lst num_display}}
                        {$this disable bands.btn}
                     }
                  }
                  {do
                     {bands.btn set_showing FALSE}
                     {$this disable bands.btn}
                     {bands.lst set_showing FALSE}
                  }
               }
               {topsongs.btn set_showing TRUE}
               {song.lst set_showing TRUE}
            }
            {do
               {$this disable bands.btn}
               {bands.btn set_showing FALSE}
               {topsongs.btn set_showing FALSE}
               {bands.lst set_showing FALSE}
               {song.lst set_showing FALSE}
            }
         }
      }
      {char_name.lbl set_localized {$this get_char_name}}
      {gamertag.lbl set_localized {$this get_gamertag}}
      {cash.lbl set_localized {fmt_money {$this get_money}}}
      {motto.lbl set_localized {$this get_motto}}
      {instrument.lbl set_localized {$this get_instrument_icon}}
   )
   (exit {show_network_busy_icon FALSE})
   (SELECT_MSG
      {switch $component
         (motto.btn
            {platform_mgr show_keyboard
               $player_num
               {get_motto_length}
               {localize tour_char_profile_vk_motto_title}
               {localize tour_char_profile_vk_motto_desc}
               {$this get_motto}
               $this
            }
         )
         (bands.btn {$this set_focus bands.lst})
         (bands.lst {$this set_focus bands.btn})
      }
   )
   (VIRTUAL_KEYBOARD_RESULT_MSG
      {if {&& $ok $this {ui focus_panel} {== {ui focus_panel} $this}}
         {$this set_motto $text}
         {motto.lbl set_localized $text}
         {show_network_busy_icon TRUE}
         {entity_uploader verify_band_motto $text $this}
      }
   )
   (BUTTON_DOWN_MSG
      {cond
         ({is_network_busy} TRUE)
         ({== $button kPad_Tri}
            {if_else {== {$this focus_name} bands.lst}
               {do
                  {$this set_focus bands.btn}
                  TRUE
               }
               kDataUnhandled
            }
         )
         (TRUE kDataUnhandled)
      }
   )
   (ROCK_CENTRAL_OP_COMPLETE_MSG
      {show_network_busy_icon FALSE}
      {switch $arg1
         (RB_RETCODE_BAND_MOTTO_PROFANE
            {ui push_screen tour_char_motto_profane_screen}
         )
         (RB_RETCODE_BAND_MOTTO_IP {ui push_screen tour_char_motto_ip_screen})
      }
   )
}
