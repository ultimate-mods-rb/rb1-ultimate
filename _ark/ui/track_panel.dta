#define TRACK_END_FRAME (1920)
#define TRACK_PANEL_HANDLERS (
   (enter
      {game add_sink $this}
      {$this set_showing {if_else $nohud FALSE {gamemode get show_track}}}
   )
   (exit {game remove_sink $this})
   (unison_hit)
   (unison_miss)
   (set_track_out)
   (set_track_in)
   (animate_track ($start $end $period $units))
   (animate_track_out)
   (animate_track_out_fast)
   (animate_track_in_fast)
   (finish_load {do
      ($pro_drums {new RndDir pro_drums})
      {$pro_drums insert (subdirs 0) "ulti/track/pro_drums.milo"}
      {$this iterate TrackDir $dir
         {with $dir
            {foreach $wid
               (
                  dynamic_crash_gem_cymbal.wid
                  dynamic_crash_gem_cymbal_lefty.wid
                  cymbal_gem_star.wid
                  cymbal_gem_red.wid
                  cymbal_gem_yellow.wid
                  cymbal_gem_blue.wid
                  cymbal_gem_green.wid
                  cymbal_gem_orange.wid
               )
               {{new TrackWidget $wid} copy drum_red.wid 0}
               {drum_gems.grp insert (objects 5) $wid}
            }
            {foreach $color (red yellow blue green orange) {do
               ($wid {sprintf "cymbal_gem_%s.wid" $color})
               {clear_array $wid meshes}
               {$wid insert (meshes 0) {$pro_drums find {sprintf "cymbal_gem_%s.mesh" $color}}}
            }}

            {clear_array cymbal_gem_star.wid meshes}
            {cymbal_gem_star.wid insert (meshes 0) {$pro_drums find cymbal_gem_style.mesh}}

            {clear_array dynamic_crash_gem_cymbal.wid meshes}
            {dynamic_crash_gem_cymbal.wid insert (meshes 0) {$pro_drums find cymbal_gem_green.mesh}}

            {clear_array dynamic_crash_gem_cymbal_lefty.wid meshes}
            {dynamic_crash_gem_cymbal_lefty.wid insert (meshes 0) {$pro_drums find cymbal_gem_red.mesh}}

            {gem_miss.wid set (meshes 0) prism_gem_stepped_miss.mesh}
            {gem_miss_hopo.wid set (meshes 0) prism_gem_hopo_miss.mesh}
            {drum_miss.wid set (meshes 0) prism_gem_drum_miss.mesh}
            {$this sync_objects}
         }
      }
      {if $notergb
         {with {dust.tex dir}
            {$this insert (subdirs 0) "ulti/track/rgb_tex.milo"}
            {foreach $t ; due to annoying propanim stuff
               (
                  square_smasher_bright_green.tex
                  square_smasher_bright_red.tex
                  square_smasher_bright_yellow.tex
                  square_smasher_bright_blue.tex
                  square_smasher_bright_orange.tex
               )
               {$t set_bitmap "ulti/track/smashers/smasher_bright.png"}
            }
         }
         {asset_mgr apply_default_rgb}
      }
      {asset_mgr load_gems}
      {asset_mgr load_smashers}
      {if $notergb
         {asset_mgr apply_all_rgb}
      }
      {asset_mgr apply_config}
      {cond
         ({exists vocals} ;coop
            {player_feedback_01 insert (subdirs 0) "ulti/track/countdown_0.milo"}
            {player_feedback_02 insert (subdirs 0) "ulti/track/countdown_1.milo"}
            {player_feedback_03 insert (subdirs 0) "ulti/track/countdown_2.milo"}
            {{vocals get failed_feedback} insert (subdirs 0) "ulti/track/countdown_3.milo"}
         )
         ({exists guitar_fx_0} ; h2h
            {player_feedback_01 insert (subdirs 0) "ulti/track/countdown_0.milo"}
            {player_feedback_02 insert (subdirs 0) "ulti/track/countdown_1.milo"}
         )
         (TRUE ;h2h vox
            {{track_0 get failed_feedback} insert (subdirs 0) "ulti/track/countdown_0.milo"}
            {{track_1 get failed_feedback} insert (subdirs 0) "ulti/track/countdown_1.milo"}
         )
      }
      {if {exists scoreboard}
         {with scoreboard
            {new Text timer.txt}
            {timer.txt copy score.txt 0}
            {timer.txt set_font 'avantgarde.font'}
            {if_else {is_vocals_on_top}
               {timer.txt set_local_pos 9.07 -0.00 -3.00}
               {timer.txt set_local_pos 9.07 -0.00 5.80}
            }
            {timer.txt set_local_scale 0.8 0 0.8}
            {timer.txt set_text ""}
            {{{get_track_panel} loaded_dir} set timer {object timer.txt}}
            {$this sync_objects}
         }
      }
      {$this set_showing FALSE}
      {$this set_track_out}
   })
   (intro_start
      {$this reset}
      {$this set_showing {if_else $nohud FALSE {gamemode get show_track}}}
      {$this set_track_in}
   )
   (intro_skip
      {$this reset}
      {$this set_showing {if_else $nohud FALSE {gamemode get show_track}}}
      {$this set_track_out}
      {$this play_intro}
      {$this do_stuff}
   )
   (on_reset
      {beatmatch foreach_active_player $m
         {$m on_new_track}
         {{$m track} init {$m track}}
      }
      {{$this loaded_dir} reset}
   )
   (on_extend
      {$this do_stuff}
      {$this play_intro}
      {if {&& {exists gamemode} {gamemode get play_track_intro_sfx}}
         {synth play track_beg.cue}
      }
   )
   (poll
      {if
         {||
            {&& $nofail {! {gamemode get is_tour}} {== {session mode} kNetLocal}}
            {gamemode get is_jukebox}
         }
         {beatmatch foreach_active_player $player
            {$player set_crowd_rating 0.66}
         }
      }
      {unless {&& {gamemode get is_practice} {gamecfg get practice_speed}}
         {beatmatch set_music_speed {get_song_speed}}
      }
      {if {&& {world_movie_panel is_active} {game paused}} ; MoviePanel::Poll doesn't call UIPanel::Poll :(
         {game set_paused FALSE}
      }
   )
   (do_stuff
      {if {gems_dir exists animate.trig}
         {{gems_dir find animate.trig} trigger}
      }
      {if $notergb
         {asset_mgr apply_all_rgb}
      }
      {beatmatch foreach_active_player $player ;handle adding the appropriate callbacks to each player
         {if_else {== {$player instrument} vocals}
            {if_else $micdeploy
               {$player set_scream_thresholds 0.1 0.39}
               {$player set_scream_thresholds 1.1 0.39}
            }
            {$player force_solo FALSE}
         }
         {if_else {gamemode get is_autoplay}
            {do
               ($track {get_dir_from_player $player})
               ($dir
                  {if_else {== {type {$track get streak_meter}} kDataSymbol}
                     {$track find {$track get streak_meter}}
                     {$track get streak_meter}
                  }
               )
               {{$dir find meter_wipe.mesh} set_showing FALSE}
            }
            {do
               ($obj {sprint {$player track} "_track_callback"})
               {if {exists $obj} {delete $obj}}
               {new Object $obj}
               {$obj set_type track_callback}
               {$obj init $player}
            }
         }
         {unless {|| {! $countdown} {gamemode get is_practice} {gamemode get is_drum_trainer}}
            {do
               ($obj {sprint {$player track} "_countdown"})
               ($track {get_dir_from_player $player})
               ($dir
                  {cond
                     ({&& {$track has (player_feedback)} {!= {$player instrument} vocals}}
                        {$track get player_feedback}
                     )
                     ({== {$player instrument} vocals}
                        {$track find failed_feedback}
                     )
                     (TRUE {fail "wtf did you do to get here? countdown failed"})
                  }
               )
               {if {exists $obj} {delete $obj}}
               {new Object $obj}
               {$obj set_type countdown}
               {$obj init $player $dir}
            }
         }
         {if {gamemode get is_permadeath}
            {do
               ($obj "perma_callback")
               {if {exists $obj} {delete $obj}}
               {new Object $obj}
               {$obj set_type perma_callback}
               {$obj init $player}
            }
         }
      }
   )
)
{new TrackPanel
   coop_track_panel
   (file ../track/trackpanel.milo)
   TRACK_PANEL_HANDLERS
}
{new TrackPanel
   hth_track_panel
   (file
      {if_else {== {{game get_participant_config 0} get_track_sym} vocals}
         ../track/trackpanel_hth_vocals.milo
         ../track/trackpanel_hth.milo
      }
   )
   TRACK_PANEL_HANDLERS
}
{func get_track_panel
   {gamemode get track_panel}
}
{set $playback_file ""}
{set $fonixout_file ""}