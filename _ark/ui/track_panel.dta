#define TRACK_END_FRAME (1920)
#define TRACK_PANEL_HANDLERS (
   (enter
      {game add_sink $this}
      {$this set_showing {if_else $nohud FALSE {gamemode get show_track}}}
   )
   (exit {game remove_sink $this})
   (unison_hit)
   (unison_miss)
   (set_track_out)
   (set_track_in)
   (animate_track ($start $end $period $units))
   (animate_track_out)
   (animate_track_out_fast)
   (animate_track_in_fast)
   (finish_load
      ; apply lane colors in sane way :D
      {$this iterate TrackDir $dir
         {with $dir
            {foreach_int $i 0 5
               {{new PropAnim {sprintf "gem_bak%d.anim" $i}} copy {sprintf "gem_mash%d.anim" $i} 0}
            }
            {foreach_int $i 0 5 {do
               ($wid {sprintf "gem_mash%d.wid" $i})
               ($color {eval_var {sprint gtrsm {+ $i 1}}})
               {clear_array $wid meshes}
               {$wid insert (meshes 0) {sprintf "gem_mash%d.mesh" $color}}
               {{sprintf "gem_mash%d.anim" $i} copy {sprintf "gem_bak%d.anim" $color} 0}
            }}
            {foreach_int $i 1 5
               {{new PropAnim {sprintf "drum_bak%d.anim" $i}} copy {sprintf "drum_mash%d.anim" $i} 0}
               {{new PropAnim {sprintf "drum_bak%d_BRE.anim" $i}} copy {sprintf "drum_mash%d_BRE.anim" $i} 0}
            }
            {foreach_int $i 1 5 {do
               ($wid {sprintf "drum_mash%d.wid" $i})
               ($color
                  {switch {eval_var {sprint drms $i}}
                     (0 4)
                     {eval_var {sprint drms $i}}
                  }
               )
               {clear_array $wid meshes}
               {$wid insert (meshes 0) {sprintf "drum_mash%d.mesh" $color}}
               {{sprintf "drum_mash%d.anim" $i} copy {sprintf "drum_bak%d.anim" $color} 0}
               {{sprintf "drum_mash%d_BRE.anim" $i} copy {sprintf "drum_bak%d_BRE.anim" $color} 0}
            }}
            {foreach $wid
               (
                  dynamic_crash_gem_cymbal.wid
                  dynamic_crash_gem_cymbal_lefty.wid
                  cymbal_gem_star.wid
                  cymbal_gem_red.wid
                  cymbal_gem_yellow.wid
                  cymbal_gem_blue.wid
                  cymbal_gem_green.wid
                  cymbal_gem_orange.wid
               )
               {{new TrackWidget $wid} copy drum_red.wid 0}
               {drum_gems.grp add_object $wid}
            }
         }
      }
      {do
         ($gems_dir {new RndDir gems_dir})
         {switch $gems
            #include ../ulti/track/gems/gems_scripting.dta
         }
      }
      {cond
         ({exists vocals} ;coop
            {player_feedback_01 insert (subdirs 0) "ulti/track/countdown_0.milo"}
            {player_feedback_02 insert (subdirs 0) "ulti/track/countdown_1.milo"}
            {player_feedback_03 insert (subdirs 0) "ulti/track/countdown_2.milo"}
            {{vocals get failed_feedback} insert (subdirs 0) "ulti/track/countdown_3.milo"}
         )
         ({exists guitar_fx_0} ; h2h
            {player_feedback_01 insert (subdirs 0) "ulti/track/countdown_0.milo"}
            {player_feedback_02 insert (subdirs 0) "ulti/track/countdown_1.milo"}
         )
         (TRUE ;h2h vox
            {{track_0 get failed_feedback} insert (subdirs 0) "ulti/track/countdown_0.milo"}
            {{track_1 get failed_feedback} insert (subdirs 0) "ulti/track/countdown_1.milo"}
         )
      }
      {if {exists scoreboard}
         {with scoreboard
            {new Text timer.txt}
            {timer.txt copy score.txt 0}
            {timer.txt set_font 'avantgarde.font'}
            {if_else {is_vocals_on_top}
               {timer.txt set_local_pos 9.07 -0.00 -3.00}
               {timer.txt set_local_pos 9.07 -0.00 5.80}
            }
            {timer.txt set_local_scale 0.8 0 0.8}
            {timer.txt set_text ""}
            {{{get_track_panel} loaded_dir} set timer {object timer.txt}}
            {$this sync_objects}
         }
      }
      {$this set_showing FALSE}
      {$this set_track_out}
   )
   (intro_start
      {$this reset}
      {$this set_showing {if_else $nohud FALSE {gamemode get show_track}}}
      {$this set_track_in}
   )
   (intro_skip
      {$this reset}
      {$this set_showing {if_else $nohud FALSE {gamemode get show_track}}}
      {$this set_track_out}
      {$this play_intro}
   )
   (on_reset
      {beatmatch foreach_active_player $m
         {$m on_new_track}
         {{$m track} init {$m track}}
      }
      {{$this loaded_dir} reset}
   )
   (on_extend
      {$this do_stuff}
      {$this play_intro}
      {if {&& {exists gamemode} {gamemode get play_track_intro_sfx}}
         {synth play track_beg.cue}
      }
   )
   (poll
      {if
         {||
            {&& $nofail {! {gamemode get is_tour}} {== {session mode} kNetLocal}}
            {gamemode get is_jukebox}
         }
         {beatmatch foreach_active_player $player
            {$player set_crowd_rating 0.66}
         }
      }
   )
   (do_stuff
      {if {gems_dir exists animate.trig}
         {{gems_dir find animate.trig} trigger}
      }
      {beatmatch foreach_active_player $player ;handle adding the appropriate callbacks to each player
         {if_else {gamemode get is_autoplay}
            {do
               {$player set_auto_play TRUE}
               {with {$this loaded_dir}
                  {unless {$this has (init)}
                     {$player toggle_no_fills}
                     {$this set init TRUE}
                  }
               }
            }
            {do
               ($obj {sprint {$player track} "_track_callback"})
               {if {exists $obj} {delete $obj}}
               {new Object $obj}
               {$obj set_type track_callback}
               {$obj init $player}
            }
         }
         {unless {|| {! $countdown} {gamemode get is_practice} {gamemode get is_drum_trainer}}
            {do
               ($obj {sprint {$player track} "_countdown"})
               ($track {get_dir_from_player $player})
               ($dir
                  {cond
                     ({&& {$track has (player_feedback)} {!= {$player instrument} vocals}}
                        {$track get player_feedback}
                     )
                     ({== {$player instrument} vocals}
                        {$track find failed_feedback}
                     )
                     (TRUE {fail "wtf did you do to get here? countdown failed"})
                  }
               )
               {if {exists $obj} {delete $obj}}
               {new Object $obj}
               {$obj set_type countdown}
               {$obj init $player $dir}
            }
         }
      }
   )
)
{new TrackPanel
   coop_track_panel
   (file ../track/trackpanel.milo)
   TRACK_PANEL_HANDLERS
}
{new TrackPanel
   hth_track_panel
   (file
      {if_else {== {{game get_participant_config 0} get_track_sym} vocals}
         ../track/trackpanel_hth_vocals.milo
         ../track/trackpanel_hth.milo
      }
   )
   TRACK_PANEL_HANDLERS
}
{func get_track_panel
   {gamemode get track_panel}
}
{set $playback_file ""}
{set $fonixout_file ""}