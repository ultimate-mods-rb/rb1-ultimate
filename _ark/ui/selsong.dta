#define COMMON_SONG_PREVIEW (
   (is_updown
      ($button)
      {'||'
         {== $button kPad_DDown}
         {== $button kPad_DUp}
         {== $button kPad_Circle}
         {== $button kPad_Square}
      }
   )
)
#define COMMON_SONG_SELECT (
   COMMON_SONG_PREVIEW
   (allow_player
      ($player_num)
      {cond
         ({gamemode get is_autoplay} TRUE)
         ({== [song_mode] leaderboards}
            {'||'
               {== {game get leader_num} -1}
               {game is_player_participating $player_num}
            }
         )
         (TRUE
            {&&
               {!= [sel_leader] -1}
               {gamecfg is_player_local [sel_leader]}
               {game is_player_participating $player_num}
            }
         )
      }
   )
   (exiting_sel_song FALSE)
   (old_list_pos 0)
   (inhibit_refresh FALSE)
   (focus ss_song.lst)
   (joypad
      (hold_ms 100)
      (repeat_ms 80)
   )
   (load
      {if {! [inhibit_refresh]}
         {content_mgr start_refresh}
      }
   )
   (is_loaded {content_mgr refresh_done})
   (enter
      {$this update_search_mode FALSE}
      {set [fast] {&& $fast_selsong {!= [song_mode] leaderboards}}}
      {band_ui_sink set_controller_level kControllerLevelSession}
      {if {|| {== [song_mode] leaderboards} {== {session mode} kNetLocal}}
         {song_mgr reset_shared_songs TRUE}
      }
      {platform_mgr add_sink $this storage_changed}
      {session add_sink $this change_game_msg}
      {$this set exiting_sel_song FALSE}
      {song_provider set_song_mode [song_mode]}
      {switch [song_mode]
         (game {{selsong_lower3rd_panel find event.lbl} set text_token ''})
         (practice {{selsong_lower3rd_panel find event.lbl} set text_token ''})
         (game_tour
            {if_else {&& {tour performer} {tour event}}
               {{selsong_lower3rd_panel find event.lbl} set_localized
                  {tour event_display_name}
               }
               {{selsong_lower3rd_panel find event.lbl} set text_token ''}
            }
         )
         (leaderboards {{selsong_lower3rd_panel find event.lbl} set text_token ''})
         {fail "Unknown song_mode\n"}
      }
      {if_else [fast]
         {do
            {$this update_fast_list}
            {$this set_focus song_fast.lst}
            {song_fast.lst set_showing TRUE}
            {ss_song.lst set_showing FALSE}
         }
         {do
            {ss_song.lst set_showing TRUE}
            {song_fast.lst set_showing FALSE}
            {ss_song.lst set_provider song_provider}
            {$this set_focus ss_song.lst}
         }
      }
      {meta music_stop}
      {platform_mgr disable_xmp}
      {if {is_leader_local}
         {$this sync_grouping_method}
      }
      {if {!= [song_mode] leaderboards}
         {$this select_first_selectable}
      }
      {if_else {== [song_mode] leaderboards}
         {if_else {!= {leaderboards get_song_sym} ''}
            {ss_song.lst set_selected {leaderboards get_song_sym}}
            {if
               {&&
                  {== {leaderboards get_type} kPlayerSong}
                  {== {leaderboards get_track_type_sym} bass}
               }
               {ss_song.lst set_selected 1 0}
            }
         }
         {if {&& game {!= {game get_song} ''}}
            {if_else [fast]
               {if {find_elem [data] {game get_song}}
                  {song_fast.lst set_selected {get_elem [data] {game get_song}}}
               }
               {if {! {ss_song.lst set_selected {game get_song} FALSE}}
                  {ss_song.lst set_selected random_song}
               }
            }
         }
      }
      {$this play_preview}
      {$this set old_list_pos
         {if_else [fast]
            {song_fast.lst selected_pos}
            {ss_song.lst selected_pos}
         }
      }
      {$this update_setlist_progress}
      {do
         ($highlit_song
            {if_else [fast]
               {if_else {song_fast.lst selected_pos}
                  {elem [data] {song_fast.lst selected_pos}}
                  random_song
               }
               {if_else {song_provider is_random {ss_song.lst selected_pos}}
                  random_song
                  {song_provider get_song_to_set {ss_song.lst selected_pos}}
               }
            }
         )
         {if {!= [song_mode] leaderboards}
            {session send_to_all
               {'`'
                  ({',' $this}
                     set_highlit_song
                     {',' $highlit_song}
                  )
               }
               kNetReliable
            }
         }
      }
      {$this update_filter {song_provider get_display}}
      {$this update_leader}
   )
   (exit
      {set [search_mode] FALSE}
      {set [sel_leader] -1}
      {set [hb] FALSE}
      {set [hbw] FALSE}
      {if {size [players]}
         {remove_elem [players] {get_elem [players] 0}}
      }
      {resize [results] 0}
      {resize [data] 0}
      {resize [titles] 0}
      {platform_mgr enable_xmp}
      {platform_mgr remove_sink $this storage_changed}
      {session remove_sink $this change_game_msg}
      {$this set exiting_sel_song TRUE}
      {song_preview ''}
      {$this set inhibit_refresh FALSE}
      {qp_selsong_panel set inhibit_refresh FALSE}
      {tour_selsong_panel set inhibit_refresh FALSE}
      {leaderboard_selsong_panel set inhibit_refresh FALSE}
   )
   (SELECT_START_MSG
      {if {$this try_save_song}
         {if_else {is_leader_local}
            {$this select_song}
            {session send_to_player
               {gamecfg get leader_num}
               {` ({, $this} select_song)}
               kNetReliable
            }
         }
      }
      kDataUnhandled
   )
   (storage_changed {band_ui_sink content_storage_changed})
   (CHANGE_GAME_MSG)
   (BUTTON_DOWN_MSG
      {cond
         ({$this is_updown $button}
            {if
               {!= {$this get old_list_pos}
                  {if_else [fast]
                     {song_fast.lst selected_pos}
                     {ss_song.lst selected_pos}
                  }
               }
               {$this set old_list_pos
                  {if_else [fast]
                     {song_fast.lst selected_pos}
                     {ss_song.lst selected_pos}
                  }
               }
               {song_preview ''}
            }
            kDataUnhandled
         )
         ({== $button kPad_Tri}
            {if_else [search_mode]
               {$this update_search_mode FALSE}
               {switch [song_mode]
                  (game
                     {ui goto_screen
                        {if_else {gamemode get skip_matchmaking}
                           {gamemode get main_mode_screen}
                           {gamemode get matchmaking_screen}
                        }
                        FALSE
                        TRUE
                     }
                  )
                  (practice {ui goto_screen training_menu_screen FALSE TRUE})
                  (game_tour
                     {{tour performer} set_event
                        {{tour event} get event_name}
                        {game get leader_num}
                     }
                     {ui goto_screen
                        {if_else {gamemode get is_solo}
                           tour_solo_event_screen
                           tour_band_event_screen
                        }
                     }
                     kDataUnhandled
                  )
                  (leaderboards
                     {ui goto_screen
                        {switch {leaderboards get_type}
                           (kPlayerSong leaderboards_seltrack_screen)
                           {gamemode get community_screen}
                        }
                        FALSE
                        TRUE
                     }
                  )
                  {fail "Unknown song_mode\n"}
               }
            }
         )
         ({== $button kPad_Select}
            {unless [search_mode]
               {synth play button_toggle}
               ;{$this switch_grouping}
               {band_ui_sink set_net_sync FALSE}
               {change_sort_panel set target $this}
               {ui push_screen change_sort_screen}
            }
         )
         ({== $button kPad_R1}
            {unless [search_mode]
               {synth play button_toggle}
               {if_else [fast]
                  {do
                     ($ix {song_fast.lst selected_pos})
                     ($b TRUE)
                     {while {&& {< $ix {size [data]}} $b}
                        {if {find_elem [titles] {elem [data] $ix}}
                           {set $b FALSE}
                        }
                        {++ $ix}
                     }
                     {if $b
                        {set $ix 2}
                     }
                     {song_fast.lst set_selected $ix {- $ix 1}}
                     {$this component_scroll 0 0}
                     {$this play_preview}
                     {if {!= [song_mode] leaderboards}
                        {session send_to_all {'`' ({',' $this} play_preview)} kNetReliable}
                     }
                  }
                  {do
                     ($ix {ss_song.lst selected_pos})
                     {while
                        {||
                           {song_provider is_active $ix}
                           {song_provider get_song_to_set $ix}
                        }
                        {++ $ix}
                     }
                     {if {! {song_provider is_active $ix}}
                        {ss_song.lst set_selected {+ $ix 1} $ix}
                        {if {!= {ss_song.lst selected_pos} {+ $ix 1}}
                           {ss_song.lst set_selected 2 1}
                        }
                        {$this component_scroll 0 0}
                        {$this play_preview}
                        {if {!= [song_mode] leaderboards}
                           {session send_to_all {'`' ({',' $this} play_preview)} kNetReliable}
                        }
                     }
                  }
               }
            }
         )
         ({== $button kPad_Start}
            {platform_mgr show_keyboard
               $player_num
               100
               {localize search_for_song}
               {localize search_for_song_desc}
               ''
               $this
            }
         )
         ({== $button kPad_DLeft}
            {{$this focus_name} scroll -6}
            {$this component_scroll 0 0}
            {song_preview ''}
         )
         ({== $button kPad_DRight}
            {{$this focus_name} scroll 6}
            {$this component_scroll 0 0}
            {song_preview ''}
         )
         (TRUE kDataUnhandled)
      }
   )
   (BUTTON_UP_MSG
      {script_task kTaskSeconds
         (delay 0.1)
         (script
            {if {&& {! {$this get exiting_sel_song}} {$this is_updown $button}}
               {$this play_preview}
               {if {!= [song_mode] leaderboards}
                  {session send_to_all {'`' ({',' $this} play_preview)} kNetReliable}
               }
            }
         )
      }
      kDataUnhandled
   )
   (SCROLL_MSG
      {if [search_mode]
         {if_else [fast]
            {song_fast.lst set_selected
               {get_elem [data] {elem [results] {song_search.lst selected_pos}}}
            }
            {ss_song.lst set_selected
               {elem [results] {song_search.lst selected_pos}}
            }
         }
      }
      {do
         ($highlit_song
            {if_else [fast]
               {if_else {song_fast.lst selected_pos}
                  {elem [data] {song_fast.lst selected_pos}}
                  random_song
               }
               {if_else {song_provider is_random {ss_song.lst selected_pos}}
                  random_song
                  {song_provider get_song_to_set {ss_song.lst selected_pos}}
               }
            }
         )
         {if {!= [song_mode] leaderboards}
            {session send_to_all
               {'`'
                  ({',' $this}
                     set_highlit_song
                     {',' $highlit_song}
                  )
               }
               kNetReliable
            }
         }
      }
   )
   (set_highlit_song
      ($song_symbol)
      {if {'||' {has_song $song_symbol} {== $song_symbol random_song}}
         {if_else [fast]
            {song_fast.lst set_selected {get_elem [data] $song_symbol}}
            {ss_song.lst set_selected $song_symbol}
         }
      }
   )
   (select_song
      {switch [song_mode]
         (game
            {if_else {&& $selectvenue {! {gamemode get online_play_required}}}
               {ui goto_screen qp_selvenue_screen}
               {if_else {gamemode get is_hth_arrangement}
                  {hth_goto_tracksel_screen}
                  {ui goto_screen {gamemode get ready_screen}}
               }
            }
         )
         (practice {ui goto_screen {gamemode get ready_screen}})
         (game_tour
            {if_else {== {{tour performer} next_any_index} -1}
               {do
                  {tour_band_event_panel confirm_event}
                  {ui goto_screen {gamemode get ready_screen}}
               }
               {do
                  {song_preview ''}
                  {session send_to_all (song_preview '') kNetReliable}
                  ;{ss_song.lst set_provider song_provider}
                  ;{ui goto_screen tour_selsong_screen}
                  {$this select_first_selectable}
                  {$this update_setlist_progress}
                  {$this update_search_mode FALSE}
               }
            }
         )
         (leaderboards {ui goto_screen leaderboards_screen})
         {fail "Unkown song_mode\n"}
      }
   )
   (invalid_selection
      {if_else [fast]
         {== {song_fast.lst selected_pos} 0}
         {song_provider is_invalid_song {ss_song.lst selected_pos}}
      }
   )
   (play_preview
      {if_else {$this invalid_selection}
         {song_preview ''}
         {do
            ($song_to_set
               {if_else [fast]
                  {if_else {song_fast.lst selected_pos}
                     {elem [data] {song_fast.lst selected_pos}}
                     ''
                  }
                  {song_provider get_song_to_set {ss_song.lst selected_pos}}
               }
            )
            {if {&& {!= $song_to_set ""} {song_mgr is_song_shared $song_to_set}}
               {song_preview $song_to_set}
            }
         }
      }
   )
   (switch_grouping
      {song_provider cycle_display}
      {if_else [fast]
         {$this update_fast_list}
         {ss_song.lst set_provider song_provider}
      }
      {$this select_first_selectable}
      {$this play_preview}
      {$this sync_grouping_method}
      {$this update_filter {song_provider get_display}}
   )
   (set_grouping_method
      ($ix)
      {unless {== $ix {song_provider get_display}}
         {song_provider set_display $ix}
         {if_else [fast]
            {$this update_fast_list}
            {ss_song.lst set_provider song_provider}
         }
         {$this select_first_selectable}
         {$this play_preview}
         {$this update_filter {song_provider get_display}}
      }
   )
   (sync_grouping_method
      {if {!= [song_mode] leaderboards}
         {session send_to_all
            {'`'
               ({',' $this}
                  set_grouping_method
                  {min
                     {',' {song_provider get_display}}
                     {- {size {find $syscfg song_groupings}} 2}
                  }
               )
            }
            kNetReliable
         }
      }
   )
   (save_song
      {do
         ($song
            {if_else [fast]
               {if_else {song_fast.lst selected_pos}
                  {elem [data] {song_fast.lst selected_pos}}
                  {do ; the random_song func is really slow for some reason
                     ($s {random_elem [data]})
                     {while {! {has_song $s}}
                        {set $s {random_elem [data]}}
                     }
                     $s
                  }
               }
               {song_provider get_song_to_set {ss_song.lst selected_pos}}
            }
         )
         {if_else
            {'||'
               {== [song_mode] leaderboards}
               {&&
                  {song_mgr is_song_shared $song}
                  {!
                     {song_mgr has_missing_parts $song {gamemode get missing_part_type}}
                  }
               }
            }
            {do
               {switch [song_mode]
                  (game
                     {game set_song $song}
                     {update_vocal_gender}
                     {do
                        ($venue {random_elem {gamemode get venues}})
                        {while {== $venue blank_01}
                           {set $venue {random_elem {gamemode get venues}}}
                        }
                        {game set_venue $venue}
                     }
                     {if {gamemode get force_player_vocal_gender}
                        {do
                           ($player_num {gamecfg get leader_num})
                           ($pcfg {gamecfg get_player_config $player_num})
                           ($char {$pcfg get_char})
                           ($instrument {$char get_instrument})
                           {if {== $instrument vocals}
                              {do
                                 ($song_gender {song_mgr vocal_gender $song})
                                 {if {!= {$char get_gender} $song_gender}
                                    {$pcfg set_char
                                       {available_prefab $player_num $instrument $song_gender}
                                    }
                                 }
                              }
                           }
                        }
                     }
                     {session_mgr send_to_all (gamecfg load_all_chars) TRUE}
                     {gamecfg load_all_chars}
                  )
                  (practice
                     {game set_song $song}
                     {game set_venue blank_01}
                  )
                  (game_tour {{tour performer} set_any_song $song})
                  (leaderboards {leaderboards set_song_sym $song})
                  {fail "Unknown song_mode\n"}
               }
               ''
            }
            $song
         }
      }
   )
   (try_save_song
      {do
         ($song {$this save_song})
         {if_else {== $song ''}
            TRUE
            {do
               ($error_screen
                  {if_else {song_mgr has_missing_parts $song {gamemode get missing_part_type}}
                     missing_parts_screen
                     invalid_selection_screen
                  }
               )
               {band_ui_sink set_net_sync FALSE}
               {if {== $error_screen missing_parts_screen}
                  {missing_parts_screen set_song $song}
               }
               {ui push_screen $error_screen}
               FALSE
            }
         }
      }
   )
   (select_first_selectable
      {if_else [fast]
         {song_fast.lst set_selected 0}
         {do
            ($ix 0)
            {while {! {song_provider is_active $ix}}
               {'++' $ix}
            }
            {if {song_provider is_active $ix}
               {ss_song.lst set_selected $ix}
            }
         }
      }
   )
   (update_setlist_progress
      {do
         ($multi {selsong_lower3rd_panel find multi_song.lbl})
         {if_else {!= [song_mode] game_tour}
            {$multi set_showing FALSE}
            {do
               ($event {tour event})
               {$multi set_localized
                  {sprintf
                     {localize event_n_of_n}
                     {'+' 1 {{tour performer} next_any_index}}
                     {$event num_songs}
                  }
               }
            }
         }
      }
   )
   (update_filter
      ($type)
      {do
         ($filter {selsong_lower3rd_panel find filter_title.lbl})
         {switch {elem {elem {find $syscfg song_groupings} {'+' $type 1}} 0}
            (rank {$filter set_localized {localize filter_difficulty}})
            (genre {$filter set_localized {localize filter_genre}})
            (decade {$filter set_localized {localize filter_decade}})
            (alpha_song {$filter set_localized {localize filter_alphabetic_song}})
            (alpha_artist {$filter set_localized {localize filter_alphabetic_band}})
            (game_origin {$filter set_localized {localize filter_game_origin}})
         }
      }
   )
   (results ())
   (search_mode FALSE)
   (finish_load
      {foreach $l (song_search.lst song_fast.lst)
         {new UIList $l}
         {$l copy ss_song.lst 1}
         {$l set_type song_search}
         {$l set spacing 62}
         {$l set_showing FALSE}
      }
      {$this sync_objects}
   )
   (VIRTUAL_KEYBOARD_RESULT_MSG
      {if {&& $ok {== {ui focus_panel} $this}}
         {$this search_for {tolower {strip_syms $text}}}
      }
   )
   (search_for
      ($string)
      {resize [results] 0}
      {do
         ($i 0)
         ($f 0)
         ($songs {array 0})
         ($data {array 0})
         {if_else [fast]
            {foreach $s {song_mgr get songs}
               {if {has_song $s}
                  {push_back $songs
                     {`(
                        {, {song_mgr song_name $s}}
                        {, {song_mgr by_line $s}}
                        {, $s}
                     )}
                  }
               }
            }
            {while {<= $f 3}
               {++ $i}
               {if_else
                  {||
                     {song_provider is_invalid_song $i}
                     {! {has_song {song_provider get_song_to_set $i}}}
                  }
                  {++ $f}
                  {do
                     ($s {song_provider get_song_to_set $i})
                     {set $f 0}
                     ; array was crashing for some reason
                     {push_back $songs
                        {`(
                           {, {song_mgr song_name $s}}
                           {, {song_mgr by_line $s}}
                           {, $s}
                        )}
                     }
                  }
               }
            }
         }
         {sort $songs}
         {foreach $s $songs
            {do
               ($title  {elem $s 0})
               ($artist {elem $s 1})
               ($song   {elem $s 2})
               {if
                  {&&
                     {||
                        {has_substr {tolower {strip_syms $title}} $string}
                        {has_substr {tolower {strip_syms $artist}} $string}
                     }
                     {song_mgr is_song_shared $song}
                     {! {song_mgr has_missing_parts $song {gamemode get missing_part_type}}}
                     {! {find_elem [results] $song}}
                  }
                  {push_back $data {sprintf "%s%s\n%s" {$this get_icon $song} $title $artist}}
                  {push_back [results] $song}
               }
            }
         }
         {if_else {size $data}
            {do
               {song_search.lst set_data $data}
               {$this update_search_mode TRUE}
               {$this component_scroll 0 0}
               {$this play_preview}
               {if {!= [song_mode] leaderboards}
                  {session send_to_all {'`' ({',' $this} play_preview)} kNetReliable}
               }
            }
            {$this update_search_mode FALSE}
         }
      }
   )
   (update_search_mode
      ($bool)
      {set [search_mode] $bool}
      {{selsong_lower3rd_panel find filter_title.lbl} set_showing {! [search_mode]}}
      {song_search.lst set_showing [search_mode]}
      {cond
         ([search_mode]
            {ss_song.lst set_showing FALSE}
            {song_fast.lst set_showing FALSE}
            {$this set_focus song_search.lst}
         )
         ([fast]
            {song_fast.lst set_showing TRUE}
            {$this set_focus song_fast.lst}
         )
         (TRUE
            {ss_song.lst set_showing TRUE}
            {$this set_focus ss_song.lst}
         )
      }
   )
   (sel_leader -1)
   (players ())
   (update_leader
      {if {is_leader_local}
         {if_else {== [song_mode] game}
            {do
               {if {size [players]}
                  {foreach $p [players]
                     {unless {game is_player_participating $p}
                        ; clear players if one left anytime
                        {resize [players] 0}
                     }
                  }
               }
               {unless {size [players]}
                  ; fill players array
                  {push_back [players] {gamecfg get leader_num}}
                  {gamecfg foreach_player_config $pcfg
                     {unless {find_elem [players] {$pcfg get player_num}}
                        {push_back [players] {$pcfg get player_num}}
                     }
                  }
               }
            }
            ; just set sel leader to leader if not in qp/hth
            {set [players] {eval_array ({gamecfg get leader_num})}}
         }
         {if_else {!= {session mode} kNetLocal}
            {do
               ; set and send leader
               {$this set_sel_leader {elem [players] 0}}
               {session send_to_all
                  {` ({, $this} set_sel_leader {, [sel_leader]})}
                  kNetReliable
               }
               ; ensure the sel leader is on ulti and have them correct if not
               {unless {gamecfg is_player_local [sel_leader]}
                  {session send_to_player
                     [sel_leader]
                     {`(
                        {unless {{, $this} has (players)}
                           {session send_to_player
                              {gamecfg get leader_num}
                              {` ({, $this} correct_leader)}
                              kNetReliable
                           }
                        }
                     )}
                     kNetReliable
                  }
               }
            }
            {$this set_sel_leader {gamecfg get leader_num}}
         }
      }
   )
   (set_sel_leader
      ($player_num)
      {set [sel_leader] $player_num}
      {script_task kTaskUISeconds
         (delay 0.25) ; with no delay this breaks with lots of songs
         (script
            {if_else {gamecfg is_player_local $player_num}
               {do
                  {set [hb] (helpbar_back_search helpbar_choosesong helpbar_next_heading)}
                  {set [hbw] FALSE}
               }
               {do
                  {set [hb] (helpbar_leave_session)}
                  {set [hbw]
                     {sprintf
                        {localize waiting_for_player}
                        {{game get_player_config $player_num} get player_name}
                     }
                  }
               }
            }
            {helpbar set_config [hb]}
            {helpbar set_waiting [hbw]}
         )
      }
   )
   (correct_leader {$this set_sel_leader {gamecfg get leader_num}})
   (REMOTE_PLAYER_LEFT_MSG ; not tested!
      {$this update_leader}
   )
   (hb FALSE)
   (hbw FALSE)
   (TRANSITION_COMPLETE_MSG
      {if {&& {== {$new_screen focus_panel} $this} [hb]}
         {helpbar set_config [hb]}
         {helpbar set_waiting [hbw]}
      }
   )
   (fast FALSE)
   (data ())
   (titles ())
   (update_fast_list
      {unless {&& {song_mgr has (songs)} {size {song_mgr get songs}}}
         ; this is kinda slow. thank u for not removing this handle hmx.
         {song_mgr set songs {song_mgr get_local_unlocked_songs}}
      }
      {do
         ($sort {array 0})
         ($data {array 0})
         ($titles {array 0})
         ($i 0)
         ($type {elem {elem {find $syscfg song_groupings} {'+' {song_provider get_display} 1}} 0})
         {foreach $song {song_mgr get songs} {do
            ($song_data {song_mgr get_data $song})
            {if
               {&&
                  {song_mgr is_song_shared $song}
                  {! {song_mgr has_missing_parts $song {gamemode get missing_part_type}}}
               }
               {push_back $sort
                  {`
                     (
                        {,
                           {switch $type
                              (alpha_song
                                 {song_mgr song_name $song}
                              )
                              (alpha_artist
                                 {sprint
                                    {song_mgr song_artist $song}
                                    " "
                                    {song_mgr song_name $song}
                                 }
                              )
                              (genre
                                 {sprint
                                    {elem {find $song_data genre} 1}
                                    " "
                                    {song_mgr song_artist $song}
                                    " "
                                    {song_mgr song_name $song}
                                 }
                              )
                              (decade
                                 {sprint
                                    {switch {elem {find $song_data decade} 1}
                                       (the50s 0)
                                       (the60s 1)
                                       (the70s 2)
                                       (the80s 3)
                                       (the90s 4)
                                       (the00s 5)
                                       (the10s 6)
                                       (the20s 7)
                                       (the30s 8)
                                       9
                                    }
                                    " "
                                    {song_mgr song_artist $song}
                                    " "
                                    {song_mgr song_name $song}
                                 }
                              )
                              (game_origin
                                 {sprint
                                    {do
                                       ($origin
                                          {if_else {find_exists $song_data game_origin}
                                             {elem {find $song_data game_origin} 1}
                                             zzz
                                          }
                                       )
                                       {if_else {== $origin rb11}
                                          '0'
                                          $origin
                                       }
                                    }
                                    " "
                                    {song_mgr song_name $song}
                                 }
                              )
                              (rank
                                 {do
                                    ($rank {elem {find $song_data rank {gamemode get unlock_song_instrument}} 1})
                                    {if_else {< $rank 100}
                                       {sprint 0 $rank}
                                       {sprint $rank}
                                    }
                                 }
                              )
                           }
                        }
                        {, $song}
                     )
                  }
               }
            }
         }}
         {sort $sort}
         {while {< $i {size $sort}}
            {set_elem $sort $i {elem {elem $sort $i} 1}}
            {do
               ($song {elem $sort $i})
               ($song_data {song_mgr get_data $song})
               ($title
                  {switch $type
                     ((alpha_song alpha_artist)
                        {switch
                           {str_elem
                              {tolower
                                 {if_else {== $type alpha_song}
                                    {song_mgr song_name $song}
                                    {song_mgr song_artist $song}
                                 }
                              }
                              0
                           }
                           (a a_title)
                           (b b_title)
                           (c c_title)
                           (d d_title)
                           (e e_title)
                           (f f_title)
                           (g g_title)
                           (h h_title)
                           (i i_title)
                           (j j_title)
                           (k k_title)
                           (l l_title)
                           (m m_title)
                           (n n_title)
                           (o o_title)
                           (p p_title)
                           (q q_title)
                           (r r_title)
                           (s s_title)
                           (t t_title)
                           (u u_title)
                           (v v_title)
                           (w w_title)
                           (x x_title)
                           (y y_title)
                           (z z_title)
                           symbol_sort
                        }
                     )
                     ((genre game_origin decade)
                        {do
                           ($sym
                              {switch $type
                                 (genre genre)
                                 (game_origin game_origin)
                                 (decade decade)
                              }
                           )
                           {if_else {find_exists $song_data $sym}
                              {elem {find $song_data $sym} 1}
                              none
                           }
                        }
                     )
                     (rank
                        {do
                           ($rank {elem {find $song_data rank {gamemode get unlock_song_instrument}} 1})
                           {cond
                              ({<= $rank 130} generic_tier1)
                              ({<= $rank 170} generic_tier2)
                              ({<= $rank 220} generic_tier3)
                              ({<= $rank 250} generic_tier4)
                              ({<= $rank 280} generic_tier5)
                              ({<= $rank 315} generic_tier6)
                              ({<= $rank 350} generic_tier7)
                              ({<= $rank 380} generic_tier8)
                              (TRUE generic_tier9)
                           }
                        }
                     )
                  }
               )
               {unless {&& $title {== {type $title} kDataSymbol}}
                  {set $title {symbol $title}}
               }
               {if {&& $title {! {find_elem $titles $title}}}
                  {insert_elem $sort $i $title}
                  {push_back $titles $title}
                  {++ $i}
               }
            }
            {++ $i}
         }
         {foreach $song $sort
            {push_back $data
               {if_else {find_elem $titles $song}
                  $song
                  {sprint
                     {$this get_icon $song}
                     {song_mgr song_name $song}
                     "\n"
                     {song_mgr by_line $song}
                  }
               }
            }
         }
         {insert_elem $sort 0 random_song}
         {insert_elem $data 0
            {sprint
               {localize random_song}
               "\n"
               {localize random_song_by_line}
            }
         }
         {song_fast.lst set_data $data}
         {foreach $title $titles
            {song_fast.lst disable_data $title}
         }
         {set [data] $sort}
         {set [titles] $titles}
      }
   )
   (get_icon
      ($sym) {do
      ($a {find_exists {song_mgr get_data $sym} game_origin})
      {if_else $a
         {switch {elem $a 1}
            (rb11 "")
            (rb22 "")
            (rb2 "")
            (lego "")
            (rb3 "")
            (rb4 "")
            ""
         }
         ""
      }
   })
)
{new UIScreen
   invalid_selection_screen
   (panels dialog_panel)
   (focus dialog_panel)
   (helpbar ('' helpbar_select))
   (enter {dialog_panel set_ok {localize_token invalid_song}})
   (exit {band_ui_sink set_net_sync TRUE})
   (SELECT_MSG {ui pop_screen})
}
{new UIScreen
   missing_parts_screen
   (panels dialog_panel)
   (focus dialog_panel)
   (helpbar ('' helpbar_select))
   (missing_part_str "")
   (enter {dialog_panel set_ok [missing_part_str]})
   (exit {band_ui_sink set_net_sync TRUE})
   (SELECT_MSG {ui pop_screen})
   (set_song
      ($song)
      {do
         ($missing ())
         {song_mgr find_missing_parts $song $missing}
         {set [missing_part_str] {localize_token missing_parts_error}}
         {foreach $part $missing
            {set [missing_part_str]
               {sprint [missing_part_str] "\n" {localize_token {sprint "missing_" $part}}}
            }
         }
      }
   )
}
